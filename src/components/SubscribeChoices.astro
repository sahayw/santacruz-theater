---
// The two email lists, with the majors' "Select companies" ticks under Performance
// updates — shared by /subscribe and /subscribe/manage. Pages read and set it through
// src/lib/subscribe-choices.ts: name="list" (ticked = on the list) and name="major"
// (unticked = left out). The company ticks follow Performance updates — see the script.
// See docs/notifications-spec.md ("Subscribe and manage").
import { companies } from '../lib/data.ts'
import { majors } from '../lib/organizers.ts'
import { EMAIL_LISTS } from '../lib/email-lists.ts'

const [performances, auditionsEvents] = ['performances', 'auditions-events'].map(
  (id) => EMAIL_LISTS.find((l) => l.id === id)!
)
---

<div class="choices" data-choices>
  <div class="list-opt">
    <label class="list-head">
      <input type="checkbox" name="list" value={performances.id} />
      <span>
        <span class="list-name">{performances.label}</span>
        <span class="list-desc">{performances.description}</span>
      </span>
    </label>
    <div class="co-block">
      <div class="co-label">Select companies</div>
      <div class="co-grid">
        {
          majors(companies).map((c) => (
            <label>
              <input type="checkbox" name="major" value={c.id} />
              {c.name}
            </label>
          ))
        }
      </div>
      <div class="co-sum" data-co-sum>
        Productions by all other companies and organizers are always included.
      </div>
    </div>
  </div>
  <div class="list-opt">
    <label class="list-head">
      <input type="checkbox" name="list" value={auditionsEvents.id} />
      <span>
        <span class="list-name">{auditionsEvents.label}</span>
        <span class="list-desc">{auditionsEvents.description}</span>
      </span>
    </label>
  </div>
</div>

<style>
  .choices {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .list-opt {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .list-opt.on {
    border-color: var(--gold);
    background: #fffdf8;
  }

  .list-head {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    cursor: pointer;
  }

  .list-head input {
    margin-top: 3px;
    accent-color: #2e2a26;
    width: 15px;
    height: 15px;
    flex: none;
  }

  .list-name {
    display: block;
    font-weight: 600;
    font-size: 14px;
  }

  .list-desc {
    display: block;
    font-size: 12px;
    color: var(--ink-muted);
    line-height: 1.45;
  }

  .co-block {
    margin-left: 25px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .co-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-muted);
  }

  /* Matches the Add to my calendar dialog's company ticks (AddToCalendar.astro) */
  .co-grid {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 4px 24px;
    font-size: 13px;
  }

  .co-grid label {
    display: flex;
    gap: 6px;
    align-items: center;
    cursor: pointer;
    white-space: nowrap;
  }

  .co-grid input {
    accent-color: #2e2a26;
    margin: 0;
  }

  .co-sum {
    font-size: 11px;
    line-height: 1.45;
    color: var(--ink-subtle);
    margin-top: 2px;
  }

  @media (max-width: 520px) {
    .co-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Company ticks follow Performance updates:
  // - Performance updates ticked: the companies chosen so far — all of them until someone
  //   (or the saved choices on /subscribe/manage) says otherwise.
  // - Not ticked: no companies ticked. Unticking keeps the choice, so ticking Performance
  //   updates again brings it back.
  // - Ticking or unticking a company also ticks Performance updates. If nothing was chosen
  //   yet, only that company is ticked; otherwise the earlier choice comes back, plus it.
  // Pages set the form with setFormChoices(), which fires an untrusted change: that
  // resets the remembered choice to what was set.
  for (const root of document.querySelectorAll<HTMLElement>('[data-choices]')) {
    const perf = root.querySelector<HTMLInputElement>('input[name="list"][value="performances"]')!
    const majors = [...root.querySelectorAll<HTMLInputElement>('input[name="major"]')]
    const sum = root.querySelector<HTMLElement>('[data-co-sum]')!
    const ticked = () => new Set(majors.filter((m) => m.checked).map((m) => m.value))
    const tick = (ids: Set<string> | null) => majors.forEach((m) => (m.checked = !ids || ids.has(m.value)))
    let chosen: Set<string> | null = null // null = all (the default)

    const refresh = () => {
      for (const opt of root.querySelectorAll('.list-opt'))
        opt.classList.toggle('on', !!opt.querySelector<HTMLInputElement>('input[name="list"]')?.checked)
      sum.textContent =
        perf.checked && !majors.some((m) => m.checked)
          ? "You'll get productions by other companies and organizers only."
          : 'Productions by all other companies and organizers are always included.'
    }

    root.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement
      if (!e.isTrusted) {
        // Set by the page: remember it if Performance updates is on
        chosen = perf.checked ? ticked() : null
      } else if (target === perf) {
        if (perf.checked) tick(chosen)
        else majors.forEach((m) => (m.checked = false))
      } else if (target.name === 'major') {
        // A company ticked while Performance updates is off: bring back any earlier choice,
        // plus this tick
        if (!perf.checked && chosen) {
          tick(chosen)
          target.checked = true
        }
        perf.checked = true
        chosen = ticked()
      }
      refresh()
    })
    if (perf.checked) tick(chosen)
    refresh()
  }
</script>
