---
import type { PerformanceEvent } from '../types.ts'
import companiesData from '../../data/sc-theater-companies.json'

interface Props {
  performances: PerformanceEvent[]
}

const { performances } = Astro.props

const activeCompanyCodes = new Set<string>(performances.map((p) => p.company).filter(Boolean))
const filterCompanies = companiesData.companies.filter((c) => activeCompanyCodes.has(c.id))
---

<div class="cal-bar">
  <button class="back-annual-btn" id="backBtn">← Annual</button>
  <button class="list-view-btn" id="listViewBtn">List view →</button>
  <div class="year-nav">
    <button class="year-step" id="yearPrev" aria-label="Previous year">‹</button>
    <span class="year-display" id="yearDisplay">2026</span>
    <button class="year-step" id="yearNext" aria-label="Next year">›</button>
  </div>
  <div class="filter-area">
    <button class="filter-toggle-btn" id="filterToggleBtn"
      ><span id="filterLabel">Filters</span></button
    >
    <div class="filter-dropdown" id="filterDropdown">
      <div class="filter-row">
        <label>Company</label>
        <select id="filterCompany">
          <option value="">All</option>
          {filterCompanies.map((c) => <option value={c.id}>{c.name}</option>)}
        </select>
      </div>
      <div class="filter-row">
        <label>Genre</label>
        <select id="filterGenre">
          <option value="">All</option>
          <option value="Drama">Drama</option>
          <option value="Musical">Musical</option>
          <option value="Comedy">Comedy</option>
        </select>
      </div>
      <div class="filter-row">
        <label>Time</label>
        <select id="filterTime">
          <option value="">All</option>
          <option value="Mat">Matinee</option>
          <option value="Eve">Evening</option>
        </select>
      </div>
    </div>
  </div>
</div>

<div class="scroll-col-header" id="scrollColHeader">
  <div class="scroll-col-header-inner">
    <div class="col-head-cell">Shows this week</div>
    <div class="col-head-cell">Mon</div>
    <div class="col-head-cell">Tue</div>
    <div class="col-head-cell">Wed</div>
    <div class="col-head-cell">Thu</div>
    <div class="col-head-cell">Fri</div>
    <div class="col-head-cell">Sat</div>
    <div class="col-head-cell">Sun</div>
  </div>
</div>

<div id="annual-view">
  <div style="padding:12px">
    <div class="months-grid" id="monthsGrid"></div>
    <div style="height:24px"></div>
  </div>
</div>

<div id="scroll-view">
  <div id="scroll-weeks"></div>
  <div style="height:24px"></div>
</div>

<div class="fixed-legend-footer" id="fixedLegendFooter"></div>
<div id="hoverPanel" class="day-hover-panel"></div>
<div id="showDescPanel" class="show-desc-panel"></div>
<div class="overlay" id="overlay"></div>
<div class="bottom-sheet" id="bottomSheet">
  <div class="sheet-date-header">
    <span id="sheetDateHeader"></span>
    <button class="sheet-close-btn" id="sheetCloseBtn" aria-label="Close">×</button>
  </div>
  <div id="sheetCards"></div>
</div>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Serif+Display&family=DM+Sans:wght@300;400;500&display=swap');

  :root {
    --page-bg: #f0ede8;
    --bg: #f7f4ef;
    --surface: #ffffff;
    --ink: #1a1612;
    --ink-muted: #6b6259;
    --border: #e0d9d0;
    --month-header-bg: #fffcf2;
    --card-description-lines: 4;
    /* day fill colors — flat muted tints */
    --col-scs: #e9c1be; /* Carnation   7°   SCS      */
    --col-at: #afbfee; /* Dusk      225°   AT       */
    --col-mct: #c9e6bf; /* Willow    116°   MCT      */
    --col-renegade: #b7e8ec; /* Verdigris 188°   Renegade */
    --col-other: #dadada; /* grey — Other / unknown fallback (drill down only) */
    --col-multi: #c4b7a8; /* deeper taupe — multi-company days (annual only) */
    /* legend dot colors — muted accent, provides increased contrast */
    --dot-scs: #ce8481; /* dusty rose  */
    --dot-at: #7b8bc4; /* soft indigo */
    --dot-mct: #71c75f; /* olive sage  */
    --dot-renegade: #5dadbe; /* sea teal  */
    --dot-other: #dadada; /* grey - other (drill down only) */
    --dot-multi: #c4b7a8; /* deeper taupe — multi-company (annual only) */
    /* fully saturated accent colors — drill-down chip bars and Show-card badge */
    --acc-scs: #dc4343; /* vivid red-rose */
    --acc-at: #4f5ce0; /* vivid blue     */
    --acc-mct: #48ae31; /* vivid leaf green */
    --acc-renegade: #21a4c8; /* vivid sea teal  */
    --acc-other: #8f8a85; /* warm grey accent */
    --radius: 6px;
    --bar-h: 32px;
    --col-header-h: 28px;
    --footer-h: 48px;
    --shows-col-w: clamp(120px, 21vw, 160px);
    --daynum-h: 24px;
    --row-h: 22px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--page-bg);
    color: var(--ink);
    min-height: 100vh;
    font-size: 14px;
    padding-top: var(--bar-h);
  }

  /* ── UNIFIED CAL BAR ── */
  .cal-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 110;
    height: var(--bar-h);
    background: var(--bar-bg);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 20px;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  /* View-switch buttons — each shown only in the opposite mode */
  .back-annual-btn,
  .list-view-btn {
    grid-column: 1;
    justify-self: start;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.65);
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 400;
    cursor: pointer;
    padding: 4px 8px 4px 0;
    white-space: nowrap;
    display: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.14s;
  }
  .back-annual-btn:hover,
  .list-view-btn:hover {
    color: #fff;
  }
  body.scroll-mode .back-annual-btn {
    display: block;
  }
  body.annual-mode .list-view-btn {
    display: block;
  }

  /* Year navigator */
  .year-nav {
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }
  .year-display {
    font-family: 'DM Serif Display', serif;
    font-size: 18px;
    color: #fff;
    letter-spacing: 0.01em;
    min-width: 48px;
    text-align: center;
  }
  .year-step {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.65);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    padding: 4px 6px;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.14s;
  }
  .year-step:hover {
    color: #fff;
  }
  .year-step.dimmed {
    opacity: 0.3;
  }
  .year-step.hidden {
    visibility: hidden;
  }

  /* Filter toggle button */
  .filter-area {
    grid-column: 3;
    justify-self: end;
    position: relative;
  }
  .filter-toggle-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.8);
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 400;
    padding: 4px 10px;
    cursor: pointer;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.14s,
      border-color 0.14s,
      color 0.14s;
  }
  @media (hover: hover) {
    .filter-toggle-btn:hover {
      background: rgba(255, 255, 255, 0.18);
      border-color: rgba(255, 255, 255, 0.35);
      color: #fff;
    }
  }
  .filter-toggle-btn.active {
    background: rgba(200, 169, 110, 0.2);
    border-color: rgba(200, 169, 110, 0.5);
    color: #c8a96e;
  }

  /* Filter dropdown panel */
  .filter-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    padding: 4px 0;
    z-index: 120;
    min-width: 210px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-4px);
    transition:
      opacity 0.75s ease,
      transform 0.75s ease,
      visibility 0s linear 0.75s;
  }
  .filter-dropdown.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition:
      opacity 0.75s ease,
      transform 0.75s ease,
      visibility 0s linear 0s;
  }
  .filter-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
  }
  .filter-row + .filter-row {
    border-top: 1px solid var(--border);
  }
  .filter-row label {
    font-size: 12px;
    color: var(--ink-muted);
    font-weight: 500;
    min-width: 58px;
  }
  .filter-row select {
    flex: 1;
    font-family: inherit;
    font-size: 12px;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 3px 6px;
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
  }

  /* ── FIXED SCROLL-VIEW COLUMN HEADER ── */
  .scroll-col-header {
    display: none;
    position: fixed;
    top: var(--bar-h);
    left: 0;
    right: 0;
    z-index: 108;
    background: var(--bar-bg);
    color: #fff;
    height: var(--col-header-h);
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .scroll-col-header.visible {
    display: block;
  }
  .scroll-col-header-inner {
    display: grid;
    grid-template-columns: var(--shows-col-w) repeat(7, 1fr);
    min-width: 440px;
    max-width: 600px;
    margin: 0 auto;
    height: 100%;
  }
  .col-head-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 500;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0 3px;
  }
  .col-head-cell:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    justify-content: flex-start;
    padding-left: 8px;
    border-left: none;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    background: var(--bar-bg);
  }

  body.scroll-mode {
    padding-top: calc(var(--bar-h) + var(--col-header-h));
    padding-bottom: calc(var(--footer-h) + 8px);
  }
  body.annual-mode {
    padding-bottom: calc(var(--footer-h) + 8px);
  }

  /* ── ANNUAL VIEW ── */
  #annual-view {
    padding: 2px;
    max-width: 960px;
    margin: 0 auto;
    background: var(--bg);
  }
  .months-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  /* Landscape: 4 columns × 3 rows fits all 12 months without scrolling */
  @media (min-aspect-ratio: 1/1) {
    .months-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 480px) {
    .months-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .month-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: box-shadow 0.15s;
  }
  .month-block:active {
    opacity: 0.8;
  }
  .month-name {
    font-family: 'DM Serif Display', serif;
    font-size: 13px;
    font-weight: 400;
    padding: 4px 6px 3px;
    border-bottom: 1px solid var(--border);
    letter-spacing: 0.02em;
  }
  .mini-cal {
    padding: 1px;
  }
  .mini-cal-head {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    margin-bottom: 1px;
  }
  .mini-cal-head span {
    text-align: center;
    font-size: 10px;
    font-weight: 500;
    color: var(--ink-muted);
  }
  .mini-cal-body {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    width: 100%;
  }
  .mini-day {
    min-width: 0;
    height: 22px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: var(--ink-muted);
  }
  .mini-day.has-perf {
    color: rgba(0, 0, 0, 0.75);
    font-weight: 600;
    cursor: pointer;
  }
  .mini-day.has-perf.multi {
    background: var(--col-multi) !important;
  }
  .mini-day.has-perf.pip-active {
    filter: brightness(0.8);
    outline: 2px solid rgba(0, 0, 0, 0.2);
    outline-offset: -1px;
  }
  @media (hover: hover) {
    .mini-day.has-perf:hover {
      filter: brightness(0.88);
    }
  }
  .mini-day.empty {
    opacity: 0;
  }

  /* ── LEGEND ── */
  .legend {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 10px 14px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  .legend-title {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-muted);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
  }
  .legend-dot {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  /* ── SCROLL VIEW ── */
  #scroll-view {
    display: none;
    max-width: 600px;
    margin: 0 auto;
    padding-right: 5px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .scroll-month-label {
    position: relative;
    z-index: 3;
    padding: 7px 12px 6px;
    font-family: 'DM Serif Display', serif;
    font-size: 18px;
    font-weight: 400;
    color: #433c36;
    background: linear-gradient(
      to bottom,
      #f1eee8 0%,
      var(--month-header-bg) 25%,
      var(--month-header-bg) 85%,
      #f1eee8 100%
    );
    letter-spacing: 0.01em;
    border-bottom: 1px solid var(--border);
    will-change: transform;
  }

  .week-table-wrap {
  }

  .week-grid {
    display: grid;
    grid-template-columns: var(--shows-col-w) repeat(7, 1fr);
    border-bottom: 2px solid var(--border);
    border-right: 2px solid var(--border);
    min-width: 440px;
    background: var(--surface);
  }

  .shows-col {
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--bg);
    border-right: 2px solid var(--border);
    box-shadow: 2px 0 6px rgba(0, 0, 0, 0.06);
    display: grid;
    padding: 0;
  }
  .shows-col-spacer {
    height: var(--daynum-h);
    border-bottom: 1px solid var(--border);
  }
  .show-chip {
    height: calc(var(--row-h) - 2px);
    margin: 1px 3px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 6px;
    font-size: 12px;
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
  }
  .show-chip-bar {
    width: 4px;
    height: 16px;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .show-chip-name {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .day-col {
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }
  .day-col.other-month {
    background: #e8e4de;
  }
  .day-col.has-perf {
    -webkit-tap-highlight-color: transparent;
  }
  .day-col.has-perf .day-num-row {
    cursor: pointer;
  }
  .day-col.has-perf .day-num-row:active {
    background: rgba(0, 0, 0, 0.06);
  }

  .day-num-row {
    height: var(--daynum-h);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    background: var(--bg);
  }
  .day-col.other-month .day-num-row {
    background: #e8e4de;
  }
  .day-num {
    font-size: 13px;
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
    color: #433c36;
    line-height: 0;
  }
  .day-num.today {
    background: var(--ink-muted);
    color: #fff;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    line-height: 1;
  }

  .pip-row {
    height: var(--row-h);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .pip-row:last-child {
    border-bottom: none;
  }

  .perf-bar {
    position: absolute;
    top: 1px;
    bottom: 1px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    filter: saturate(0.78) brightness(1.02);
  }
  .perf-bar.bar-single {
    left: 3px;
    right: 3px;
    border-radius: 3px;
  }
  .perf-bar.bar-start {
    left: 3px;
    right: 0;
    border-radius: 3px 0 0 3px;
    border-right: 1px solid rgba(255, 255, 255, 0.5);
  }
  .perf-bar.bar-mid {
    left: -1px;
    right: 0;
    border-radius: 0;
    border-right: 1px solid rgba(255, 255, 255, 0.5);
  }
  .perf-bar.bar-end {
    left: -1px;
    right: 3px;
    border-radius: 0 3px 3px 0;
  }

  .perf-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgba(0, 0, 0, 0.75);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    line-height: 1;
  }

  /* ── FIXED FOOTER LEGEND ── */
  .fixed-legend-footer {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 108;
    background: var(--surface);
    border-top: 1px solid var(--border);
    min-height: var(--footer-h);
    padding: 8px 14px;
    padding-bottom: max(8px, env(safe-area-inset-bottom, 8px));
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }
  .fixed-legend-footer.visible {
    display: flex;
  }
  .fixed-legend-footer .legend-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .fixed-legend-footer .legend-item {
    font-size: 11px;
    white-space: nowrap;
    flex-shrink: 0;
    gap: 4px;
  }
  .fixed-legend-footer .legend-dot {
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }

  /* ── BOTTOM SHEET ── */
  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 200;
  }
  .overlay.open {
    display: block;
  }
  .bottom-sheet {
    position: fixed;
    bottom: 0;
    left: 50%;
    width: 100%;
    max-width: 500px;
    background: var(--surface);
    border-radius: 16px 16px 0 0;
    z-index: 201;
    max-height: 80vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transform: translateX(-50%) translateY(100%);
    -webkit-transform: translateX(-50%) translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding-bottom: env(safe-area-inset-bottom, 16px);
  }
  .bottom-sheet.open {
    transform: translateX(-50%) translateY(0);
    -webkit-transform: translateX(-50%) translateY(0);
  }
  .sheet-date-header {
    display: flex;
    align-items: center;
    padding: 12px 12px 8px 20px;
    border-bottom: 1px solid var(--border);
  }
  .sheet-date-header span {
    font-family: 'DM Serif Display', serif;
    font-size: 16px;
    font-weight: 400;
    flex: 1;
  }
  .sheet-close-btn {
    background: none;
    border: none;
    font-size: 22px;
    line-height: 1;
    color: var(--ink-muted);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .sheet-close-btn:hover {
    color: var(--ink);
    background: rgba(0, 0, 0, 0.05);
  }
  .perf-card {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
  }
  .perf-card:last-child {
    border-bottom: none;
  }
  .perf-card-company {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }
  .company-badge {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .company-name {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .perf-type-tag {
