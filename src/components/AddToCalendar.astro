---
// "Add to my calendar" dialog for the static .ics files (src/pages/[...feed].ics.ts).
// Include once per page. It opens from any element carrying one of:
//   data-ics-feed="runs" data-ics-name="…"                    subscribe to one feed
//   data-ics-choices='[{"label","feed","name"}, …]'           subscribe, with a picker
//     data-ics-choice-label="Company"
//   data-ics-majors='[{"code","label","name"}, …]'            subscribe to performances,
//                                                             unticking majors (numbered
//                                                             selection feeds)
//   data-ics-event="performances/123"                         add one event (download
//                                                             .ics or Google add-event)
//   data-ics-download="activities/123" data-ics-name="…"      download all of an
//                                                             activity's dates
// Subscriptions are only offered for the big feeds; single items are added as copies.
// Clicks are delegated from document, so triggers in client-rendered markup (the
// calendar's show cards) work without extra wiring. See docs/ics-spec.md.
---

<dialog class="ics-dialog" id="icsDialog" aria-labelledby="icsTitle">
  <form method="dialog">
    <button class="ics-close" aria-label="Close">×</button>
  </form>
  <h2 class="ics-title" id="icsTitle">Add to my calendar</h2>
  <p class="ics-name" id="icsName"></p>

  <label class="ics-choice" id="icsChoiceWrap" hidden>
    <span id="icsChoiceLabel">Calendar</span>
    <select id="icsChoice"></select>
  </label>

  <!-- Performances: untick the majors you don't want; everyone else is always included -->
  <fieldset class="ics-majors" id="icsMajorsWrap" hidden>
    <legend>Select companies</legend>
    <div class="ics-majors-list" id="icsMajors"></div>
    <p class="ics-note ics-note--small" id="icsMajorsNote"></p>
  </fieldset>

  <!-- Subscribe: the big feeds -->
  <section class="ics-section" id="icsSubscribe" hidden>
    <p class="ics-note">
      Subscribing adds a calendar that stays up to date as listings change. Your calendar app
      checks for changes on its own schedule — Google Calendar can take up to a day.
    </p>
    <div class="ics-actions">
      <a class="ics-btn ics-btn--primary" id="icsWebcal">Apple Calendar / Outlook</a>
      <a class="ics-btn ics-btn--primary" id="icsGoogleSub" target="_blank" rel="noopener"
        >Google Calendar</a
      >
    </div>
    <div class="ics-copy">
      <input
        class="ics-url"
        id="icsUrl"
        type="text"
        readonly
        aria-label="Calendar subscription link for other apps"
      />
      <button class="ics-btn" id="icsCopy" type="button">Copy link</button>
    </div>
    <p class="ics-note ics-note--small">For any other calendar app, subscribe using this link.</p>
  </section>

  <!-- Save a copy: one event, or all of an activity's dates -->
  <section class="ics-section" id="icsSave" hidden>
    <ul class="ics-when" id="icsWhen"></ul>
    <div class="ics-actions">
      <a class="ics-btn ics-btn--primary" id="icsDownload" download>Apple Calendar / Outlook</a>
      <a class="ics-btn ics-btn--primary" id="icsGoogleEvent" target="_blank" rel="noopener"
        >Google Calendar</a
      >
    </div>
    <p class="ics-note ics-note--small" id="icsSaveNote"></p>
  </section>
</dialog>

<script>
  import { FEED_NAMES, selectionFeedPath } from '../lib/calendar-model.ts'

  interface Choice {
    label: string
    feed: string
    name: string
  }
  interface Major {
    code: number // permanent majorCode
    label: string // short label, used in the feed's name
    name: string
  }
  interface IcsEvent {
    summary: string
    start: string // YYYYMMDDTHHMMSS, America/Los_Angeles
    end: string
    location: string
    description: string // always ends with a `Details…: https://santacruz.theater/…` line
  }

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T
  const dialog = $<HTMLDialogElement>('icsDialog')
  const titleEl = $('icsTitle')
  const nameEl = $('icsName')
  const choiceWrap = $('icsChoiceWrap')
  const choiceLabel = $('icsChoiceLabel')
  const choiceSelect = $<HTMLSelectElement>('icsChoice')
  const subscribeSection = $('icsSubscribe')
  const webcalLink = $<HTMLAnchorElement>('icsWebcal')
  const googleSubLink = $<HTMLAnchorElement>('icsGoogleSub')
  const urlInput = $<HTMLInputElement>('icsUrl')
  const copyBtn = $<HTMLButtonElement>('icsCopy')
  const saveSection = $('icsSave')
  const whenList = $('icsWhen')
  const downloadLink = $<HTMLAnchorElement>('icsDownload')
  const googleEventLink = $<HTMLAnchorElement>('icsGoogleEvent')
  const saveNote = $('icsSaveNote')
  const majorsWrap = $('icsMajorsWrap')
  const majorsList = $('icsMajors')
  const majorsNote = $('icsMajorsNote')

  let choices: Choice[] = []
  let majors: Major[] = []

  /** The selection feed for the majors currently unticked (0 = all performances). */
  function showMajorsSelection() {
    const out = majors.filter(
      (m) => !majorsList.querySelector<HTMLInputElement>(`input[value="${m.code}"]`)?.checked
    )
    const mask = out.reduce((sum, m) => sum + m.code, 0)
    majorsNote.textContent =
      out.length === majors.length
        ? 'You’ll get performances by other companies and organizers only.'
        : 'Performances by all other companies and organizers are always included.'
    showSubscribe(
      selectionFeedPath(mask),
      out.length ? FEED_NAMES.selection(out.map((m) => m.label)) : FEED_NAMES.productions
    )
  }

  // ── Usage tracking (Plausible custom events; no-op where Plausible isn't loaded) ──
  // Records interest, not ongoing subscribers — see docs/ics-spec.md.
  type Props = Record<string, string>
  function track(event: string, props: Props) {
    const w = window as unknown as {
      plausible?: (event: string, options: { props: Props }) => void
    }
    w.plausible?.(event, { props })
  }
  let tracking: { event: string; props: Props } = { event: '', props: {} }
  const trackAs = (app: string) => () => track(tracking.event, { ...tracking.props, app })

  // ── Reading our own .ics output (fixed, known format) ──
  function parseEvents(text: string): IcsEvent[] {
    const lines = text.replace(/\r\n[ \t]/g, '').split(/\r\n/)
    const unescape = (v: string) =>
      v.replace(/\\n/gi, '\n').replace(/\\([,;\\])/g, '$1')
    const events: IcsEvent[] = []
    let cur: Partial<IcsEvent> | null = null
    for (const line of lines) {
      if (line === 'BEGIN:VEVENT') cur = {}
      else if (line === 'END:VEVENT' && cur) {
        events.push(cur as IcsEvent)
        cur = null
      } else if (cur) {
        const i = line.indexOf(':')
        const key = line.slice(0, i).split(';')[0]
        const value = line.slice(i + 1)
        if (key === 'SUMMARY') cur.summary = unescape(value)
        else if (key === 'DTSTART') cur.start = value
        else if (key === 'DTEND') cur.end = value
        else if (key === 'LOCATION') cur.location = unescape(value)
        else if (key === 'DESCRIPTION') cur.description = unescape(value)
      }
    }
    return events
  }

  function fmtWhen(dt: string) {
    const d = new Date(
      +dt.slice(0, 4),
      +dt.slice(4, 6) - 1,
      +dt.slice(6, 8),
      +dt.slice(9, 11),
      +dt.slice(11, 13)
    )
    const date = d.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' })
    const time = d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })
    return `${date} · ${time.replace(':00', '').toLowerCase()}`
  }

  /**
   * Description as HTML for Google's add-event page, which (unlike .ics clients) renders
   * links: a `Label: https://…` line becomes a link reading "Label".
   */
  function googleDetails(description: string) {
    const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    return description
      .slice(0, 1500)
      .split('\n')
      .map((line) => {
        const link = line.match(/^(.+?): (https?:\/\/\S+)$/)
        return link ? `<a href="${esc(link[2])}">${esc(link[1])}</a>` : esc(line)
      })
      .join('<br>')
  }

  /** Google Calendar's add-event link, pre-filled; times stay in the event's own zone. */
  function googleEventUrl(e: IcsEvent) {
    const details = googleDetails(e.description || '')
    const params = new URLSearchParams({
      action: 'TEMPLATE',
      text: e.summary,
      dates: `${e.start}/${e.end}`,
      ctz: 'America/Los_Angeles',
      location: e.location || '',
      details
    })
    return `https://calendar.google.com/calendar/render?${params}`
  }

  // ── Modes ──
  function showSubscribe(feed: string, name: string) {
    tracking = { event: 'Calendar subscribe', props: { calendar: name } }
    const path = `/${feed}.ics`
    const webcal = `webcal://${location.host}${path}`
    nameEl.textContent = name
    webcalLink.href = webcal
    // Google can't subscribe from a webcal: link on another site; its cid parameter can.
    googleSubLink.href = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcal)}`
    urlInput.value = `${location.origin}${path}`
    copyBtn.textContent = 'Copy link'
  }

  async function showSave(path: string, fallbackName: string, single: boolean) {
    tracking = single
      ? { event: 'Calendar add event', props: { event: fallbackName || path } }
      : { event: 'Calendar download all dates', props: { activity: fallbackName } }
    nameEl.textContent = fallbackName
    whenList.innerHTML = ''
    downloadLink.href = `/${path}.ics`
    downloadLink.download = `${path.replace(/\//g, '-')}.ics`
    googleEventLink.hidden = !single
    saveNote.textContent = single
      ? 'Adds a copy of this event. It won’t change if the listing does — check back here before you go.'
      : 'Downloads every date as a copy. For Google Calendar, import the file under Settings → Import & export. Copies won’t change if the listing does.'
    try {
      const res = await fetch(`/${path}.ics`)
      if (!res.ok) throw new Error(String(res.status))
      const events = parseEvents(await res.text())
      if (single && events[0]) {
        const e = events[0]
        nameEl.textContent = e.summary
        tracking.props = { event: e.summary }
        whenList.innerHTML = ''
        whenList.append(li(fmtWhen(e.start)))
        if (e.location) whenList.append(li(e.location))
        googleEventLink.href = googleEventUrl(e)
      } else {
        events.forEach((e) => whenList.append(li(fmtWhen(e.start))))
      }
    } catch {
      googleEventLink.hidden = true
    }
  }

  function li(text: string) {
    const el = document.createElement('li')
    el.textContent = text
    return el
  }

  function open(trigger: HTMLElement) {
    const { icsChoices, icsMajors, icsFeed, icsEvent, icsDownload, icsName = '' } = trigger.dataset
    choices = icsChoices ? (JSON.parse(icsChoices) as Choice[]) : []
    majors = icsMajors ? (JSON.parse(icsMajors) as Major[]) : []
    const subscribing = Boolean(icsChoices || icsMajors || icsFeed)
    // The buttons all read "Add to my calendar"; the title says what this one does
    titleEl.textContent = subscribing ? 'Subscribe to this calendar' : 'Add to my calendar'
    subscribeSection.hidden = !subscribing
    saveSection.hidden = subscribing
    choiceWrap.hidden = choices.length === 0
    majorsWrap.hidden = !icsMajors
    if (icsMajors) {
      majorsList.innerHTML = ''
      for (const m of majors) {
        const label = document.createElement('label')
        const box = document.createElement('input')
        box.type = 'checkbox'
        box.value = String(m.code)
        box.checked = true
        box.addEventListener('change', showMajorsSelection)
        label.append(box, ` ${m.name}`)
        majorsList.append(label)
      }
      showMajorsSelection()
    } else if (choices.length) {
      choiceLabel.textContent = trigger.dataset.icsChoiceLabel || 'Calendar'
      choiceSelect.innerHTML = ''
      choices.forEach((c, i) => choiceSelect.add(new Option(c.label, String(i))))
      showSubscribe(choices[0].feed, choices[0].name)
    } else if (icsFeed) {
      showSubscribe(icsFeed, icsName)
    } else if (icsEvent) {
      showSave(icsEvent, icsName, true)
    } else if (icsDownload) {
      showSave(icsDownload, icsName, false)
    }
    dialog.showModal()
  }

  choiceSelect.addEventListener('change', () => {
    const c = choices[Number(choiceSelect.value)]
    if (c) showSubscribe(c.feed, c.name)
  })

  webcalLink.addEventListener('click', trackAs('Apple / Outlook'))
  googleSubLink.addEventListener('click', trackAs('Google'))
  downloadLink.addEventListener('click', trackAs('Apple / Outlook'))
  googleEventLink.addEventListener('click', trackAs('Google'))

  copyBtn.addEventListener('click', async () => {
    trackAs('Copy link')()
    try {
      await navigator.clipboard.writeText(urlInput.value)
      copyBtn.textContent = 'Copied ✓'
    } catch {
      // Clipboard API unavailable — select the text so it can be copied by hand
      urlInput.select()
      copyBtn.textContent = 'Press ⌘C / Ctrl+C'
    }
  })

  // Click on the backdrop (outside the dialog box) closes it
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close()
  })

  document.addEventListener('click', (e) => {
    const trigger = (e.target as Element | null)?.closest<HTMLElement>(
      '[data-ics-feed], [data-ics-choices], [data-ics-majors], [data-ics-event], [data-ics-download]'
    )
    if (!trigger) return
    e.preventDefault()
    e.stopPropagation()
    open(trigger)
  })
</script>

<style is:global>
  .ics-dialog {
    --ics-ink: #1a1612;
    --ics-muted: #6b6259;
    --ics-subtle: #9c9189;
    --ics-border: #e0d9d0;
    --ics-bg: #f7f4ef;
    width: min(440px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 20px 20px 18px;
    border: 1px solid #c8a96e;
    border-radius: 8px;
    background: #fff;
    color: var(--ics-ink);
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 14px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
  }
  .ics-dialog::backdrop {
    background: rgba(26, 22, 18, 0.45);
  }
  .ics-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 30px;
    height: 30px;
    border: none;
    background: none;
    font-size: 22px;
    line-height: 1;
    color: var(--ics-muted);
    cursor: pointer;
    border-radius: 4px;
  }
  .ics-close:hover {
    background: var(--ics-bg);
    color: var(--ics-ink);
  }
  .ics-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 36px 4px 0;
  }
  .ics-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.3;
    color: var(--ics-ink);
    margin: 0 0 14px;
  }
  .ics-choice {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    font-size: 12px;
    font-weight: 500;
    color: var(--ics-muted);
  }
  .ics-choice[hidden],
  .ics-section[hidden],
  .ics-btn[hidden] {
    display: none;
  }
  .ics-choice select {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 13px;
    color: var(--ics-ink);
    padding: 5px 8px;
    border: 1px solid var(--ics-border);
    border-radius: 4px;
    background: var(--ics-bg);
  }
  .ics-majors {
    border: none;
    margin: 0 0 12px;
    padding: 0;
  }
  .ics-majors legend {
    padding: 0;
    font-size: 12px;
    font-weight: 500;
    color: var(--ics-muted);
    margin-bottom: 6px;
  }
  /* Matches the subscribe form's company ticks (SubscribeChoices.astro) */
  .ics-majors-list {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 4px 24px;
    font-size: 13px;
  }
  .ics-majors-list label {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    white-space: nowrap;
  }
  .ics-majors-list input {
    accent-color: #2e2a26;
    margin: 0;
  }
  @media (max-width: 460px) {
    .ics-majors-list {
      grid-template-columns: 1fr;
    }
  }
  .ics-majors[hidden] {
    display: none;
  }
  .ics-section {
    border-top: 1px solid var(--ics-border);
    padding-top: 12px;
  }
  .ics-note {
    font-size: 12px;
    line-height: 1.45;
    color: var(--ics-muted);
    margin: 0 0 10px;
  }
  .ics-note--small {
    font-size: 11px;
    color: var(--ics-subtle);
    margin: 8px 0 0;
  }
  .ics-when {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    font-size: 13px;
    color: var(--ics-muted);
    max-height: 160px;
    overflow-y: auto;
  }
  .ics-when li + li {
    margin-top: 2px;
  }
  .ics-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .ics-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    padding: 7px 12px;
    border-radius: 4px;
    border: 1px solid var(--ics-border);
    background: #fff;
    color: var(--ics-ink);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .ics-btn:hover {
    border-color: #c8a96e;
  }
  .ics-btn--primary {
    flex: 1 1 160px;
    background: var(--ics-ink);
    border-color: var(--ics-ink);
    color: #fff;
  }
  .ics-btn--primary:hover {
    background: #333;
    border-color: #333;
  }
  .ics-copy {
    display: flex;
    gap: 6px;
    margin-top: 10px;
  }
  .ics-url {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 12px;
    color: var(--ics-muted);
    padding: 6px 8px;
    border: 1px solid var(--ics-border);
    border-radius: 4px;
    background: var(--ics-bg);
  }
</style>
