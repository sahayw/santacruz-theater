---
interface Props {
  currentPage?: 'calendar' | 'companies' | 'events' | 'services';
}
const { currentPage } = Astro.props;
---

<nav class="site-nav">
  <a href="/" class="nav-brand">Santa Cruz Theater</a>
  <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
  </button>
  <ul class="nav-links">
    <li>
      <a
        href="/calendar"
        class={`nav-link${currentPage === 'calendar' ? ' nav-link--active' : ''}`}
      >Calendar</a>
    </li>
    <li>
      <a
        href="/companies"
        class={`nav-link${currentPage === 'companies' ? ' nav-link--active' : ''}`}
      >Companies</a>
    </li>
    <li>
      <a
        href="/events"
        class={`nav-link${currentPage === 'events' ? ' nav-link--active' : ''}`}
      >Events</a>
    </li>
    <li>
      <a
        href="/services"
        class={`nav-link${currentPage === 'services' ? ' nav-link--active' : ''}`}
      >Services</a>
    </li>
  </ul>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.querySelector<HTMLElement>('.nav-links');

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('nav-links--open');
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  links?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      links.classList.remove('nav-links--open');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('click', e => {
    if (!toggle?.contains(e.target as Node) && !links?.contains(e.target as Node)) {
      links?.classList.remove('nav-links--open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  :root {
    --bar-bg: #2e2a26;
  }

  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 130;
    height: 44px;
    background: var(--bar-bg);
    display: flex;
    align-items: center;
    padding: 0 20px;
  }

  .nav-brand {
    font-family: 'Playfair Display', serif;
    font-size: 15px;
    font-weight: 600;
    color: #e2d5b8;
    text-decoration: none;
    letter-spacing: 0.03em;
    flex: 0 0 auto;
    white-space: nowrap;
    transition: color 0.14s;
  }
  .nav-brand:hover {
    color: #d4b87c;
  }

  .nav-toggle {
    display: none;
    margin-left: auto;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 4px;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-toggle-bar {
    display: block;
    width: 18px;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.65);
    border-radius: 1px;
    transition: background 0.14s;
  }

  .nav-toggle:hover .nav-toggle-bar {
    background: rgba(255, 255, 255, 0.9);
  }

  .nav-links {
    list-style: none;
    display: flex;
    margin-left: auto;
    gap: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    color: rgba(255, 255, 255, 0.58);
    text-decoration: none;
    padding: 5px 11px;
    border-radius: 4px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.01em;
    transition: color 0.14s;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-link:hover {
    color: #d4b87c;
  }

  .nav-link--active {
    color: #d4b87c;
    font-weight: 500;
    pointer-events: none;
  }

  @media (max-width: 560px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 44px;
      right: 0;
      flex-direction: column;
      gap: 2px;
      padding: 4px;
      background: var(--bar-bg);
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.07);
      border-radius: 0 0 6px 6px;
    }

    .nav-links--open {
      display: flex;
    }

    .nav-link {
      white-space: nowrap;
      padding: 8px 14px;
    }
  }
</style>
