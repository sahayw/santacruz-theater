---
// The dark bar under the nav on /productions, styled like the calendar's:
// just the page title, centred.
interface Props {
  title: string
}
const { title } = Astro.props
---

<div class="page-bar">
  <h1 class="page-bar-title" id="page-bar-title">{title}</h1>
</div>

<style is:global>
  :root {
    --page-bar-h: 36px;
  }

  .page-bar {
    position: fixed;
    top: var(--nav-h, 44px);
    left: 0;
    right: 0;
    z-index: 110;
    height: var(--page-bar-h);
    background: #2e2a26;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
  }

  .page-bar-title {
    font-family: 'DM Serif Display', serif;
    font-size: 18px;
    font-weight: 400;
    color: #fff;
    letter-spacing: 0.01em;
    white-space: nowrap;
    margin: 0;
  }

  /* Under the bar: the page's description, and the count on the right */
  .page-intro {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .page-intro p {
    font-size: 13px;
    font-weight: 300;
    color: #6b6259;
  }
  .page-intro p a {
    color: #4f5ce0;
  }
  .page-count {
    font-size: 12px;
    font-weight: 500;
    color: #6b6259;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .page-bar {
      padding: 0 12px;
    }
    .page-bar-title {
      font-size: 16px;
    }
  }
</style>
