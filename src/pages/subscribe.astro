---
import BaseHead from '../components/BaseHead.astro'
import SiteNav from '../components/SiteNav.astro'
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Subscribe to Audition & Event Notices — Santa Cruz Theater"
      description="Get an email when new auditions and events are posted by Santa Cruz County theater companies."
      canonicalPath="/subscribe"
    />
  </head>
  <body>
    <SiteNav />

    <main class="sub-page">
      <div class="sub-container">
        <a href="/events" class="back-link">&#8592; Events</a>

        <header class="sub-header">
          <h1 class="sub-title">Audition & Event Notices</h1>
          <p class="sub-desc">
            Get an email when new auditions and events are posted by Santa Cruz County theater companies.
            Unsubscribe any time — there's a link in every email.
          </p>
        </header>

        <div class="sub-card" id="sub-card">
          <form id="subscribe-form" class="sub-form" novalidate>
            <label for="subscribe-email" class="sub-label">Your email address</label>
            <div class="sub-field-row">
              <input
                type="email"
                id="subscribe-email"
                class="sub-input"
                placeholder="you@example.com"
                autocomplete="email"
                required
              />
              <button type="submit" id="subscribe-btn" class="sub-btn">Subscribe</button>
            </div>
          </form>
          <div id="subscribe-status" class="sub-status" hidden aria-live="polite"></div>
        </div>

        <p class="sub-note">
          Emails are sent as a daily digest when new or updated auditions or events have been posted.
          No other emails — just theater notices.
        </p>
      </div>
    </main>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --nav-h: 44px;
    --page-bg: #f0ede8;
    --surface: #ffffff;
    --ink: #1a1612;
    --ink-muted: #6b6259;
    --ink-subtle: #9c9189;
    --border: #e0d9d0;
    --border-primary: #c8a96e;
    --radius: 6px;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--page-bg);
    color: var(--ink);
    min-height: 100vh;
    font-size: 14px;
  }

  .sub-page {
    margin-top: var(--nav-h);
    min-height: calc(100vh - var(--nav-h));
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 48px 24px 80px;
  }

  .sub-container {
    width: 100%;
    max-width: 480px;
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: var(--ink-muted);
    text-decoration: none;
    margin-bottom: 32px;
    transition: color 0.14s;
  }

  .back-link:hover {
    color: var(--ink);
  }

  /* ── HEADER ── */
  .sub-header {
    margin-bottom: 28px;
  }

  .sub-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(26px, 4vw, 36px);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.15;
    margin-bottom: 10px;
  }

  .sub-desc {
    font-size: 14px;
    font-weight: 300;
    color: var(--ink-muted);
    line-height: 1.6;
    letter-spacing: 0.01em;
  }

  /* ── FORM CARD ── */
  .sub-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    margin-bottom: 20px;
  }

  .sub-label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-muted);
    margin-bottom: 8px;
    letter-spacing: 0.01em;
  }

  .sub-field-row {
    display: flex;
    gap: 8px;
  }

  .sub-input {
    font-family: inherit;
    font-size: 14px;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 9px 12px;
    flex: 1;
    color: var(--ink);
    background: #f7f4ef;
    min-width: 0;
    transition: border-color 0.14s;
  }

  .sub-input:focus {
    outline: none;
    border-color: var(--border-primary);
  }

  .sub-btn {
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    background: var(--ink);
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 9px 18px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.14s;
  }

  .sub-btn:hover:not(:disabled) {
    background: #333;
  }

  .sub-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* ── STATUS ── */
  .sub-status {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.5;
    padding: 12px 16px;
    border-radius: 4px;
  }

  .sub-status.ok {
    background: #edf7ea;
    border: 1px solid #b8e0b0;
    color: #2d6020;
  }

  .sub-status.err {
    background: #fdf0ed;
    border: 1px solid #f0c5bb;
    color: #8c3a2e;
  }

  .sub-status.pending {
    background: #f7f4ef;
    border: 1px solid #e0d9d0;
    color: #6b6259;
  }

  /* ── FOOTER NOTE ── */
  .sub-note {
    font-size: 12px;
    color: var(--ink-subtle);
    line-height: 1.6;
  }

  @media (max-width: 520px) {
    .sub-page {
      padding: 32px 16px 64px;
    }

    .sub-field-row {
      flex-direction: column;
    }

    .sub-btn {
      width: 100%;
    }
  }
</style>

<script is:inline>
  const form = document.getElementById('subscribe-form')
  const emailInput = document.getElementById('subscribe-email')
  const btn = document.getElementById('subscribe-btn')
  const status = document.getElementById('subscribe-status')

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = emailInput.value.trim()
    if (!email) return

    btn.disabled = true
    btn.textContent = 'Sending…'
    status.textContent = 'Subscribing…'
    status.className = 'sub-status pending'
    status.hidden = false

    try {
      const resp = await fetch('/.netlify/functions/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      })
      let data = {}
      try {
        data = await resp.json()
      } catch {}
      const msg =
        data.message ||
        (resp.ok ? 'Subscribed!' : 'Something went wrong — please try again shortly.')
      status.textContent = resp.ok ? msg : `${msg} [${resp.status}]`
      status.className = `sub-status ${resp.ok ? 'ok' : 'err'}`
      status.hidden = false
      if (resp.ok) {
        emailInput.value = ''
        form.style.display = 'none'
      }
    } catch {
      status.textContent = 'Network error — please try again shortly.'
      status.className = 'sub-status err'
      status.hidden = false
    } finally {
      btn.disabled = false
      btn.textContent = 'Subscribe'
    }
  })
</script>
