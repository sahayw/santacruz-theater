---
import BaseHead from '../components/BaseHead.astro'
import SiteNav from '../components/SiteNav.astro'
import { getServices, getServiceCategories } from '../lib/data.ts'

const listings = getServices()
const categories = getServiceCategories()

// Compute which subcategory and parent ids have active listings (for index inactive state)
const activeSubIds = new Set(listings.flatMap((l) => l.categories))
const activeCatIds = new Set(
  categories
    .filter((cat) => cat.subcategories.some((s) => activeSubIds.has(s.id)))
    .map((cat) => cat.id)
)

// Build a lookup: subcategoryId → label (for card pills)
const subLabelMap: Record<string, string> = {}
for (const cat of categories) {
  for (const sub of cat.subcategories) {
    subLabelMap[sub.id] = sub.label
  }
}

// Full category data for client-side filter UI
const catsJson = JSON.stringify(
  categories.map((cat) => ({
    id: cat.id,
    label: cat.label,
    subcategories: cat.subcategories.map((s) => ({ id: s.id, label: s.label }))
  }))
)
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Services — Santa Cruz Theater"
      description="Connect with photographers, equipment rental, spaces, crew, and coaches for Santa Cruz County theater."
      canonicalPath="/services"
    />
  </head>
  <body>
    <SiteNav currentPage="services" />

    <main class="svc-page">
      <header class="page-header">
        <h1 class="page-title" id="page-title">Services</h1>
        <p class="page-subtitle" id="page-subtitle">
          Production resources for Santa Cruz County theater — photographers, equipment, spaces, crew, and coaches
        </p>
      </header>

      {/* ── CATEGORY INDEX (index mode only) ── */}
      <div class="cat-index" id="cat-index">
        {categories.map((cat) => {
          const catActive = activeCatIds.has(cat.id)
          return (
            <div class="cat-index-group">
              {catActive ? (
                <a class="cat-parent-link" href={`/services?category=${cat.id}`}>{cat.label}</a>
              ) : (
                <span class="cat-parent-link cat-inactive">{cat.label}</span>
              )}
              <div class="cat-subs-list">
                {cat.subcategories.map((sub) => {
                  const subActive = activeSubIds.has(sub.id)
                  return subActive ? (
                    <a class="cat-sub-link" href={`/services?category=${sub.id}`}>{sub.label}</a>
                  ) : (
                    <span class="cat-sub-link cat-inactive">{sub.label}</span>
                  )
                })}
              </div>
            </div>
          )
        })}
      </div>

      {/* ── FILTER PANEL (filtered mode only) ── */}
      <div class="filter-panel" id="filter-panel" hidden>
        <div class="filter-cats-row" id="filter-cats-row">
          {categories.map((cat) => (
            <button class="filter-cat-btn" data-parent={cat.id}
              onclick={`svc.toggleParent('${cat.id}')`}>
              {cat.label}
            </button>
          ))}
        </div>
        {categories.map((cat) => (
          <div class="filter-subs-row" id={`filter-subs-${cat.id}`} hidden>
            {cat.subcategories.map((sub) => (
              <label class="filter-sub-label">
                <input type="checkbox" class="filter-sub-cb" data-sub={sub.id}
                  data-parent={cat.id} onchange="svc.applyFilter()" />
                {sub.label}
              </label>
            ))}
          </div>
        ))}
        <div class="filter-count-row">
          <span class="filter-count" id="filter-count" aria-live="polite"></span>
        </div>
      </div>

      {/* ── LISTING CARDS (filtered and deep-link modes) ── */}
      <div class="svc-list" id="svc-list" hidden>
        {listings.map((listing) => (
          <div
            class="svc-card"
            data-id={listing.id}
            data-categories={listing.categories.join(',')}
          >
            {/* ── Collapsed summary ── */}
            <button class="svc-summary" aria-expanded="false">
              <div class="svc-main">
                <div class="svc-name-row">
                  <span class="svc-name">{listing.name}</span>
                </div>
                <div class="svc-cats-row">
                  {listing.categories.map((catId) => (
                    <span class="svc-cat-pill">{subLabelMap[catId] ?? catId}</span>
                  ))}
                </div>
                <div class="svc-contact-row">
                  {listing.photo && (
                    <img
                      class="svc-photo"
                      src={listing.photo}
                      alt=""
                      width="80"
                      height="80"
                      loading="lazy"
                    />
                  )}
                  <div class="svc-contact-info">
                    {listing.contact.name && (
                      <span class="svc-contact-name">{listing.contact.name}</span>
                    )}
                    {listing.contact.tel && (
                      <a class="svc-contact-link" href={`tel:${listing.contact.tel}`}>{listing.contact.tel}</a>
                    )}
                    {listing.contact.email && (
                      <a class="svc-contact-link" href={`mailto:${listing.contact.email}`}>{listing.contact.email}</a>
                    )}
                    {listing.contact.address && (
                      <span class="svc-contact-address">{listing.contact.address}</span>
                    )}
                  </div>
                </div>
              </div>
              <div class="svc-aside">
                <span class="svc-chevron" aria-hidden="true" />
              </div>
            </button>

            {/* ── Expanded detail ── */}
            <div class="svc-detail" hidden>
              {listing.description && (
                <div class="svc-desc">{listing.description}</div>
              )}
              {listing.url && (
                <div class="svc-url-row">
                  <a class="svc-action-link" href={listing.url} target="_blank" rel="noopener">
                    More info →
                  </a>
                </div>
              )}
            </div>
          </div>
        ))}

        <div class="svc-empty" id="svc-empty" hidden>
          No listings match the current filter.
        </div>
      </div>

      <div class="svc-not-found" id="svc-not-found" hidden></div>
    </main>

    <script is:inline type="application/json" id="svc-cats-data" set:html={catsJson} />
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --nav-h: 44px;
    --page-bg: #f0ede8;
    --bg: #f7f4ef;
    --surface: #ffffff;
    --ink: #1a1612;
    --ink-muted: #6b6259;
    --ink-subtle: #9c9189;
    --border: #e0d9d0;
    --border-primary: #c8a96e;
    --radius: 6px;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--page-bg);
    color: var(--ink);
    min-height: 100vh;
    font-size: 14px;
  }

  /* ── PAGE LAYOUT ── */
  .svc-page {
    margin-top: var(--nav-h);
    padding: 32px 32px 80px;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ── PAGE HEADER ── */
  .page-header {
    margin-bottom: 28px;
  }

  .page-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.15;
    margin-bottom: 6px;
  }

  .page-subtitle {
    font-size: 14px;
    font-weight: 300;
    color: var(--ink-muted);
    letter-spacing: 0.01em;
  }

  /* ── CATEGORY INDEX (two-level list) ── */
  .cat-index {
    columns: 2;
    column-gap: 48px;
  }

  .cat-index-group {
    break-inside: avoid;
    margin-bottom: 24px;
  }

  .cat-parent-link {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 10px;
    line-height: 1.3;
    transition: color 0.14s;
  }

  a.cat-parent-link:hover {
    color: var(--border-primary);
  }

  .cat-parent-link.cat-inactive {
    color: var(--ink-subtle);
    cursor: default;
  }

  .cat-subs-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cat-sub-link {
    display: block;
    font-size: 13px;
    color: var(--ink-muted);
    text-decoration: none;
    padding-left: 10px;
    border-left: 2px solid var(--border);
    line-height: 1.4;
    transition: color 0.14s, border-color 0.14s;
  }

  a.cat-sub-link:hover {
    color: var(--ink);
    border-left-color: var(--border-primary);
  }

  .cat-sub-link.cat-inactive {
    color: var(--ink-subtle);
    cursor: default;
  }

  /* ── FILTER PANEL (filtered mode) ── */
  .filter-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 20px;
    overflow: hidden;
  }

  .filter-cats-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 12px 14px 10px;
    border-bottom: 1px solid var(--border);
  }

  .filter-cat-btn {
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 12px;
    border-radius: 20px;
    border: 1.5px solid var(--border);
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    transition: background 0.13s, border-color 0.13s, color 0.13s;
    -webkit-tap-highlight-color: transparent;
  }

  .filter-cat-btn:hover {
    border-color: var(--ink-subtle);
    color: var(--ink);
  }

  .filter-cat-btn.active {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .filter-subs-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .filter-sub-label {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: var(--ink-muted);
    cursor: pointer;
  }

  .filter-sub-label input[type="checkbox"] {
    width: 13px;
    height: 13px;
    cursor: pointer;
    accent-color: var(--ink);
    flex-shrink: 0;
  }

  .filter-count-row {
    padding: 6px 14px;
  }

  .filter-count {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-muted);
  }

  /* ── EMPTY / NOT-FOUND STATES ── */
  .svc-empty,
  .svc-not-found {
    padding: 48px 24px;
    text-align: center;
    font-size: 14px;
    color: var(--ink-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* ── CARD LIST ── */
  .svc-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* ── CARD ── */
  .svc-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .svc-card.open {
    border-color: var(--border-primary);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
  }

  /* ── SUMMARY ROW (collapsed) ── */
  .svc-summary {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
    padding: 14px 16px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) {
    .svc-summary:hover {
      background: rgba(0, 0, 0, 0.02);
    }
  }

  .svc-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .svc-name-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .svc-name {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.25;
  }

  .svc-cats-row {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .svc-cat-pill {
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 10px;
    background: #f0ece6;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .svc-contact-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 2px;
  }

  .svc-photo {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .svc-contact-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    min-width: 0;
  }

  .svc-contact-name {
    font-weight: 500;
    color: var(--ink);
  }

  .svc-contact-link {
    color: #4f5ce0;
    text-decoration: none;
    font-size: 12px;
  }

  .svc-contact-link:hover {
    text-decoration: underline;
  }

  .svc-contact-address {
    font-size: 12px;
    color: var(--ink-muted);
  }

  /* Right aside — chevron */
  .svc-aside {
    flex-shrink: 0;
    padding-top: 2px;
  }

  .svc-chevron {
    display: block;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-subtle);
    border-bottom: 2px solid var(--ink-subtle);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .svc-card.open .svc-chevron {
    transform: rotate(-135deg);
  }

  /* ── DETAIL PANEL (expanded) ── */
  .svc-detail {
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .svc-desc {
    font-size: 13px;
    color: var(--ink);
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .svc-url-row {
    display: flex;
  }

  .svc-action-link {
    font-size: 13px;
    font-weight: 500;
    color: #4f5ce0;
    text-decoration: none;
    transition: color 0.14s;
  }

  .svc-action-link:hover {
    color: #2c3e9a;
    text-decoration: underline;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 860px) {
    .svc-page {
      padding: 28px 24px 64px;
    }
  }

  @media (max-width: 600px) {
    .svc-page {
      padding: 20px 16px 56px;
    }
    .cat-index {
      columns: 1;
    }
  }
</style>

<script is:inline>
  const CATS = JSON.parse(document.getElementById('svc-cats-data').textContent)

  // Build parent→subcategory map and sub→parent map
  const parentSubs = {}
  const subParent = {}
  CATS.forEach((cat) => {
    parentSubs[cat.id] = cat.subcategories.map((s) => s.id)
    cat.subcategories.forEach((s) => { subParent[s.id] = cat.id })
  })

  const cards = Array.from(document.querySelectorAll('.svc-card'))
  const catIndex = document.getElementById('cat-index')
  const filterPanel = document.getElementById('filter-panel')
  const svcList = document.getElementById('svc-list')
  const countEl = document.getElementById('filter-count')
  const emptyEl = document.getElementById('svc-empty')
  const notFoundEl = document.getElementById('svc-not-found')

  // ── FILTER LOGIC ──
  function getSelectedSubs() {
    return Array.from(document.querySelectorAll('.filter-sub-cb:checked')).map((cb) => cb.dataset.sub)
  }

  function applyFilter() {
    const selected = new Set(getSelectedSubs())
    let visible = 0
    cards.forEach((card) => {
      const cardCats = (card.dataset.categories || '').split(',').filter(Boolean)
      const show = selected.size === 0 ? false : cardCats.some((c) => selected.has(c))
      card.style.display = show ? '' : 'none'
      if (show) visible++
    })
    if (countEl) countEl.textContent = `${visible} ${visible === 1 ? 'listing' : 'listings'}`
    if (emptyEl) emptyEl.hidden = visible > 0
  }

  function toggleParent(parentId) {
    const btn = document.querySelector(`.filter-cat-btn[data-parent="${parentId}"]`)
    const subsRow = document.getElementById(`filter-subs-${parentId}`)
    if (!btn || !subsRow) return

    const isNowActive = !btn.classList.contains('active')
    btn.classList.toggle('active', isNowActive)

    if (isNowActive) {
      // Show sub row and pre-check all subcategories
      subsRow.hidden = false
      subsRow.querySelectorAll('.filter-sub-cb').forEach((cb) => { cb.checked = true })
    } else {
      // Hide sub row and uncheck all
      subsRow.hidden = true
      subsRow.querySelectorAll('.filter-sub-cb').forEach((cb) => { cb.checked = false })
    }
    applyFilter()
  }

  function activateCategory(catId) {
    // catId may be a parent or a subcategory id
    const isParent = !!parentSubs[catId]
    const parentId = isParent ? catId : subParent[catId]
    if (!parentId) return

    // Activate the parent button
    const btn = document.querySelector(`.filter-cat-btn[data-parent="${parentId}"]`)
    const subsRow = document.getElementById(`filter-subs-${parentId}`)
    if (!btn || !subsRow) return
    btn.classList.add('active')
    subsRow.hidden = false

    if (isParent) {
      // Select all subcategories
      subsRow.querySelectorAll('.filter-sub-cb').forEach((cb) => { cb.checked = true })
    } else {
      // Select only the specific subcategory
      subsRow.querySelectorAll('.filter-sub-cb').forEach((cb) => {
        cb.checked = cb.dataset.sub === catId
      })
    }
  }

  function openCard(card) {
    const btn = card.querySelector('.svc-summary')
    const detail = card.querySelector('.svc-detail')
    if (!btn || !detail) return
    card.classList.add('open')
    detail.hidden = false
    btn.setAttribute('aria-expanded', 'true')
  }

  // ── ROUTING ──
  const params = new URLSearchParams(location.search)
  const deepId = params.get('id')
  const catParam = params.get('category')

  if (deepId) {
    // Deep-link mode
    const targetCard = cards.find((c) => c.dataset.id === 'service-' + deepId) ?? null
    catIndex.hidden = true
    if (targetCard && svcList) {
      svcList.hidden = false
      cards.forEach((c) => { if (c !== targetCard) c.style.display = 'none' })
      openCard(targetCard)
      const titleEl = document.getElementById('page-title')
      if (titleEl) titleEl.textContent = targetCard.querySelector('.svc-name')?.textContent ?? 'Service'
      document.getElementById('page-subtitle').style.display = 'none'
      const svcNav = document.querySelector('a.nav-link--active[href="/services"]')
      if (svcNav) svcNav.style.pointerEvents = 'auto'
    } else {
      if (svcList) svcList.hidden = true
      if (notFoundEl) { notFoundEl.textContent = `service-${deepId} not found`; notFoundEl.hidden = false }
      const svcNav = document.querySelector('a.nav-link--active[href="/services"]')
      if (svcNav) svcNav.style.pointerEvents = 'auto'
    }
  } else if (catParam) {
    // Filtered mode
    catIndex.hidden = true
    if (filterPanel) filterPanel.hidden = false
    if (svcList) svcList.hidden = false
    activateCategory(catParam)
    applyFilter()
  }
  // else: index mode — cat-index visible, svc-list hidden (defaults)

  // Expose for inline onchange/onclick handlers
  window.svc = { toggleParent, applyFilter }

  // Expand / collapse cards
  document.querySelectorAll('.svc-summary').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.svc-card')
      const detail = card?.querySelector('.svc-detail')
      if (!card || !detail) return
      const isOpen = card.classList.toggle('open')
      detail.hidden = !isOpen
      btn.setAttribute('aria-expanded', String(isOpen))
    })
  })
</script>
