    transition: transform 0.2s ease;
    margin-top: 4px;
    flex-shrink: 0;
  }

  .aud-card.open .aud-chevron {
    transform: rotate(-135deg);
  }

  /* ── DETAIL PANEL (expanded) ── */
  .aud-detail {
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 20px 16px 16px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 32px;
    margin-bottom: 16px;
  }

  /* No right column (no roles / no description) → left column spans full width */
  .detail-grid:not(:has(.detail-right)) {
    grid-template-columns: 1fr;
  }

  .detail-left,
  .detail-right {
    min-width: 0;
  }

  .detail-section {
    margin-bottom: 16px;
  }

  .detail-section:last-child {
    margin-bottom: 0;
  }

  .detail-section-head {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin-bottom: 8px;
  }

  .contact-section .detail-section-head {
    margin-bottom: 4px;
  }

  /* Date rows */
  .detail-date-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 5px;
    font-size: 13px;
  }

  .session-add {
    margin-left: auto;
    font-family: inherit;
    font-size: 12px;
    color: #4f5ce0;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .session-add:hover {
    text-decoration: underline;
  }

  .detail-date-row.past .session-add,
  .aud-card.past .detail-cal-btn {
    display: none;
  }

  .detail-date-label {
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }

  .detail-time-label {
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .detail-date-note {
    font-size: 11px;
    color: var(--ink-subtle);
    font-style: italic;
  }

  /* Per-date location */
  .detail-date-location {
    width: 100%;
    font-size: 12px;
    color: var(--ink-muted);
    margin-top: 1px;
  }

  .detail-location-name {
    font-weight: 500;
    color: var(--ink-muted);
  }

  .detail-sub {
    font-size: 12px;
    color: var(--ink-muted);
    line-height: 1.5;
  }

  /* Prep */
  .detail-prep-row {
    display: flex;
    gap: 6px;
    font-size: 13px;
    margin-bottom: 5px;
    line-height: 1.45;
  }

  .detail-prep-row:last-child {
    margin-bottom: 0;
  }

  .prep-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    white-space: nowrap;
    padding-top: 2px;
    flex-shrink: 0;
    min-width: 48px;
  }

  .prep-value {
    white-space: pre-line;
  }

  .detail-virtual-note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-muted);
    margin: 0;
  }

  /* Contact */
  .detail-contact-name {
    font-size: 13px;
    color: var(--ink);
    margin-bottom: 2px;
  }

  .detail-link-inline {
    font-size: 12px;
    color: #4f5ce0;
    text-decoration: none;
  }
  .detail-link-inline:hover {
    text-decoration: underline;
  }

  /* ── ROLES TABLE ── */
  .roles-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .roles-table th {
    text-align: left;
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-muted);
    padding: 0 10px 5px 0;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .roles-table td {
    padding: 6px 10px 6px 0;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    line-height: 1.4;
  }

  .roles-table tr:last-child td {
    border-bottom: none;
  }

  .role-name-cell {
    font-weight: 500;
    color: var(--ink);
  }

  .roles-table tr.has-desc td {
    border-bottom: none;
    padding-bottom: 2px;
  }

  .role-desc-cell {
    padding-top: 0;
  }

  .role-desc {
    display: block;
    font-size: 11px;
    font-weight: 400;
    color: var(--ink-muted);
    font-style: italic;
    line-height: 1.4;
    max-width: 80%;
  }

  .role-type {
    white-space: nowrap;
  }

  .role-lead {
    color: #6c3bb5;
    font-weight: 500;
  }
  .role-supporting {
    color: var(--ink-muted);
  }
  .role-ensemble {
    color: var(--ink-subtle);
    font-style: italic;
  }

  .role-age {
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .role-voice {
    color: var(--ink-muted);
  }

  /* ── DETAIL FOOTER ── */
  .detail-notes-full {
    font-size: 13px;
    color: var(--ink-muted);
    line-height: 1.6;
    padding: 12px 0 8px;
    border-top: 1px solid var(--border);
    margin-top: 4px;
    font-style: italic;
    white-space: pre-wrap;
  }

  .detail-links-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    margin-top: 4px;
  }

  .aud-detail .detail-notes-full + .detail-links-row,
  .aud-detail .detail-grid + .detail-links-row {
    margin-top: 0;
  }

  .detail-cal-btn {
    margin-left: auto;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .detail-cal-btn {
      margin-left: 0;
    }
  }

  .detail-action-link {
    font-size: 13px;
    font-weight: 500;
    color: #4f5ce0;
    text-decoration: none;
    transition: color 0.14s;
  }
  .detail-action-link:hover {
    color: #2c3e9a;
    text-decoration: underline;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 860px) {
    .aud-page {
      padding: 28px 24px 64px;
    }
    .filter-bar {
      margin: 0 -24px;
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  @media (max-width: 600px) {
    .aud-page {
      padding: 20px 16px 56px;
    }
    .filter-bar {
      margin: 0 -16px;
      padding-left: 16px;
      padding-right: 16px;
    }
    .filter-controls {
      gap: 8px;
    }
    .detail-grid {
      grid-template-columns: 1fr;
    }
    .aud-aside {
      min-width: 72px;
    }
    .aud-title {
      font-size: 15px;
    }
    .aud-meta-row {
      white-space: normal;
    }
  }

  @media (max-width: 420px) {
    .filter-controls {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script is:inline>
  const TODAY = new Date().toISOString().slice(0, 10)

  const cards = Array.from(document.querySelectorAll('.aud-card'))
  const countEl = document.getElementById('filter-count')
  const filterCompany = document.getElementById('filter-company')
  const filterShow = document.getElementById('filter-show')
  const emptyEl = document.getElementById('aud-empty')

  // Date-free virtual auditions and by-request events stay upcoming until closed.
  function notUpcoming(card) {
    if (card.dataset.closed === 'true') return true
    if (card.dataset.virtual === 'true') return false
    if (card.dataset.datesByRequest === 'true' && !card.dataset.latestDate) return false
    return (card.dataset.latestDate ?? '') < TODAY
  }

  // Mark past / closed cards (drives the pips via CSS), and past sessions (hides their
  // Add to my calendar link)
  cards.forEach((card) => {
    if (card.dataset.closed === 'true') card.classList.add('closed')
    if (notUpcoming(card)) card.classList.add('past')
    card.querySelectorAll('.detail-date-row[data-date]').forEach((row) => {
      if (row.dataset.date < TODAY) row.classList.add('past')
    })
  })

  function updateFilters() {
    const co = filterCompany?.value ?? ''
    const sh = filterShow?.value ?? 'upcoming'
    let visible = 0

    // Close all open cards
    cards.forEach((card) => {
      if (card.classList.contains('open')) {
        const btn = card.querySelector('.aud-summary')
        const detail = card.querySelector('.aud-detail')
        card.classList.remove('open')
        if (detail) detail.hidden = true
        if (btn) btn.setAttribute('aria-expanded', 'false')
      }
    })

    cards.forEach((card) => {
      const matchCo = !co || card.dataset.company === co
      const isPast = notUpcoming(card)
      const isAud = card.dataset.type === 'audition'

      let matchSh
      if (sh === 'all') matchSh = true
      else if (sh === 'upcoming') matchSh = !isPast
      else if (sh === 'auditions') matchSh = !isPast && isAud
      else matchSh = !isPast && !isAud /* 'events' */

      const show = matchCo && matchSh
      card.style.display = show ? '' : 'none'
      if (show) visible++
    })

    if (countEl) {
      const sh = filterShow.value
      const label =
        sh === 'auditions'
          ? visible === 1
            ? 'audition'
            : 'auditions'
          : sh === 'events'
            ? visible === 1
              ? 'event'
              : 'events'
            : visible === 1
              ? 'activity'
              : 'activities'
      countEl.textContent = `${visible} ${label}`
    }
    if (emptyEl) {
      emptyEl.hidden = visible > 0
    }
  }

  function openCard(card) {
    const btn = card.querySelector('.aud-summary')
    const detail = card.querySelector('.aud-detail')
    if (!btn || !detail) return
    card.classList.add('open')
    detail.hidden = false
    btn.setAttribute('aria-expanded', 'true')
  }

  // Deep-link: ?id=<timestamp> (prefix "activity-" stripped from URL for brevity)
  const deepId = new URLSearchParams(location.search).get('id')
  const deepCard = deepId
    ? (cards.find((c) => c.dataset.id === 'activity-' + deepId) ?? null)
    : null

  if (deepId && deepCard) {
    // Single-card mode: show only the linked record, no filters
    const titleEl = document.querySelector('.page-title')
    titleEl.textContent = deepCard.dataset.type === 'event' ? 'Event' : 'Audition'
    titleEl.style.fontSize = '18px'
    document.querySelector('.page-subtitle').style.display = 'none'
    document.querySelector('.filter-bar').style.display = 'none'
    document.getElementById('aud-subscribe').style.display = 'none'
    cards.forEach((c) => {
      if (c !== deepCard) c.style.display = 'none'
    })
    openCard(deepCard)
    // Re-enable the Events nav link so it navigates back to the full list
    const evNav = document.querySelector('a.nav-link--active[href="/events"]')
    if (evNav) evNav.style.pointerEvents = 'auto'
  } else if (deepId) {
    // Unrecognised id — show error, suppress list and filters
    document.querySelector('.filter-bar').style.display = 'none'
    document.getElementById('aud-subscribe').style.display = 'none'
    document.getElementById('aud-list')?.style.setProperty('display', 'none')
    const notFound = document.getElementById('aud-not-found')
    notFound.textContent = `activity-${deepId} not found`
    notFound.hidden = false
    const evNav = document.querySelector('a.nav-link--active[href="/events"]')
    if (evNav) evNav.style.pointerEvents = 'auto'
  } else {
    // Normal list mode
    filterShow.value = 'upcoming'
    updateFilters()
    filterCompany?.addEventListener('change', updateFilters)
    filterShow?.addEventListener('change', updateFilters)
  }

  // Expand / collapse
  document.querySelectorAll('.aud-summary').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.aud-card')
      const detail = card?.querySelector('.aud-detail')
      if (!card || !detail) return
      const isOpen = card.classList.toggle('open')
      detail.hidden = !isOpen
      btn.setAttribute('aria-expanded', String(isOpen))
    })
  })

  // Subscribe form
  const subscribeForm = document.getElementById('subscribe-form')
  const subscribeEmail = document.getElementById('subscribe-email')
  const subscribeBtn = document.getElementById('subscribe-btn')
  const subscribeStatus = document.getElementById('subscribe-status')

  subscribeForm?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = subscribeEmail.value.trim()
    if (!email) return
    subscribeBtn.disabled = true
    subscribeBtn.textContent = 'Sending…'
    subscribeStatus.textContent = 'Subscribing…'
    subscribeStatus.className = 'subscribe-status pending'
    subscribeStatus.hidden = false
    try {
      const resp = await fetch('/.netlify/functions/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      })
      let data = {}
      try {
        data = await resp.json()
      } catch {}
      const msg =
        data.message ||
        (resp.ok ? 'Subscribed!' : 'Something went wrong — please try again shortly.')
      subscribeStatus.textContent = resp.ok ? msg : `${msg} [${resp.status}]`
      subscribeStatus.className = `subscribe-status ${resp.ok ? 'ok' : 'err'}`
      subscribeStatus.hidden = false
      if (resp.ok) {
        subscribeEmail.value = ''
        subscribeForm.style.display = 'none'
      }
    } catch {
      subscribeStatus.textContent = 'Network error — please try again shortly.'
      subscribeStatus.className = 'subscribe-status err'
      subscribeStatus.hidden = false
    } finally {
      subscribeBtn.disabled = false
      subscribeBtn.textContent = 'Notify me'
    }
  })
</script>
