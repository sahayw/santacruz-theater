    color: var(--ink-muted);
    padding: 0 10px 5px 0;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .roles-table td {
    padding: 6px 10px 6px 0;
    border-bottom: 1px solid var(--border);
