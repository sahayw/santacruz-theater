</style>

<script is:inline>
  const TODAY = new Date().toISOString().slice(0, 10)

  const cards = Array.from(document.querySelectorAll('.aud-card'))
  const countEl = document.getElementById('filter-count')
  const filterCompany = document.getElementById('filter-company')
  const filterGenre = document.getElementById('filter-genre')
  const filterWhen = document.getElementById('filter-when')
  const emptyEl = document.getElementById('aud-empty')

  // Mark past cards (drives the Past pip via CSS)
  cards.forEach((card) => {
    if ((card.dataset.latestDate ?? '') < TODAY) card.classList.add('past')
  })

  function updateFilters() {
    const co = filterCompany.value
    const ge = filterGenre.value
    const wh = filterWhen.value
    let visible = 0

    cards.forEach((card) => {
      const matchCo = !co || card.dataset.company === co
      const matchGe = !ge || card.dataset.genre === ge
      const latest = card.dataset.latestDate ?? ''
      const matchWh =
        wh === 'all' ? true : wh === 'past' ? latest < TODAY : /* upcoming */ latest >= TODAY

      const show = matchCo && matchGe && matchWh
      card.style.display = show ? '' : 'none'
      if (show) visible++
    })

    if (countEl) {
      countEl.textContent = `${visible} ${visible === 1 ? 'audition' : 'auditions'}`
    }
    if (emptyEl) {
      emptyEl.hidden = visible > 0
    }
  }

  function openCard(card) {
    const btn = card.querySelector('.aud-summary')
    const detail = card.querySelector('.aud-detail')
    if (!btn || !detail) return
    card.classList.add('open')
    detail.hidden = false
    btn.setAttribute('aria-expanded', 'true')
  }

  // Deep-link: ?id=<timestamp> (prefix "audition-" stripped from URL for brevity)
  const deepId = new URLSearchParams(location.search).get('id')
  const deepCard = deepId
    ? (cards.find((c) => c.dataset.id === 'audition-' + deepId) ?? null)
    : null

  if (deepId && deepCard) {
    // Single-card mode: show only the linked record, no filters
    const titleEl = document.querySelector('.page-title')
    titleEl.textContent = 'Audition'
    titleEl.style.fontSize = '18px'
    document.querySelector('.page-subtitle').style.display = 'none'
    document.querySelector('.filter-bar').style.display = 'none'
    cards.forEach((c) => {
      if (c !== deepCard) c.style.display = 'none'
    })
    openCard(deepCard)
    // Re-enable the Auditions nav link so it navigates back to the full list
    const audNav = document.querySelector('a.nav-link--active[href="/auditions"]')
    if (audNav) audNav.style.pointerEvents = 'auto'
  } else if (deepId) {
    // Unrecognised id — show error, suppress list and filters
    document.querySelector('.filter-bar').style.display = 'none'
    document.getElementById('aud-list')?.style.setProperty('display', 'none')
    const notFound = document.getElementById('aud-not-found')
    notFound.textContent = `audition-${deepId} not found`
    notFound.hidden = false
    const audNav = document.querySelector('a.nav-link--active[href="/auditions"]')
    if (audNav) audNav.style.pointerEvents = 'auto'
  } else {
    // Normal list mode
    filterWhen.value = 'upcoming'
    updateFilters()
    filterCompany?.addEventListener('change', updateFilters)
    filterGenre?.addEventListener('change', updateFilters)
    filterWhen?.addEventListener('change', updateFilters)
  }

  // Expand / collapse
  document.querySelectorAll('.aud-summary').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.aud-card')
      const detail = card?.querySelector('.aud-detail')
      if (!card || !detail) return
      const isOpen = card.classList.toggle('open')
      detail.hidden = !isOpen
      btn.setAttribute('aria-expanded', String(isOpen))
    })
  })
</script>
