<style>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: #f0ede8;
    color: #1a1612;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .stub-page {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 44px 24px 64px;
    margin-top: 44px;
  }

  .stub-card {
    background: #fff;
    border: 1px solid #e0d9d0;
    border-radius: 10px;
    padding: 48px 48px 40px;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.07);
  }

  .stub-icon {
    color: #c8a96e;
    margin-bottom: 20px;
    display: flex;
    justify-content: center;
  }

  .stub-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 600;
    color: #1a1612;
    margin-bottom: 12px;
    line-height: 1.15;
  }

  .stub-coming {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 17px;
    font-weight: 400;
    color: #c8a96e;
    margin-bottom: 16px;
    letter-spacing: 0.02em;
  }

  .stub-desc {
    font-size: 14px;
    font-weight: 400;
    color: #6b6259;
    line-height: 1.62;
    margin-bottom: 32px;
  }

  .stub-back {
    display: inline-block;
    padding: 9px 22px;
    border: 1.5px solid #e0d9d0;
    border-radius: 4px;
    color: #6b6259;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    -webkit-tap-highlight-color: transparent;
  }

  .stub-back:hover {
    border-color: #c8a96e;
    color: #1a1612;
    background: #faf7f2;
  }

  @media (max-width: 480px) {
    .stub-card {
      padding: 36px 28px 32px;
    }
    .stub-title {
      font-size: 26px;
    }
  }
</style>
