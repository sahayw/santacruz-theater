---
import CalendarView from '../components/calendar.astro';
import SiteNav from '../components/SiteNav.astro';
import { getPerformances } from '../lib/data.ts';

const performances = await getPerformances();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Calendar — Santa Cruz Theater 2026</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteNav currentPage="calendar" />
    <CalendarView performances={performances} />
  </body>
</html>

<style is:global>
  :root {
    --nav-h: 44px;
  }

  .cal-bar {
    top: var(--nav-h) !important;
  }

  .scroll-col-header {
    top: calc(var(--nav-h) + var(--bar-h)) !important;
  }

  body {
    padding-top: calc(var(--nav-h) + var(--bar-h)) !important;
  }

  body.scroll-mode {
    padding-top: calc(var(--nav-h) + var(--bar-h) + var(--col-header-h)) !important;
  }
</style>
