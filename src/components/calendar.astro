---
import type { PerformanceEvent } from '../types.ts'
import AddToCalendar from './AddToCalendar.astro'
import { companies } from '../lib/data.ts'
import { majors as majorsOf } from '../lib/organizers.ts'

interface Props {
  performances: PerformanceEvent[]
}

const { performances } = Astro.props

// The majors in majorCode order: their colours mark the calendar; everyone else is grey.
// Add to my calendar offers them as checkboxes (numbered selection feeds).
const majors = majorsOf(companies).map((c) => ({
  id: c.id,
  label: c.abvName,
  name: c.name,
  colour: c.colour!,
  code: c.majorCode!
}))
const icsMajors = JSON.stringify(majors.map(({ code, label, name }) => ({ code, label, name })))
---

<div class="cal-bar">
  <!-- Left: switch between the year view and the drill-down (month, or week on phones).
       Middle: step through years / months / weeks. Right: calendar subscription. -->
  <div class="bar-left">
    <button class="back-annual-btn" id="backBtn">← Year</button>
    <button class="list-view-btn" id="drillBtn"
      ><span class="drill-label-month">Month view →</span><span class="drill-label-week"
        >Week view →</span
      ></button
    >
  </div>
  <div class="year-nav">
    <button class="year-step" id="navPrev" aria-label="Previous">‹</button>
    <span class="year-display" id="navLabel"></span>
    <button class="year-step" id="navNext" aria-label="Next">›</button>
  </div>
  <div class="bar-right">
    <button
      class="cal-feed-btn"
      type="button"
      aria-label="Add to my calendar"
      title="Add to my calendar"
      data-ics-majors={icsMajors}
    >
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"
        ><rect x="1.5" y="2.5" width="13" height="12" rx="1.5" fill="none" stroke="currentColor"
        ></rect><path d="M1.5 6h13M5 1v3M11 1v3M8 8v5M5.5 10.5h5" stroke="currentColor" fill="none"
        ></path></svg
      >
      <span class="cal-feed-label">Add to my calendar</span>
    </button>
  </div>
</div>

<div id="annual-view">
  <div style="padding:12px">
    <div class="months-grid" id="monthsGrid"></div>
    <div style="height:24px"></div>
  </div>
</div>

<div id="drill-view"></div>

<div class="fixed-legend-footer" id="fixedLegendFooter"></div>
<div id="hoverPanel" class="day-hover-panel"></div>
<div class="overlay" id="overlay"></div>
<div class="bottom-sheet" id="bottomSheet">
  <div class="sheet-date-header">
    <span id="sheetDateHeader"></span>
    <button class="sheet-close-btn" id="sheetCloseBtn" aria-label="Close">×</button>
  </div>
  <div id="sheetCards"></div>
</div>
<AddToCalendar />

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Serif+Display&family=DM+Sans:wght@300;400;500&display=swap');

  :root {
    --page-bg: #f0ede8;
    --bg: #f7f4ef;
    --surface: #ffffff;
    --ink: #1a1612;
    --ink-muted: #6b6259;
    --border: #e0d9d0;
    --month-header-bg: #fffcf2;
    --card-description-lines: 4;
    --radius: 6px;
    --bar-h: 32px;
    --footer-h: 48px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--page-bg);
    color: var(--ink);
    min-height: 100vh;
    font-size: 14px;
    padding-top: var(--bar-h);
  }

  /* ── UNIFIED CAL BAR ── */
  .cal-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 110;
    height: var(--bar-h);
    background: var(--bar-bg);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 20px;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }

  /* View-switch buttons — each shown only in the opposite mode */
  .bar-left {
    grid-column: 1;
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .bar-right {
    grid-column: 3;
    justify-self: end;
  }
  .back-annual-btn,
  .list-view-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.65);
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 400;
    cursor: pointer;
    padding: 4px 8px 4px 0;
    white-space: nowrap;
    display: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.14s;
  }
  .back-annual-btn:hover,
  .list-view-btn:hover {
    color: #fff;
  }
  body.drill-mode .back-annual-btn {
    display: block;
  }
  body.annual-mode .list-view-btn {
    display: block;
  }

  /* Year navigator */
  .year-nav {
    grid-column: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }
  .year-display {
    font-family: 'DM Serif Display', serif;
    font-size: 18px;
    color: #fff;
    letter-spacing: 0.01em;
    min-width: 48px;
    text-align: center;
  }
  .year-step {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.65);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    padding: 4px 6px;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.14s;
  }
  .year-step:hover {
    color: #fff;
  }
  .year-step.dimmed {
    opacity: 0.3;
  }
  .year-step.hidden {
    visibility: hidden;
  }

  body.drill-mode {
    padding-bottom: calc(var(--footer-h) + 8px);
  }
  body.annual-mode {
    padding-bottom: calc(var(--footer-h) + 8px);
  }

  /* ── ANNUAL VIEW ── */
  #annual-view {
    padding: 2px;
    max-width: 960px;
    margin: 0 auto;
    background: var(--bg);
  }
  .months-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  /* Use 4 columns when in landscape mode (on tablet) but 3 when in portrait mode to optimize screen use. */
  @media (min-aspect-ratio: 1/1) {
    .months-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 480px) {
    .months-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .month-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: box-shadow 0.15s;
  }
  .month-block:active {
    opacity: 0.8;
  }
  .month-name {
    font-family: 'DM Serif Display', serif;
    font-size: 13px;
    font-weight: 400;
    padding: 4px 6px 3px;
    border-bottom: 1px solid var(--border);
    letter-spacing: 0.02em;
  }
  .mini-cal {
    padding: 1px;
  }
  .mini-cal-head {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    margin-bottom: 1px;
  }
  .mini-cal-head span {
    text-align: center;
    font-size: 10px;
    font-weight: 500;
    color: var(--ink-muted);
  }
  .mini-cal-body {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    width: 100%;
  }
  .mini-day {
    min-width: 0;
    height: 22px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: var(--ink-muted);
  }
  .mini-day.has-perf {
    color: rgba(0, 0, 0, 0.75);
    font-weight: 600;
    cursor: pointer;
  }
  @media (hover: hover) {
    .mini-day.has-perf:hover {
      filter: brightness(0.88);
    }
  }
  .mini-day.empty {
    opacity: 0;
  }

  /* ── LEGEND ── */
  .legend {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 10px 14px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  .legend-title {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-muted);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
  }
  .legend-dot {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  /* ── FIXED FOOTER LEGEND ── */
  .fixed-legend-footer {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 108;
    background: var(--surface);
    border-top: 1px solid var(--border);
    min-height: var(--footer-h);
    padding: 8px 14px;
    padding-bottom: max(8px, env(safe-area-inset-bottom, 8px));
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }
  .fixed-legend-footer.visible {
    display: flex;
  }
  .fixed-legend-footer .legend-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .fixed-legend-footer .legend-item {
    font-size: 11px;
    white-space: nowrap;
    flex-shrink: 0;
    gap: 4px;
  }
  .fixed-legend-footer .legend-dot {
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }

  /* ── BOTTOM SHEET ── */
  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 200;
  }
  .overlay.open {
    display: block;
  }
  .bottom-sheet {
    position: fixed;
    bottom: 0;
    left: 50%;
    width: 100%;
    max-width: 500px;
    background: var(--surface);
    border-radius: 16px 16px 0 0;
    z-index: 201;
    max-height: 80vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transform: translateX(-50%) translateY(100%);
    -webkit-transform: translateX(-50%) translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding-bottom: env(safe-area-inset-bottom, 16px);
  }
  .bottom-sheet.open {
    transform: translateX(-50%) translateY(0);
    -webkit-transform: translateX(-50%) translateY(0);
  }
  .sheet-date-header {
    display: flex;
    align-items: center;
    padding: 12px 12px 8px 20px;
    border-bottom: 1px solid var(--border);
  }
  .sheet-date-header span {
    font-family: 'DM Serif Display', serif;
    font-size: 16px;
    font-weight: 400;
    flex: 1;
  }
  .sheet-close-btn {
    background: none;
    border: none;
    font-size: 22px;
    line-height: 1;
    color: var(--ink-muted);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .sheet-close-btn:hover {
    color: var(--ink);
    background: rgba(0, 0, 0, 0.05);
  }
  .perf-card {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
  }
  .perf-card:last-child {
    border-bottom: none;
  }
  .perf-card-company {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }
  .company-badge {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .company-name {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .perf-type-tag {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 10px;
    background: #f0ece6;
    color: var(--ink-muted);
    margin-left: auto;
  }
  .perf-type-tag[data-type='Preview'] {
    background: #fff0cc;
    color: #7a5200;
  }
  .perf-type-tag[data-type='Opening'] {
    background: #c8f0da;
    color: #1a5c35;
  }
  .perf-type-tag[data-type='Closing'] {
    background: #ffd4d4;
    color: #8c1e1e;
  }
  .perf-type-tag[data-type='Talk-back'] {
    background: #d4ddff;
    color: #2035a0;
  }
  .card-show-title {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .card-description {
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-muted);
    white-space: pre-wrap;
  }
  .card-description-wrap {
    position: relative;
    margin-bottom: 10px;
  }
  .card-description.clamped {
    max-height: calc(1.5em * var(--card-description-lines));
    overflow: hidden;
  }
  .card-description strong {
    color: var(--ink);
  }
  .card-description em {
    font-style: italic;
  }
  .card-description-more {
    display: none;
    position: absolute;
    right: 0;
    bottom: 0;
    align-items: baseline;
    gap: 0.2em;
    padding: 0 0 0 10px;
    border: none;
    background: var(--surface);
    font: inherit;
    font-size: 13px;
    line-height: 1.5;
    font-weight: 600;
    cursor: pointer;
    z-index: 2;
  }
  .card-description-more.visible {
    display: inline-flex;
  }
  .card-description-more-ellipsis {
    color: var(--ink-muted);
    font-weight: 400;
  }
  .card-description-more-label {
    color: #4f5ce0;
  }
  .card-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 12px;
    font-size: 12px;
    color: var(--ink-muted);
    margin-bottom: 10px;
  }
  .card-meta-item {
    display: flex;
    gap: 4px;
  }
  .card-meta-label {
    font-weight: 500;
    color: var(--ink);
  }
  .card-discounts {
    font-size: 11px;
    color: var(--ink-muted);
    margin-bottom: 10px;
  }
  .card-buttons {
    display: flex;
    gap: 8px;
  }
  .btn-info,
  .btn-tickets {
    flex: 1;
    padding: 9px 12px;
    border-radius: 6px;
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    border: none;
  }
  .btn-info {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--ink);
  }
  .btn-tickets {
    background: var(--ink);
    color: #fff;
  }
  .btn-info[aria-disabled='true'],
  .btn-tickets[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }
  .card-run-links {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
  }
  .card-run-links a,
  .card-run-links button {
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    color: #4f5ce0;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .card-run-links a:hover,
  .card-run-links button:hover {
    text-decoration: underline;
  }

  ::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 2px;
  }

  /* ── ANNUAL VIEW HOVER PANEL ── */
  .day-hover-panel {
    display: none;
    position: fixed;
    z-index: 300;
    width: 240px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    pointer-events: none;
  }
  .day-hover-panel.visible {
    display: block;
  }
  .hover-panel-header {
    font-family: 'DM Serif Display', serif;
    font-size: 13px;
    font-weight: 400;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
  }
  .hover-panel-row {
    padding: 6px 12px;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hover-panel-row:last-child {
    border-bottom: none;
  }
  .hover-panel-show {
    font-size: 12px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .hover-panel-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .hover-panel-meta {
    font-size: 11px;
    color: var(--ink-muted);
    padding-left: 14px;
  }

  /* ── ADD TO MY CALENDAR (bar) — drill-down only: the year view doesn't show what you'd
     subscribe to; icon-only on narrow screens ── */
  .cal-feed-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.8);
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    padding: 4px 8px;
    cursor: pointer;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) {
    .cal-feed-btn:hover {
      background: rgba(255, 255, 255, 0.18);
      border-color: rgba(255, 255, 255, 0.35);
      color: #fff;
    }
  }
  body:not(.drill-mode) .cal-feed-btn {
    display: none;
  }
  .drill-label-week {
    display: none;
  }
  @media (max-width: 640px) {
    .cal-feed-label,
    .drill-label-month {
      display: none;
    }
    .drill-label-week {
      display: inline;
    }
  }

  /* ── YEAR VIEW SQUARES: one per major performing, grey for anyone else ── */
  .mini-day {
    flex-direction: column;
    gap: 1px;
    height: 26px;
  }
  .mini-day .sqs {
    display: flex;
    gap: 1px;
    height: 5px;
  }
  .mini-day .sqs span {
    width: 5px;
    height: 5px;
    border-radius: 1px;
  }
  .mini-day.has-perf {
    background: #f6f1e8;
  }
  .mini-day.today .mini-num {
    text-decoration: underline;
  }
  @media (max-width: 480px) {
    .mini-day .sqs span {
      width: 4px;
      height: 4px;
    }
  }

  /* ── DRILL-DOWN: month grid (wider screens) / one week (phones) ── */
  #drill-view {
    display: none;
    max-width: 1100px;
    margin: 0 auto;
    padding: 10px;
  }
  body.drill-mode #drill-view {
    display: block;
  }
  body.drill-mode #annual-view {
    display: none;
  }
  .mv-grid,
  .wv-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .mv-dow,
  .wv-dow {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-muted);
    padding: 6px;
    background: var(--month-header-bg);
    border-bottom: 1px solid var(--border);
  }
  .mv-cell,
  .wv-cell {
    border-right: 1px solid #f1ece5;
    border-bottom: 1px solid #f1ece5;
    padding: 3px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .mv-cell {
    min-height: 92px;
  }
  .wv-cell {
    min-height: 60px; /* only as tall as the day with most performances */
    padding: 3px 1px 12px;
  }
  .mv-cell:nth-child(7n),
  .wv-cell:nth-child(7n) {
    border-right: 0;
  }
  .mv-cell.focus,
  .wv-cell.focus {
    background: #fff6e0;
  }
  /* Day number strip across the top of each day; tinted for the neighbouring months' days */
  .day-strip {
    margin: -3px -3px 1px;
    padding: 2px 2px 1px;
  }
  .wv-cell .day-strip {
    margin: -3px -1px 1px;
  }
  .mv-cell:not(.in-month) .day-strip {
    background: #faf4e6;
    border-bottom: 1px solid #f1ece5;
  }
  .day-num-btn {
    align-self: flex-start;
    font: inherit;
    font-size: 11px;
    color: var(--ink-muted);
    background: none;
    border: 0;
    border-radius: 3px;
    padding: 0 3px;
    cursor: pointer;
  }
  .day-num-btn:disabled {
    cursor: default;
  }
  .day-num-btn.today {
    background: var(--ink);
    color: #fff;
  }
  .cal-entry {
    display: block;
    width: 100%;
    text-align: left;
    font: inherit;
    font-size: 11px;
    line-height: 1.25;
    color: var(--ink);
    padding: 2px 5px;
    border: 0;
    border-left: 3px solid;
    border-radius: 2px;
    background: #faf8f4;
    cursor: pointer;
    overflow-wrap: anywhere;
    -webkit-tap-highlight-color: transparent;
  }
  .cal-entry b {
    font-weight: 600;
  }
  .cal-entry .org {
    font-size: 10px;
    color: var(--ink-muted);
  }
  @media (hover: hover) {
    .cal-entry:hover {
      background: #f1ebe0;
    }
    .day-num-btn:not(:disabled):hover {
      background: rgba(180, 120, 40, 0.18);
    }
  }
  .wv-grid .cal-entry {
    font-size: 9px;
    padding: 2px 2px;
    border-left-width: 2px;
  }
  .wv-grid .cal-entry .org {
    font-size: 8px;
  }
  .wv-dow {
    padding: 6px 2px;
    text-align: center;
  }
</style>

<script define:vars={{ performances, majors }} is:inline>
  // Year view: each day shows one square per major performing (in majorCode order), then
  // a grey square if anyone else is. Drill-down: a month grid on wider screens, one week at
  // a time on phones. Entries read "time · show · organizer" with the main organizer's
  // colour (grey for non-majors). See docs/notifications-spec.md.
  const PERFORMANCES = performances
  const renderMdPromise = import('/admin/audition-format.js').then((module) => module.renderMd)
  const CARD_DESCRIPTION_LINES = 4
  const OTHER_COLOUR = '#b9b0a4'
  const MAJOR_IDS = new Set(majors.map((m) => m.id))
  const MAJOR_COLOUR = Object.fromEntries(majors.map((m) => [m.id, m.colour]))
  const MONTHS = [
    'January',
    'February',
    'March',
    'April',
    'May',
    'June',
    'July',
    'August',
    'September',
    'October',
    'November',
    'December'
  ]
  const DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
  const EARLIEST_YEAR = 2026
  const PHONE = window.matchMedia('(max-width: 640px)')

  // Today in Santa Cruz — the same date as todayIso() in src/lib/data-rules.ts
  const TODAY = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Los_Angeles' })
  const today = parseDate(TODAY)
  let displayYear = Math.max(EARLIEST_YEAR, today.getFullYear())
  let mode = 'annual' // 'annual' | 'drill'
  let drillAnchor = new Date(today) // the drill-down shows the month/week containing this
  let focusDate = null // day picked in the year view, highlighted in the drill-down

  const byDate = {}
  PERFORMANCES.forEach((p) => (byDate[p.date] = byDate[p.date] || []).push(p))
  Object.values(byDate).forEach((list) => list.sort((a, b) => a.time.localeCompare(b.time)))

  // ── Helpers ──
  function dowMon(d) {
    return (d.getDay() + 6) % 7
  }
  function fmtDate(d) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
  }
  function parseDate(ds) {
    const [y, m, d] = ds.split('-').map(Number)
    return new Date(y, m - 1, d)
  }
  function addDays(d, n) {
    const r = new Date(d)
    r.setDate(r.getDate() + n)
    return r
  }
  function mondayOf(d) {
    return addDays(d, -dowMon(d))
  }
  function fmtTime(t) {
    const [hStr, mStr] = (t || '').replace('.', ':').split(':')
    const h = Number(hStr)
    const m = mStr !== undefined ? Number(mStr) : 0
    const period = h < 12 ? 'am' : 'pm'
    const h12 = h % 12 || 12
    return m === 0 ? `${h12}${period}` : `${h12}:${String(m).padStart(2, '0')}${period}`
  }
  function esc(s) {
    return String(s ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/"/g, '&quot;')
  }
  /** The main organizer's colour if it's a major, else grey. */
  function entryColour(p) {
    return MAJOR_COLOUR[p.organizers[0]] || OTHER_COLOUR
  }
  /** Squares for a day: each major involved (majorCode order), then grey for anyone else. */
  function daySquares(perfs) {
    const colours = majors
      .filter((m) => perfs.some((p) => p.organizers.includes(m.id)))
      .map((m) => m.colour)
    if (perfs.some((p) => p.organizers.some((o) => !MAJOR_IDS.has(o)))) colours.push(OTHER_COLOUR)
    return colours
  }

  // ── Bar ──
  function updateNav() {
    const label = document.getElementById('navLabel')
    const prev = document.getElementById('navPrev')
    const next = document.getElementById('navNext')
    prev.classList.remove('hidden')
    next.classList.remove('dimmed')
    if (mode === 'annual') {
      label.textContent = displayYear
      prev.classList.toggle('hidden', displayYear <= EARLIEST_YEAR)
      const hasNext = PERFORMANCES.some((p) => p.date.startsWith(String(displayYear + 1)))
      next.classList.toggle('dimmed', !hasNext)
    } else if (PHONE.matches) {
      const start = mondayOf(drillAnchor)
      const end = addDays(start, 6)
      const fmt = (d) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
      label.textContent =
        start.getMonth() === end.getMonth()
          ? `${fmt(start)} – ${end.getDate()}`
          : `${fmt(start)} – ${fmt(end)}`
    } else {
      label.textContent = `${MONTHS[drillAnchor.getMonth()]} ${drillAnchor.getFullYear()}`
    }
  }

  // ── Hover panel (year view, mouse only) ──
  function showHoverPanel(ds, perfs, cellEl) {
    const panel = document.getElementById('hoverPanel')
    const dateLabel = parseDate(ds).toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric'
    })
    let html = `<div class="hover-panel-header">${dateLabel}</div>`
    perfs.forEach((p) => {
      html += `<div class="hover-panel-row">
        <div class="hover-panel-show">
          <div class="hover-panel-dot" style="background:${entryColour(p)}"></div>
          <span>${esc(p.organizerLabel)} · ${esc(p.showAbv)}</span>
        </div>
        <div class="hover-panel-meta">${fmtTime(p.time)} · ${esc(p.venue)}</div>
      </div>`
    })
    panel.innerHTML = html
    const rect = cellEl.getBoundingClientRect()
    const pw = 240
    const ph = 34 + perfs.length * 46
    let left = rect.left
    let top = rect.bottom + 6
    if (left + pw > window.innerWidth - 8) left = Math.max(8, rect.right - pw)
    if (top + ph > window.innerHeight - 8) top = rect.top - ph - 6
    panel.style.left = Math.max(8, left) + 'px'
    panel.style.top = Math.max(8, top) + 'px'
    panel.classList.add('visible')
  }
  function hideHoverPanel() {
    document.getElementById('hoverPanel').classList.remove('visible')
  }

  // ── Legend ──
  function buildFooter() {
    const footer = document.getElementById('fixedLegendFooter')
    footer.innerHTML =
      '<span class="legend-title">COMPANIES</span>' +
      [...majors.map((m) => [m.colour, m.name]), [OTHER_COLOUR, 'Other']]
        .map(
          ([colour, label]) =>
            `<div class="legend-item"><div class="legend-dot" style="background:${colour}"></div><span>${esc(label)}</span></div>`
        )
        .join('')
  }

  // ── Year view ──
  function renderAnnual() {
    const grid = document.getElementById('monthsGrid')
    grid.innerHTML = ''
    for (let m = 0; m < 12; m++) {
      const block = document.createElement('div')
      block.className = 'month-block'
      block.dataset.month = String(m)
      block.innerHTML = `<div class="month-name">${MONTHS[m]}</div>`
      const cal = document.createElement('div')
      cal.className = 'mini-cal'
      cal.innerHTML = `<div class="mini-cal-head">${DOW.map((d) => `<span>${d[0]}</span>`).join('')}</div>`
      const body = document.createElement('div')
      body.className = 'mini-cal-body'
      const startDow = dowMon(new Date(displayYear, m, 1))
      const daysInMonth = new Date(displayYear, m + 1, 0).getDate()
      for (let i = 0; i < startDow; i++)
        body.insertAdjacentHTML('beforeend', '<div class="mini-day empty"></div>')
      for (let d = 1; d <= daysInMonth; d++) {
        const ds = fmtDate(new Date(displayYear, m, d))
        const perfs = byDate[ds] || []
        const el = document.createElement('div')
        el.className = 'mini-day' + (ds === TODAY ? ' today' : '')
        el.innerHTML = `<span class="mini-num">${d}</span>`
        if (perfs.length) {
          el.classList.add('has-perf')
          el.insertAdjacentHTML(
            'beforeend',
            `<span class="sqs">${daySquares(perfs)
              .map((c) => `<span style="background:${c}"></span>`)
              .join('')}</span>`
          )
          el.addEventListener('pointerenter', (e) => {
            if (e.pointerType === 'mouse') showHoverPanel(ds, perfs, el)
          })
          el.addEventListener('pointerleave', (e) => {
            if (e.pointerType === 'mouse') hideHoverPanel()
          })
          el.addEventListener('click', (e) => {
            e.stopPropagation()
            openDrill(parseDate(ds), ds)
          })
        }
        body.appendChild(el)
      }
      cal.appendChild(body)
      block.appendChild(cal)
      block.addEventListener('click', () => openDrill(new Date(displayYear, m, 1)))
      grid.appendChild(block)
    }
  }

  /** On phones the year view opens at the current month, not January. */
  function scrollYearToCurrentMonth() {
    if (!PHONE.matches || displayYear !== today.getFullYear()) return
    const block = document.querySelector(`.month-block[data-month="${today.getMonth()}"]`)
    if (!block) return
    const chrome =
      (parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 0) +
      (parseInt(getComputedStyle(document.documentElement).getPropertyValue('--bar-h')) || 32)
    window.scrollTo(0, Math.max(0, block.getBoundingClientRect().top + window.scrollY - chrome - 8))
  }

  // ── Drill-down ──
  function entryHtml(p) {
    return `<button type="button" class="cal-entry" style="border-left-color:${entryColour(p)}" data-date="${p.date}" data-run="${esc(p.runId)}" title="${esc(p.show)} — ${esc(p.organizerName)}">
      <b>${fmtTime(p.time)}</b> ${esc(p.showAbv)} <span class="org">· ${esc(p.organizerLabel)}</span>
    </button>`
  }

  function dayCellHtml(day, cls, label) {
    const ds = fmtDate(day)
    const perfs = byDate[ds] || []
    const classes = [cls]
    if (ds === focusDate) classes.push('focus')
    if (perfs.length) classes.push('has-perf')
    const num = `<div class="day-strip"><button type="button" class="day-num-btn${ds === TODAY ? ' today' : ''}" data-day="${ds}" ${perfs.length ? '' : 'disabled'}>${label}</button></div>`
    return `<div class="${classes.join(' ')}">${num}${perfs.map(entryHtml).join('')}</div>`
  }

  /** Wider screens: the month as a grid, with days from the months either side filled in (shown the same; their 1st is labelled with its month). */
  function renderMonth() {
    const y = drillAnchor.getFullYear()
    const m = drillAnchor.getMonth()
    const first = new Date(y, m, 1)
    const start = mondayOf(first)
    const last = new Date(y, m + 1, 0)
    const end = addDays(mondayOf(last), 6)
    let html = DOW.map((d) => `<div class="mv-dow">${d}</div>`).join('')
    for (let d = start; d <= end; d = addDays(d, 1)) {
      const label = d.getDate() === 1 ? `${MONTHS[d.getMonth()].slice(0, 3)} 1` : d.getDate()
      // The neighbouring months' days get a tinted number strip; the month's own don't
      html += dayCellHtml(d, d.getMonth() === m ? 'mv-cell in-month' : 'mv-cell', label)
    }
    return `<div class="mv-grid">${html}</div>`
  }

  /** Phones: one week at a time, a column per day. */
  function renderWeek() {
    const start = mondayOf(drillAnchor)
    let head = ''
    let cells = ''
    for (let i = 0; i < 7; i++) {
      const d = addDays(start, i)
      head += `<div class="wv-dow">${DOW[i]}</div>`
      cells += dayCellHtml(d, 'wv-cell', d.getDate())
    }
    return `<div class="wv-grid">${head}${cells}</div>`
  }

  function renderDrill() {
    document.getElementById('drill-view').innerHTML = PHONE.matches ? renderWeek() : renderMonth()
    updateNav()
  }

  function openDrill(anchor, ds = null) {
    hideHoverPanel()
    drillAnchor = anchor
    focusDate = ds
    mode = 'drill'
    document.body.classList.remove('annual-mode')
    document.body.classList.add('drill-mode')
    renderDrill()
    window.scrollTo(0, 0)
  }

  function showAnnual() {
    mode = 'annual'
    displayYear = Math.max(EARLIEST_YEAR, drillAnchor.getFullYear())
    document.body.classList.remove('drill-mode')
    document.body.classList.add('annual-mode')
    renderAnnual()
    updateNav()
    window.scrollTo(0, 0)
  }

  function step(dir) {
    if (mode === 'annual') {
      if (dir < 0 && displayYear <= EARLIEST_YEAR) return
      displayYear += dir
      renderAnnual()
      updateNav()
      return
    }
    focusDate = null
    if (PHONE.matches) drillAnchor = addDays(drillAnchor, 7 * dir)
    else drillAnchor = new Date(drillAnchor.getFullYear(), drillAnchor.getMonth() + dir, 1)
    renderDrill()
  }

  // ── Performance card (bottom sheet) ──
  function updateCardDescriptionButtons(root) {
    root.querySelectorAll('.card-description').forEach((descEl) => {
      const wrapper = descEl.parentElement
      const button = wrapper?.querySelector('.card-description-more')
      if (!button) return
      descEl.classList.remove('clamped')
      wrapper?.classList.remove('truncated')
      button.classList.remove('visible')
      const exceedsClamp =
        descEl.scrollHeight >
        Math.ceil(parseFloat(getComputedStyle(descEl).lineHeight) * CARD_DESCRIPTION_LINES) + 1
      if (exceedsClamp) {
        descEl.classList.add('clamped')
        wrapper?.classList.add('truncated')
        button.classList.add('visible')
      }
    })
  }

  async function openSheet(dateStr, runId = null) {
    const renderMd = await renderMdPromise
    let perfs = byDate[dateStr] || []
    if (runId) perfs = perfs.filter((p) => p.runId === runId)
    if (!perfs.length) return
    document.getElementById('sheetDateHeader').textContent = parseDate(dateStr).toLocaleDateString(
      'en-US',
      { weekday: 'long', month: 'long', day: 'numeric' }
    )
    const cards = document.getElementById('sheetCards')
    cards.innerHTML = ''
    let previousRunId = null
    perfs.forEach((p) => {
      const card = document.createElement('div')
      card.className = 'perf-card'
      // The production's description lives here (once per production in the list)
      const description = (p.description || '').trimEnd()
      const showDescription = description && previousRunId !== p.runId
      card.innerHTML = `
      <div class="perf-card-company">
        <div class="company-badge" style="background:${entryColour(p)}"></div>
        <span class="company-name">${esc(p.organizerName)}</span>
        ${p.perfType ? `<span class="perf-type-tag" data-type="${p.perfType}">${p.perfType}</span>` : ''}
      </div>
      <div class="card-show-title">${esc(p.show)}</div>
      ${showDescription ? `<div class="card-description-wrap"><div class="card-description">${renderMd(description)}</div><button type="button" class="card-description-more"><span class="card-description-more-ellipsis">...</span><span class="card-description-more-label">More</span></button></div>` : ''}
      <div class="card-meta">
        <div class="card-meta-item"><span class="card-meta-label">Time&nbsp;</span>${fmtTime(p.time)}</div>
        <div class="card-meta-item"><span class="card-meta-label">Venue&nbsp;</span>${esc(p.venue)}</div>
        ${p.price ? `<div class="card-meta-item"><span class="card-meta-label">Price&nbsp;</span>${esc(p.price)}</div>` : ''}
        ${p.genre.length ? `<div class="card-meta-item"><span class="card-meta-label">Genre&nbsp;</span>${p.genre.join(' / ')}</div>` : ''}
      </div>
      ${p.discounts ? `<div class="card-discounts">Discounts: ${esc(p.discounts)}</div>` : ''}
      <div class="card-buttons">
        ${
          p.infoUrl
            ? `<a class="btn-info" href="${esc(p.infoUrl)}" target="_blank" rel="noopener">More info</a>`
            : `<a class="btn-info" aria-disabled="true">More info</a>`
        }
        ${
          p.ticketsUrl
            ? `<a class="btn-tickets" href="${esc(p.ticketsUrl)}" target="_blank" rel="noopener">Get tickets</a>`
            : `<a class="btn-tickets" aria-disabled="true">Get tickets</a>`
        }
      </div>
      <div class="card-run-links">
        <a href="/productions?id=${p.runId.replace(/^run-/, '')}">All dates →</a>
        <button type="button" data-ics-event="performances/${p.id.replace(/^perf-/, '')}">Add to my calendar</button>
      </div>`
      cards.appendChild(card)
      const descEl = card.querySelector('.card-description')
      const moreBtn = card.querySelector('.card-description-more')
      if (descEl && moreBtn) {
        moreBtn.addEventListener('click', () => {
          descEl.classList.remove('clamped')
          descEl.parentElement?.classList.remove('truncated')
          moreBtn.remove()
        })
      }
      previousRunId = p.runId
    })
    document.getElementById('overlay').classList.add('open')
    document.getElementById('bottomSheet').classList.add('open')
    document.documentElement.style.overflow = 'hidden'
    requestAnimationFrame(() => updateCardDescriptionButtons(cards))
  }

  function closeSheet() {
    document.getElementById('overlay').classList.remove('open')
    document.getElementById('bottomSheet').classList.remove('open')
    document.documentElement.style.overflow = ''
  }

  // ── Wiring ──
  document.getElementById('backBtn').addEventListener('click', showAnnual)
  document
    .getElementById('drillBtn')
    .addEventListener('click', () =>
      openDrill(displayYear === today.getFullYear() ? new Date(today) : new Date(displayYear, 0, 1))
    )
  document.getElementById('navPrev').addEventListener('click', () => step(-1))
  document.getElementById('navNext').addEventListener('click', () => step(1))
  document.getElementById('sheetCloseBtn').addEventListener('click', closeSheet)
  document.getElementById('overlay').addEventListener('click', closeSheet)
  document.getElementById('drill-view').addEventListener('click', (e) => {
    const entry = e.target.closest('.cal-entry')
    if (entry) return openSheet(entry.dataset.date, entry.dataset.run)
    const num = e.target.closest('.day-num-btn')
    if (num && !num.disabled) openSheet(num.dataset.day)
  })
  // Crossing the phone/desktop width switches between the week and month drill-downs
  PHONE.addEventListener('change', () => {
    if (mode === 'drill') renderDrill()
  })
  document.addEventListener('scroll', hideHoverPanel, { passive: true })

  renderAnnual()
  buildFooter()
  updateNav()
  document.body.classList.add('annual-mode')
  document.getElementById('fixedLegendFooter').classList.add('visible')
  const footerEl = document.getElementById('fixedLegendFooter')
  new ResizeObserver(() => {
    document.body.style.paddingBottom = footerEl.offsetHeight + 8 + 'px'
  }).observe(footerEl)
  requestAnimationFrame(scrollYearToCurrentMonth)
</script>
