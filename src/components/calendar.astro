---
import type { PerformanceEvent } from '../types.ts'

interface Props {
  performances: PerformanceEvent[]
}

const { performances } = Astro.props
---

<header class="app-header">
  <button class="back-btn" id="backBtn">&#8592;</button>
  <h1 id="headerTitle">Santa Cruz Theater</h1>
</header>

<div class="filter-bar">
  <label>Company</label>
  <select id="filterCompany">
    <option value="">All</option>
    <option value="SCS">SCS</option>
    <option value="AT">AT</option>
    <option value="MCT">MCT</option>
    <option value="Renegade">Renegade</option>
    <option value="Cabrillo">Cabrillo</option>
  </select>
  <span class="filter-sep">|</span>
  <label>Genre</label>
  <select id="filterGenre">
    <option value="">All</option>
    <option value="Drama">Drama</option>
    <option value="Musical">Musical</option>
    <option value="Comedy">Comedy</option>
    <option value="Tragedy">Tragedy</option>
  </select>
  <span class="filter-sep">|</span>
  <label>Time</label>
  <select id="filterTime">
    <option value="">All</option>
    <option value="Mat">Matinee</option>
    <option value="Eve">Evening</option>
  </select>
</div>

<div class="scroll-col-header" id="scrollColHeader">
  <div class="scroll-col-header-inner">
    <div class="col-head-cell">Shows this week</div>
    <div class="col-head-cell">Mon</div>
    <div class="col-head-cell">Tue</div>
    <div class="col-head-cell">Wed</div>
    <div class="col-head-cell">Thu</div>
    <div class="col-head-cell">Fri</div>
    <div class="col-head-cell">Sat</div>
    <div class="col-head-cell">Sun</div>
  </div>
</div>

<div id="annual-view">
  <div style="padding:12px">
    <div class="year-title">2026</div>
    <div class="months-grid" id="monthsGrid"></div>
    <div style="height:24px"></div>
  </div>
</div>

<div id="scroll-view">
  <div id="scroll-weeks"></div>
  <div style="height:24px"></div>
</div>

<div class="fixed-legend-footer" id="fixedLegendFooter"></div>
<div id="hoverPanel" class="day-hover-panel"></div>
<div class="overlay" id="overlay"></div>
<div class="bottom-sheet" id="bottomSheet">
  <div class="sheet-date-header">
    <span id="sheetDateHeader"></span>
    <button class="sheet-close-btn" id="sheetCloseBtn" aria-label="Close">×</button>
  </div>
  <div id="sheetCards"></div>
</div>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Serif+Display&family=DM+Sans:wght@300;400;500&display=swap');

  :root {
    --bg: #f7f4ef;
    --surface: #ffffff;
    --ink: #1a1612;
    --ink-muted: #6b6259;
    --border: #e0d9d0;
    /* bar fill colors — style B flat muted tints
       SCS↔AT are near-complementary (rose 7° vs blue 225°) for max small-size contrast.
 */
    --col-scs: #e9c1be; /* Carnation   7°   SCS      */
    --col-at: #afbfee; /* Dusk      225°   AT       */
    --col-mct: #c9e6bf; /* Willow    116°   MCT      */
    --col-renegade: #b7e8ec; /* Verdigris 188°   Renegade */
    --col-other: #e0dcd6; /* warm grey — Cabrillo / ABT / unknown fallback */
    --col-multi: #d4ccc2; /* deeper taupe — annual multi-company days */
    /* legend dot colors — muted accent */
    --dot-scs: #ce8481; /* dusty rose  */
    --dot-at: #7080b8; /* soft indigo */
    --dot-mct: #68c057; /* olive sage  */
    --dot-renegade: #479aac; /* sea teal  */
    --dot-other: #8f8579; /* warm stone  */
    /* fully saturated accent colors — drill-down chip bars and show-card badge */
    --acc-scs: #dc4343; /* vivid red-rose */
    --acc-at: #4064c8; /* vivid blue     */
    --acc-mct: #48ae31; /* vivid leaf green */
    --acc-renegade: #21a4c8; /* vivid sea teal  */
    --acc-other: #8b8076; /* warm stone accent */
    --pip-eve: #2c2c2c;
    --pip-mat: #8a8278;
    --radius: 6px;
    --header-h: 52px;
    --filter-h: 40px;
    --col-header-h: 28px;
    --footer-h: 68px;
    --shows-col-w: clamp(120px, 21vw, 160px);
    --daynum-h: 16px;
    --row-h: 22px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--ink);
    min-height: 100vh;
    font-size: 14px;
    padding-top: calc(var(--header-h) + var(--filter-h));
  }

  /* ── FIXED HEADER ── */
  .app-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 110;
    background: var(--ink);
    color: #fff;
    height: var(--header-h);
    display: flex;
    align-items: center;
    padding: 0 16px;
    gap: 12px;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }
  .app-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: 0.02em;
    flex: 1;
  }
  .back-btn {
    background: none;
    border: none;
    color: #fff;
    font-size: 22px;
    cursor: pointer;
    padding: 4px 8px 4px 0;
    display: none;
    -webkit-tap-highlight-color: transparent;
  }
  .back-btn.visible {
    display: block;
  }

  /* ── FIXED FILTER BAR ── */
  .filter-bar {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    z-index: 109;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    height: var(--filter-h);
    padding: 0 12px;
    display: flex;
    gap: 6px;
    align-items: center;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }
  .filter-bar label {
    font-size: 11px;
    color: var(--ink-muted);
    font-weight: 500;
    white-space: nowrap;
  }
  .filter-bar select {
    font-family: inherit;
    font-size: 12px;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 3px 6px;
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
  }
  .filter-sep {
    color: var(--border);
    margin: 0 2px;
    flex-shrink: 0;
  }

  /* ── FIXED SCROLL-VIEW COLUMN HEADER ── */
  .scroll-col-header {
    display: none;
    position: fixed;
    top: calc(var(--header-h) + var(--filter-h));
    left: 0;
    right: 0;
    z-index: 108;
    background: var(--ink);
    color: #fff;
    height: var(--col-header-h);
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .scroll-col-header.visible {
    display: block;
  }
  .scroll-col-header-inner {
    display: grid;
    grid-template-columns: var(--shows-col-w) repeat(7, 1fr);
    min-width: 440px;
    max-width: 600px;
    margin: 0 auto;
    height: 100%;
  }
  .col-head-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 500;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0 3px;
  }
  .col-head-cell:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    justify-content: flex-start;
    padding-left: 8px;
    border-left: none;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.7);
    background: var(--ink);
  }

  body.scroll-mode {
    padding-top: calc(var(--header-h) + var(--filter-h) + var(--col-header-h));
    padding-bottom: calc(var(--footer-h) + 8px);
  }
  body.annual-mode {
    padding-bottom: calc(var(--footer-h) + 8px);
  }

  /* ── ANNUAL VIEW ── */
  #annual-view {
    padding: 2px;
    max-width: 960px;
    margin: 0 auto;
  }
  .year-title {
    font-family: 'DM Serif Display', serif;
    font-size: 24px;
    font-weight: 400;
    text-align: center;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }
  .months-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  /* Landscape: 4 columns × 3 rows fits all 12 months without scrolling */
  @media (min-aspect-ratio: 1/1) {
    .months-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (max-width: 480px) {
    .months-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .month-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: box-shadow 0.15s;
  }
  .month-block:active {
    opacity: 0.8;
  }
  .month-name {
    font-family: 'DM Serif Display', serif;
    font-size: 13px;
    font-weight: 400;
    padding: 4px 6px 3px;
    border-bottom: 1px solid var(--border);
    letter-spacing: 0.02em;
  }
  .mini-cal {
    padding: 1px;
  }
  .mini-cal-head {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    margin-bottom: 1px;
  }
  .mini-cal-head span {
    text-align: center;
    font-size: 10px;
    font-weight: 500;
    color: var(--ink-muted);
  }
  .mini-cal-body {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    width: 100%;
  }
  .mini-day {
    min-width: 0;
    height: 22px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: var(--ink-muted);
  }
  .mini-day.has-perf {
    color: rgba(0, 0, 0, 0.75);
    font-weight: 600;
    cursor: pointer;
  }
  .mini-day.has-perf.multi {
    background: var(--col-multi) !important;
  }
  .mini-day.has-perf.pip-active {
    filter: brightness(0.8);
    outline: 2px solid rgba(0, 0, 0, 0.2);
    outline-offset: -1px;
  }
  @media (hover: hover) {
    .mini-day.has-perf:hover {
      filter: brightness(0.88);
    }
  }
  .mini-day.empty {
    opacity: 0;
  }

  /* ── LEGEND ── */
  .legend {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 10px 14px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }
  .legend-title {
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-muted);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
  }
  .legend-dot {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  /* ── SCROLL VIEW ── */
  #scroll-view {
    display: none;
    max-width: 600px;
    margin: 0 auto;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .scroll-month-label {
    position: relative;
    z-index: 3;
    padding: 5px 12px 4px;
    font-family: 'DM Serif Display', serif;
    font-size: 15px;
    font-weight: 400;
    color: #433c36;
    background: var(--bg);
    letter-spacing: 0.01em;
    border-bottom: 1px solid var(--border);
    will-change: transform;
  }

  .week-table-wrap {
  }

  .week-grid {
    display: grid;
    grid-template-columns: var(--shows-col-w) repeat(7, 1fr);
    border-bottom: 2px solid var(--border);
    min-width: 440px;
    background: var(--surface);
  }

  .shows-col {
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--bg);
    border-right: 2px solid var(--border);
    box-shadow: 2px 0 6px rgba(0, 0, 0, 0.06);
    display: grid;
    padding: 0;
  }
  .shows-col-spacer {
    height: var(--daynum-h);
    border-bottom: 1px solid var(--border);
  }
  .show-chip {
    height: calc(var(--row-h) - 2px);
    margin: 1px 3px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 6px;
    font-size: 12px;
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
  }
  .show-chip-bar {
    width: 4px;
    height: 16px;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .show-chip-name {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .day-col {
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }
  .day-col.other-month {
    background: #e8e4de;
  }
  .day-col.has-perf {
    -webkit-tap-highlight-color: transparent;
  }
  .day-col.has-perf .day-num-row {
    cursor: pointer;
  }
  .day-col.has-perf .day-num-row:active {
    background: rgba(0, 0, 0, 0.06);
  }

  .day-num-row {
    height: var(--daynum-h);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
    background: var(--bg);
  }
  .day-col.other-month .day-num-row {
    background: #e8e4de;
  }
  .day-num {
    font-size: 12px;
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
    color: #433c36;
    line-height: 0;
  }
  .day-num.today {
    background: var(--ink);
    color: #fff;
    border-radius: 50%;
    width: 15px;
    height: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    line-height: 1;
  }

  .pip-row {
    height: var(--row-h);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .pip-row:last-child {
    border-bottom: none;
  }

  .perf-bar {
    position: absolute;
    top: 1px;
    bottom: 1px;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    filter: saturate(0.78) brightness(1.02);
  }
  .perf-bar.bar-single {
    left: 3px;
    right: 3px;
    border-radius: 3px;
  }
  .perf-bar.bar-start {
    left: 3px;
    right: 0;
    border-radius: 3px 0 0 3px;
    border-right: 1px solid rgba(255, 255, 255, 0.5);
  }
  .perf-bar.bar-mid {
    left: -1px;
    right: 0;
    border-radius: 0;
    border-right: 1px solid rgba(255, 255, 255, 0.5);
  }
  .perf-bar.bar-end {
    left: -1px;
    right: 3px;
    border-radius: 0 3px 3px 0;
  }

  .perf-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgba(0, 0, 0, 0.75);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    line-height: 1;
  }

  /* ── FIXED FOOTER LEGEND ── */
  .fixed-legend-footer {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 108;
    background: var(--surface);
    border-top: 1px solid var(--border);
    min-height: var(--footer-h);
    padding: 8px 14px;
    padding-bottom: max(8px, env(safe-area-inset-bottom, 8px));
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
  }
  .fixed-legend-footer.visible {
    display: flex;
  }
  .fixed-legend-footer .legend-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .fixed-legend-footer .legend-item {
    font-size: 11px;
    white-space: nowrap;
    flex-shrink: 0;
    gap: 4px;
  }
  .fixed-legend-footer .legend-dot {
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }

  /* ── BOTTOM SHEET ── */
  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 200;
  }
  .overlay.open {
    display: block;
  }
  .bottom-sheet {
    position: fixed;
    bottom: 0;
    left: 50%;
    width: 100%;
    max-width: 500px;
    background: var(--surface);
    border-radius: 16px 16px 0 0;
    z-index: 201;
    max-height: 80vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transform: translateX(-50%) translateY(100%);
    -webkit-transform: translateX(-50%) translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding-bottom: env(safe-area-inset-bottom, 16px);
  }
  .bottom-sheet.open {
    transform: translateX(-50%) translateY(0);
    -webkit-transform: translateX(-50%) translateY(0);
  }
  .sheet-date-header {
    display: flex;
    align-items: center;
    padding: 12px 12px 8px 20px;
    border-bottom: 1px solid var(--border);
  }
  .sheet-date-header span {
    font-family: 'DM Serif Display', serif;
    font-size: 16px;
    font-weight: 400;
    flex: 1;
  }
  .sheet-close-btn {
    background: none;
    border: none;
    font-size: 22px;
    line-height: 1;
    color: var(--ink-muted);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .sheet-close-btn:hover {
    color: var(--ink);
    background: rgba(0, 0, 0, 0.05);
  }
  .perf-card {
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
  }
  .perf-card:last-child {
    border-bottom: none;
  }
  .perf-card-company {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }
  .company-badge {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .company-name {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .perf-type-tag {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 10px;
    background: #f0ece6;
    color: var(--ink-muted);
    margin-left: auto;
  }
  .perf-type-tag[data-type='Preview'] {
    background: #fff0cc;
    color: #7a5200;
  }
  .perf-type-tag[data-type='Opening'] {
    background: #c8f0da;
    color: #1a5c35;
  }
  .perf-type-tag[data-type='Closing'] {
    background: #ffd4d4;
    color: #8c1e1e;
  }
  .perf-type-tag[data-type='Talk-back'] {
    background: #d4ddff;
    color: #2035a0;
  }
  .card-show-title {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 600;
    margin-bottom: 6px;
    line-height: 1.3;
  }
  .card-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px 12px;
    font-size: 12px;
    color: var(--ink-muted);
    margin-bottom: 10px;
  }
  .card-meta-item {
    display: flex;
    gap: 4px;
  }
  .card-meta-label {
    font-weight: 500;
    color: var(--ink);
  }
  .card-discounts {
    font-size: 11px;
    color: var(--ink-muted);
    margin-bottom: 10px;
  }
  .card-buttons {
    display: flex;
    gap: 8px;
  }
  .btn-info,
  .btn-tickets {
    flex: 1;
    padding: 9px 12px;
    border-radius: 6px;
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    border: none;
  }
  .btn-info {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--ink);
  }
  .btn-tickets {
    background: var(--ink);
    color: #fff;
  }
  .btn-info[aria-disabled='true'],
  .btn-tickets[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  ::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 2px;
  }

  /* ── ANNUAL VIEW HOVER PANEL ── */
  .day-hover-panel {
    display: none;
    position: fixed;
    z-index: 300;
    width: 240px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    pointer-events: none;
  }
  .day-hover-panel.visible {
    display: block;
  }
  .day-hover-panel.touch-mode {
    pointer-events: auto;
    cursor: pointer;
  }
  .hover-panel-header {
    font-family: 'DM Serif Display', serif;
    font-size: 13px;
    font-weight: 400;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
  }
  .hover-panel-row {
    padding: 6px 12px;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hover-panel-row:last-child {
    border-bottom: none;
  }
  .hover-panel-show {
    font-size: 12px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .hover-panel-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .hover-panel-meta {
    font-size: 11px;
    color: var(--ink-muted);
    padding-left: 14px;
  }
  .hover-panel-footer {
    padding: 6px 12px;
    font-size: 11px;
    color: var(--ink-muted);
    border-top: 1px solid var(--border);
    text-align: right;
  }

  /* ── DRILL-DOWN HOVER HIGHLIGHT ── */
  @media (hover: hover) {
    /* Hovering the date cell: highlight it + all bars for that day */
    .day-col.has-perf .day-num-row:hover {
      background: rgba(180, 120, 40, 0.18);
    }
    .day-col.has-perf:has(.day-num-row:hover) .perf-bar {
      filter: saturate(0.6) brightness(0.88);
    }
    /* Hovering a specific bar: highlight only that bar */
    .day-col.has-perf .perf-bar:hover {
      filter: saturate(0.6) brightness(0.88);
    }
  }
</style>

<script define:vars={{ performances }} is:inline>
  const PERFORMANCES = performances
  const TODAY = new Date().toISOString().slice(0, 10)
  const COMPANY_COLORS = {
    SCS: 'var(--col-scs)',
    AT: 'var(--col-at)',
    MCT: 'var(--col-mct)',
    Renegade: 'var(--col-renegade)'
  }
  const COMPANY_NAMES = {
    SCS: 'Santa Cruz Shakespeare',
    AT: "Actors' Theatre",
    MCT: 'Mountain Community Theater',
    Renegade: 'Renegade Theatre',
    Cabrillo: 'Cabrillo Stage'
  }
  const VENUE_NAMES = {
    G: 'The Grove',
    VMB: 'Veterans Memorial Building',
    PH: 'Park Hall',
    AT: "Actors' Theatre",
    CCT: 'Cabrillo Crocker Theater'
  }
  const MONTHS = [
    'January',
    'February',
    'March',
    'April',
    'May',
    'June',
    'July',
    'August',
    'September',
    'October',
    'November',
    'December'
  ]
  const DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']

  let filteredPerfs = [...PERFORMANCES]

  function companyColor(co) {
    return COMPANY_COLORS[co] || 'var(--col-other)'
  }
  const COMPANY_DOTS = {
    SCS: 'var(--dot-scs)',
    AT: 'var(--dot-at)',
    MCT: 'var(--dot-mct)',
    Renegade: 'var(--dot-renegade)'
  }
  function dotColor(co) {
    return COMPANY_DOTS[co] || 'var(--dot-other)'
  }
  const COMPANY_ACCS = {
    SCS: 'var(--acc-scs)',
    AT: 'var(--acc-at)',
    MCT: 'var(--acc-mct)',
    Renegade: 'var(--acc-renegade)'
  }
  function accentColor(co) {
    return COMPANY_ACCS[co] || 'var(--acc-other)'
  }
  function dowMon(d) {
    return (d.getDay() + 6) % 7
  }
  function fmtDate(d) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
  }
  function isMat(t) {
    return parseInt(t) < 17
  }
  function getBarPos(flags, idx) {
    if (!flags || !flags[idx]) return 'none'
    const prev = idx > 0 && flags[idx - 1]
    const next = idx < 6 && flags[idx + 1]
    if (!prev && !next) return 'single'
    if (!prev) return 'start'
    if (!next) return 'end'
    return 'mid'
  }
  function fmtTime(t) {
    const [h, m] = t.split(':').map(Number)
    const period = h < 12 ? 'am' : 'pm'
    const h12 = h % 12 || 12
    return m === 0 ? `${h12}${period}` : `${h12}:${String(m).padStart(2, '0')}${period}`
  }
  let activePanelDate = null
  let activePanelCell = null
  let panelShownAt = 0
  let lastTouchTime = 0
  document.addEventListener(
    'touchstart',
    () => {
      lastTouchTime = Date.now()
    },
    { passive: true, capture: true }
  )

  function showHoverPanel(ds, perfs, cellEl, month, isTouch = false) {
    const panel = document.getElementById('hoverPanel')
    const [y, mo, d] = ds.split('-').map(Number)
    const dateLabel = new Date(y, mo - 1, d).toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric'
    })
    let html = `<div class="hover-panel-header">${dateLabel}</div>`
    const sorted = [...perfs].sort((a, b) => a.time.localeCompare(b.time))
    sorted.forEach((p) => {
      const venue = VENUE_NAMES[p.venue] || p.venue
      html += `<div class="hover-panel-row">
        <div class="hover-panel-show">
          <div class="hover-panel-dot" style="background:${dotColor(p.company)}"></div>
          <span>${p.company} · ${p.showAbv}</span>
        </div>
        <div class="hover-panel-meta">${fmtTime(p.time)} · ${venue}</div>
      </div>`
    })
    if (isTouch) html += `<div class="hover-panel-footer">Tap to view week →</div>`
    panel.innerHTML = html
    const rect = cellEl.getBoundingClientRect()
    const pw = 240
    const ph = 34 + sorted.length * 46 + (isTouch ? 30 : 0)
    let left = rect.left
    let top = rect.bottom + 6
    if (left + pw > window.innerWidth - 8) left = Math.max(8, rect.right - pw)
    if (top + ph > window.innerHeight - 8) top = rect.top - ph - 6
    panel.style.left = Math.max(8, left) + 'px'
    panel.style.top = Math.max(8, top) + 'px'
    activePanelDate = ds
    if (activePanelCell) activePanelCell.classList.remove('pip-active')
    activePanelCell = isTouch ? cellEl : null
    if (isTouch) cellEl.classList.add('pip-active')
    panel.dataset.month = month ?? ''
    panelShownAt = Date.now()
    panel.classList.add('visible')
    if (isTouch) panel.classList.add('touch-mode')
  }
  function hideHoverPanel() {
    const panel = document.getElementById('hoverPanel')
    panel.classList.remove('visible', 'touch-mode')
    activePanelDate = null
    if (activePanelCell) {
      activePanelCell.classList.remove('pip-active')
      activePanelCell = null
    }
  }
  function perfsByDate(perfs) {
    const m = {}
    perfs.forEach((p) => {
      ;(m[p.date] = m[p.date] || []).push(p)
    })
    return m
  }

  function orderedShows(perfs) {
    const seen = new Set()
    const result = []
    ;[...perfs]
      .sort((a, b) => a.date.localeCompare(b.date))
      .forEach((p) => {
        const k = p.showAbv + '|' + p.company
        if (!seen.has(k)) {
          seen.add(k)
          result.push({ showAbv: p.showAbv, company: p.company, show: p.show, key: k })
        }
      })
    return result
  }

  function applyFilters() {
    const co = document.getElementById('filterCompany').value
    const ge = document.getElementById('filterGenre').value
    const ti = document.getElementById('filterTime').value
    filteredPerfs = PERFORMANCES.filter((p) => {
      if (co && p.company !== co) return false
      if (ge && p.genre !== ge) return false
      if (ti === 'Mat' && !isMat(p.time)) return false
      if (ti === 'Eve' && isMat(p.time)) return false
      return true
    })
    renderAnnual()
    buildScrollView()
  }

  const LEGEND_ENTRIES = [
    { color: 'var(--dot-scs)', label: 'Santa Cruz Shakespeare' },
    { color: 'var(--dot-at)', label: "Actors' Theatre" },
    { color: 'var(--dot-mct)', label: 'Mountain Community Theater' },
    { color: 'var(--dot-renegade)', label: 'Renegade Theatre' },
    { color: 'var(--col-multi)', label: 'Multiple companies' }
  ]

  function buildFixedFooter(includeMulti = true) {
    const footer = document.getElementById('fixedLegendFooter')
    footer.innerHTML = ''
    const title = document.createElement('span')
    title.className = 'legend-title'
    title.textContent = 'COMPANIES'
    footer.appendChild(title)
    LEGEND_ENTRIES.forEach((e) => {
      if (!includeMulti && e.label === 'Multiple companies') return
      const item = document.createElement('div')
      item.className = 'legend-item'
      item.style.cssText =
        'display:flex;align-items:center;gap:4px;font-size:11px;white-space:nowrap;'
      item.innerHTML = `<div class="legend-dot" style="background:${e.color};width:11px;height:11px;border-radius:2px;flex-shrink:0"></div><span>${e.label}</span>`
      footer.appendChild(item)
    })
  }

  function renderAnnual() {
    const byDate = perfsByDate(filteredPerfs)
    const grid = document.getElementById('monthsGrid')
    grid.innerHTML = ''
    for (let m = 0; m < 12; m++) {
      const block = document.createElement('div')
      block.className = 'month-block'
      block.onclick = () => goToMonth(m)
      const nameEl = document.createElement('div')
      nameEl.className = 'month-name'
      nameEl.textContent = MONTHS[m]
      block.appendChild(nameEl)
      const cal = document.createElement('div')
      cal.className = 'mini-cal'
      const head = document.createElement('div')
      head.className = 'mini-cal-head'
      DOW.forEach((d) => {
        const s = document.createElement('span')
        s.textContent = d[0]
        head.appendChild(s)
      })
      cal.appendChild(head)
      const body = document.createElement('div')
      body.className = 'mini-cal-body'
      const firstDay = new Date(2026, m, 1)
      const daysInMonth = new Date(2026, m + 1, 0).getDate()
      const startDow = dowMon(firstDay)
      for (let i = 0; i < startDow; i++) {
        const e = document.createElement('div')
        e.className = 'mini-day empty'
        body.appendChild(e)
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const ds = `2026-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`
        const perfs = byDate[ds] || []
        const el = document.createElement('div')
        el.className = 'mini-day'
        el.textContent = d
        if (perfs.length) {
          el.classList.add('has-perf')
          const cos = [...new Set(perfs.map((p) => p.company))]
          if (cos.length > 1) el.classList.add('multi')
          else el.style.background = companyColor(cos[0])
          el.addEventListener('pointerenter', (e) => {
            if (e.pointerType === 'mouse') showHoverPanel(ds, perfs, el, m, false)
          })
          el.addEventListener('pointerleave', (e) => {
            if (e.pointerType === 'mouse') hideHoverPanel()
          })
          el.addEventListener('click', (e) => {
            e.stopPropagation()
            if (Date.now() - lastTouchTime < 500) {
              if (activePanelDate === ds) {
                hideHoverPanel()
                goToMonth(m)
              } else {
                showHoverPanel(ds, perfs, el, m, true)
              }
            } else {
              goToMonth(m)
            }
          })
        }
        body.appendChild(el)
      }
      cal.appendChild(body)
      block.appendChild(cal)
      grid.appendChild(block)
    }
  }

  const monthAnchorIds = {}

  function buildScrollView() {
    const container = document.getElementById('scroll-weeks')
    container.innerHTML = ''
    const byDate = perfsByDate(filteredPerfs)
    const allShows = orderedShows(filteredPerfs)

    let cursor = new Date(2026, 0, 1)
    cursor.setDate(cursor.getDate() - dowMon(cursor))
    const end = new Date(2026, 11, 31)
    let currentMonth = -1

    while (cursor <= end) {
      const weekDays = Array.from({ length: 7 }, (_, i) => {
        const d = new Date(cursor)
        d.setDate(cursor.getDate() + i)
        return d
      })
      const weekMonth = weekDays[3].getMonth()

      if (weekMonth !== currentMonth) {
        currentMonth = weekMonth
        const anchorId = `month-anchor-${currentMonth}`
        monthAnchorIds[currentMonth] = anchorId
        const label = document.createElement('div')
        label.className = 'scroll-month-label'
        label.id = anchorId
        label.textContent = MONTHS[currentMonth]
        container.appendChild(label)
      }

      const weekShowKeys = new Set()
      weekDays.forEach((day) => {
        ;(byDate[fmtDate(day)] || []).forEach((p) => weekShowKeys.add(p.showAbv + '|' + p.company))
      })
      const weekShows = allShows.filter((s) => weekShowKeys.has(s.key))
      const nRows = Math.max(weekShows.length, 1)

      const showDayCoverage = {}
      weekShows.forEach((s) => {
        showDayCoverage[s.key] = weekDays.map((day) => {
          const ds = fmtDate(day)
          return (byDate[ds] || []).some((p) => p.showAbv + '|' + p.company === s.key)
        })
      })

      const wrap = document.createElement('div')
      wrap.className = 'week-table-wrap'

      const grid = document.createElement('div')
      grid.className = 'week-grid'
      grid.style.gridTemplateRows = `var(--daynum-h) repeat(${nRows}, var(--row-h))`

      const showsCol = document.createElement('div')
      showsCol.className = 'shows-col'
      showsCol.style.gridRow = `1 / span ${nRows + 1}`
      const spacer = document.createElement('div')
      spacer.className = 'shows-col-spacer'
      showsCol.appendChild(spacer)
      if (weekShows.length === 0) {
        const empty = document.createElement('div')
        empty.className = 'show-chip'
        empty.innerHTML = '<span style="color:var(--ink-muted);font-size:11px">—</span>'
        showsCol.appendChild(empty)
      } else {
        weekShows.forEach((s) => {
          const chip = document.createElement('div')
          chip.className = 'show-chip'
          chip.innerHTML = `<span class="show-chip-bar" style="background:${accentColor(s.company)}"></span><span class="show-chip-name" title="${s.show}">${s.showAbv}</span>`
          showsCol.appendChild(chip)
        })
      }
      grid.appendChild(showsCol)

      weekDays.forEach((day, dayIdx) => {
        const ds = fmtDate(day)
        const dayPerfs = byDate[ds] || []
        const inYear = day.getFullYear() === 2026
        const inMonth = day.getMonth() === weekMonth

        const col = document.createElement('div')
        col.className =
          'day-col' +
          (!inMonth ? ' other-month' : '') +
          (dayPerfs.length && inYear ? ' has-perf' : '')
        col.style.gridRow = `1 / span ${nRows + 1}`

        const numRow = document.createElement('div')
        numRow.className = 'day-num-row'
        if (dayPerfs.length && inYear) numRow.onclick = () => openSheet(ds)
        if (inYear) {
          const num = document.createElement('div')
          num.className = 'day-num' + (ds === TODAY ? ' today' : '')
          num.textContent = day.getDate()
          numRow.appendChild(num)
        }
        col.appendChild(numRow)

        const dayPipData = {}
        if (inYear) {
          dayPerfs.forEach((p) => {
            const k = p.showAbv + '|' + p.company
            if (!dayPipData[k]) dayPipData[k] = { mat: false, eve: false }
            if (isMat(p.time)) dayPipData[k].mat = true
            else dayPipData[k].eve = true
          })
        }

        const rowsToRender = weekShows.length > 0 ? weekShows : [null]
        rowsToRender.forEach((s) => {
          const pipRow = document.createElement('div')
          pipRow.className = 'pip-row'
          if (s && inYear) {
            const pips = dayPipData[s.key]
            const barPos = getBarPos(showDayCoverage[s.key], dayIdx)
            if (pips && barPos !== 'none') {
              const bar = document.createElement('div')
              bar.className = 'perf-bar bar-' + barPos
              bar.style.background = companyColor(s.company)
              const labelText = pips.mat && pips.eve ? 'Mat / Eve' : pips.mat ? 'Mat' : 'Eve'
              const label = document.createElement('span')
              label.className = 'perf-label'
              label.textContent = labelText
              const matchPerf = dayPerfs.find((p) => p.showAbv + '|' + p.company === s.key)
              const runId = matchPerf ? matchPerf.runId : null
              bar.onclick = (e) => {
                e.stopPropagation()
                openSheet(ds, runId)
              }
              bar.appendChild(label)
              pipRow.appendChild(bar)
            }
          }
          col.appendChild(pipRow)
        })

        grid.appendChild(col)
      })

      wrap.appendChild(grid)
      container.appendChild(wrap)
      cursor.setDate(cursor.getDate() + 7)
    }
  }

  function goToMonth(m) {
    hideHoverPanel()
    document.getElementById('annual-view').style.display = 'none'
    document.getElementById('scroll-view').style.display = 'block'
    document.getElementById('scrollColHeader').classList.add('visible')
    document.getElementById('fixedLegendFooter').classList.add('visible')
    document.getElementById('backBtn').classList.add('visible')
    document.getElementById('headerTitle').textContent = 'Calendar 2026'
    document.body.classList.remove('annual-mode')
    document.body.classList.add('scroll-mode')
    buildFixedFooter(false)
    requestAnimationFrame(() => {
      const sv = document.getElementById('scroll-view')
      sv.scrollLeft = sv.scrollWidth - sv.clientWidth
      const el = document.getElementById(monthAnchorIds[m])
      const totalFixed = 52 + 40 + 28 // header + filter + col-header
      let target = 0
      if (el) {
        let node = el
        while (node) {
          target += node.offsetTop
          node = node.offsetParent
        }
        target -= totalFixed
      }
      window.scrollTo({ top: Math.max(0, target), behavior: 'smooth' })
    })
  }

  function showAnnual() {
    document.getElementById('scroll-view').style.display = 'none'
    document.getElementById('annual-view').style.display = 'block'
    document.getElementById('scrollColHeader').classList.remove('visible')
    document.getElementById('backBtn').classList.remove('visible')
    document.getElementById('headerTitle').textContent = 'Santa Cruz Theater'
    document.body.classList.remove('scroll-mode')
    document.body.classList.add('annual-mode')
    buildFixedFooter(true)
    window.scrollTo(0, 0)
  }

  function openSheet(dateStr, runId = null) {
    let perfs = perfsByDate(filteredPerfs)[dateStr] || []
    if (runId) perfs = perfs.filter((p) => p.runId === runId)
    if (!perfs.length) return
    document.getElementById('sheetDateHeader').textContent = new Date(
      dateStr + 'T12:00:00'
    ).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })
    const cards = document.getElementById('sheetCards')
    cards.innerHTML = ''
    perfs.forEach((p) => {
      const card = document.createElement('div')
      card.className = 'perf-card'
      const [h, min] = p.time.split(':').map(Number)
      const timeStr = `${h > 12 ? h - 12 : h || 12}:${String(min).padStart(2, '0')}${h >= 12 ? 'pm' : 'am'}`
      card.innerHTML = `
      <div class="perf-card-company">
        <div class="company-badge" style="background:${accentColor(p.company)}"></div>
        <span class="company-name">${COMPANY_NAMES[p.company] || p.company}</span>
        ${p.perfType ? `<span class="perf-type-tag" data-type="${p.perfType}">${p.perfType}</span>` : ''}
      </div>
      <div class="card-show-title">${p.show}</div>
      <div class="card-meta">
        <div class="card-meta-item"><span class="card-meta-label">Time&nbsp;</span>${timeStr}</div>
        <div class="card-meta-item"><span class="card-meta-label">Venue&nbsp;</span>${VENUE_NAMES[p.venue] || p.venue}</div>
        <div class="card-meta-item"><span class="card-meta-label">Price&nbsp;</span>${p.price}</div>
        <div class="card-meta-item"><span class="card-meta-label">Genre&nbsp;</span>${p.genre}</div>
      </div>
      ${p.discounts ? `<div class="card-discounts">Discounts: ${p.discounts}</div>` : ''}
      <div class="card-buttons">
        ${
          p.infoUrl
            ? `<a class="btn-info" href="${p.infoUrl}" target="_blank" rel="noopener">More info</a>`
            : `<a class="btn-info" aria-disabled="true">More info</a>`
        }
        ${
          p.ticketsUrl
            ? `<a class="btn-tickets" href="${p.ticketsUrl}" target="_blank" rel="noopener">Get tickets</a>`
            : `<a class="btn-tickets" aria-disabled="true">Get tickets</a>`
        }
      </div>`
      cards.appendChild(card)
    })
    document.getElementById('overlay').classList.add('open')
    document.getElementById('bottomSheet').classList.add('open')
    document.documentElement.style.overflow = 'hidden'
  }

  function closeSheet() {
    document.getElementById('overlay').classList.remove('open')
    document.getElementById('bottomSheet').classList.remove('open')
    document.documentElement.style.overflow = ''
  }

  document.getElementById('backBtn').addEventListener('click', showAnnual)
  document.getElementById('sheetCloseBtn').addEventListener('click', closeSheet)
  document.getElementById('filterCompany').addEventListener('change', applyFilters)
  document.getElementById('filterGenre').addEventListener('change', applyFilters)
  document.getElementById('filterTime').addEventListener('change', applyFilters)
  document.getElementById('overlay').addEventListener('click', closeSheet)

  renderAnnual()
  buildScrollView()
  buildFixedFooter()
  document.getElementById('fixedLegendFooter').classList.add('visible')
  document.body.classList.add('annual-mode')

  const footerEl = document.getElementById('fixedLegendFooter')
  new ResizeObserver(() => {
    document.body.style.paddingBottom = footerEl.offsetHeight + 8 + 'px'
  }).observe(footerEl)

  document.addEventListener('scroll', hideHoverPanel, { passive: true })

  document.getElementById('scroll-view').addEventListener(
    'scroll',
    function () {
      const x = this.scrollLeft
      document.querySelectorAll('.scroll-month-label').forEach((el) => {
        el.style.transform = `translateX(${x}px)`
      })
    },
    { passive: true }
  )

  document.getElementById('hoverPanel').addEventListener('touchend', (e) => {
    if (Date.now() - panelShownAt < 300) return // ghost touchend from the tap that showed the panel
    const m = parseInt(e.currentTarget.dataset.month, 10)
    if (!isNaN(m)) {
      e.preventDefault()
      hideHoverPanel()
      goToMonth(m)
    }
  })

  document.addEventListener('click', (e) => {
    if (activePanelDate && !e.target.closest('#hoverPanel') && !e.target.closest('.mini-day')) {
      hideHoverPanel()
    }
  })

  document.getElementById('scroll-view').addEventListener('scroll', function () {
    document.getElementById('scrollColHeader').scrollLeft = this.scrollLeft
  })
</script>
