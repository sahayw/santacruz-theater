<script>
  document.querySelector('.page')?.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('a')) window.location.href = '/calendar'
  })
</script>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: #120c06;
    color: #1a1612;
    min-height: 100vh;
  }

  /* ── FULL-PAGE WRAPPER ── */
  .page {
    position: relative;
    min-height: calc(100vh - 44px);
    margin-top: 44px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    cursor: pointer;
  }

  .page-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1767811556101-d4dacddc8cb6?auto=format&fit=crop&w=1920&q=80');
    background-size: cover;
    background-position: center top;
  }

  /* Gradient: readable title at top, visible curtain mid, darker at bottom for cards */
  .page-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(18, 12, 6, 0.64) 0%,
      rgba(18, 12, 6, 0.22) 38%,
      rgba(18, 12, 6, 0.8) 100%
    );
  }

  /* ── CONTENT COLUMN ── */
  .page-content {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 20px 32px;
    gap: 0;
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
  }

  /* Flex spacers: top gets 3 parts, middle gets 2, bottom gets 1 */
  .page-content::before,
  .page-content::after {
    content: '';
  }

  .page-content::before { flex: 3; }
  .page-content::after  { flex: 1; }

  .hero-cards-gap {
    flex: 2;
    min-height: 16px;
  }

  /* ── HERO TEXT ── */
  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* min so very short viewports don't squash to zero */
    min-height: 120px;
  }

  .hero-eyebrow {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c8a96e;
    margin-bottom: 10px;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(44px, 7vw, 80px);
    font-weight: 700;
    color: #fff;
    line-height: 1;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
  }

  .hero-tagline {
    font-size: 15px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.02em;
  }

  /* ── SECTION CARDS ── */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    flex-shrink: 0;
    padding: 0 8px 8px;
  }

  .section-card {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #1a1612;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    transition:
      box-shadow 0.2s,
      transform 0.2s;
    -webkit-tap-highlight-color: transparent;
  }

  .section-card:hover {
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.42);
    transform: translateY(-2px);
  }

  .section-card:active {
    transform: translateY(0);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.28);
  }

  .card-accent {
    height: 3px;
    background: #c8a96e;
    flex-shrink: 0;
  }

  .card--soon .card-accent {
    background: #d4ccc2;
  }

  .card-icon {
    padding: 16px 20px 0;
    color: #c8a96e;
    flex-shrink: 0;
  }

  .card--soon .card-icon {
    color: #b5ada4;
  }

  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 19px;
    font-weight: 600;
    padding: 8px 20px 0;
    line-height: 1.2;
    color: #1a1612;
    flex-shrink: 0;
  }

  .card--soon .card-title {
    color: #6b6259;
  }

  .card--sub .card-title {
    font-size: 15px;
  }

  .card-desc {
    font-size: 13px;
    font-weight: 400;
    color: #6b6259;
    padding: 6px 20px 0;
    line-height: 1.58;
    flex: 1;
  }

  .card--sub .card-desc {
    font-size: 12px;
  }

  .card-cta {
    display: block;
    padding: 12px 20px 16px;
    font-size: 12px;
    font-weight: 500;
    color: #c8a96e;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .card-soon-badge {
    display: inline-block;
    margin: 10px 20px 16px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9b9289;
    background: #f5f2ee;
    border-radius: 20px;
    border: 1px solid #e0d9d0;
    align-self: flex-start;
    flex-shrink: 0;
  }

  /* ── WIDE CALENDAR CARD ── */
  .card--wide:hover {
    transform: none;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
  }

  .card--wide {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: center;
  }

  .card--wide .card-accent {
    width: 3px;
    height: auto;
    align-self: stretch;
  }

  .card--wide .card-icon {
    padding: 0 8px 0 16px;
    align-self: center;
  }

  .card--wide .card-main {
    flex: 1;
    padding: 16px 12px;
    min-width: 0;
  }

  .card--wide .card-title {
    padding: 0;
    margin-bottom: 4px;
  }

  .card--wide .card-desc {
    padding: 0;
    flex: unset;
  }

  .card--wide .card-cta {
    padding: 0 20px;
    white-space: nowrap;
  }

  /* ── PHOTO CREDIT ── */
  .photo-credit {
    position: absolute;
    bottom: 8px;
    right: 12px;
    z-index: 3;
    font-size: 10px;
    color: rgba(255, 255, 255, 0.25);
  }

  .photo-credit a {
    color: rgba(255, 255, 255, 0.25);
    text-decoration: none;
  }

  /* ── TABLET (portrait and landscape) ── */
  @media (max-width: 860px) {
    .page-content {
      padding: 16px 24px;
    }
  }

  /* ── PHONE ── */
  @media (max-width: 600px) {
    .page-content {
      padding: 16px 16px 20px;
      max-width: 440px;
    }

    /* Collapse flex spacers on phone — use fixed gaps instead */
    .page-content::before,
    .page-content::after {
      flex: 0;
    }

    .hero-cards-gap {
      flex: 0;
      min-height: 32px;
    }

    .hero-text {
      min-height: 90px;
    }

    .cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .card--wide {
      flex-direction: column;
      align-items: stretch;
    }

    .card--wide .card-accent {
      width: auto;
      height: 3px;
    }

    .card--wide .card-icon {
      padding: 16px 20px 0;
      align-self: auto;
    }

    .card--wide .card-main {
      padding: 8px 20px 0;
    }

    .card--wide .card-cta {
      padding: 12px 20px 16px;
    }

    .card-desc {
      /* Shorten to 2 lines on phone to keep cards compact */
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
