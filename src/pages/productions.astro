---
// Production directory and detail page — /productions lists every run,
// /productions?id=<bare id> shows one with its complete performance schedule, and
// /productions?company=<organizer id> one organizer's productions. Deliberately not in the
// nav or on the home page: /calendar is the browsing surface; this is the stable
// destination for calendar-event page links, the calendar's "All dates" links and email
// links. See docs/ics-spec.md and docs/notifications-spec.md.
import BaseHead from '../components/BaseHead.astro'
import SiteNav from '../components/SiteNav.astro'
import PageBar from '../components/PageBar.astro'
import AddToCalendar from '../components/AddToCalendar.astro'
import { companies, getShows, venues } from '../lib/data.ts'
import { allOrganizers, majors, organizerName, recordOrganizerIds } from '../lib/organizers.ts'
import { runPlace } from '../lib/venues.ts'
import { fmtAudDateRange } from '../lib/audition-format.ts'
import {
  PRODUCTION_VIEW_CSS,
  genrePipHtml,
  recordDetailHtml,
  sortPerformances
} from '../lib/production-view.ts'
import { bareId } from '../lib/calendar-model.ts'
import type { Run } from '../types.ts'

const byDateTime = (a: { date: string; time: string }, b: { date: string; time: string }) =>
  (a.date + a.time).localeCompare(b.date + b.time)

const runs = (await getShows())
  .filter((r) => r.performances.length)
  .map((r) => ({ ...r, performances: sortPerformances(r.performances) }))
  .sort((a, b) => byDateTime(a.performances[0], b.performances[0]))

// ?company= can name any organizer, or "other" (everyone who isn't a major); the names
// and logos let the page header show the selected one.
const majorList = majors(companies)
const organizerNames = JSON.stringify(
  Object.fromEntries(allOrganizers(companies).map((c) => [c.id, c.name]))
)
// Logo and website for the header shown when one organizer is selected
const organizerSites = JSON.stringify(
  Object.fromEntries(
    allOrganizers(companies).map((c) => [
      c.id,
      {
        website: c.website ?? '',
        logo: c.logo ?? '',
        logoBg: c.logoBg ?? '',
        logoDark: !!c.logoDark,
        logoFill: !!c.logoFill
      }
    ])
  )
)
function summaryMeta(r: Run) {
  const name = organizerName(recordOrganizerIds(r.company, r.organizers), companies)
  return [name, runPlace(r, venues)?.name ?? r.venue, r.price].filter(Boolean).join(' · ')
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Productions — Santa Cruz Theater"
      description="Every production on the Santa Cruz Theater calendar, with its full performance schedule."
      canonicalPath="/productions"
    />
  </head>
  <body>
    <SiteNav subscribe={{ list: 'performances', from: 'productions' }} />
    <PageBar title="Productions" />

    <main
      class="runs-page"
      data-majors={majorList.map((c) => c.id).join(' ')}
      data-names={organizerNames}
      data-sites={organizerSites}
    >
      <div class="page-intro">
        <p class="page-subtitle" id="page-subtitle">
          Every production on the <a href="/calendar">calendar</a>, with its full schedule
        </p>
        <span class="page-count" id="filter-count" aria-live="polite"></span>
      </div>

      <div class="run-list" id="run-list">
        {
          runs.map((r) => {
            const lastDate = r.performances.at(-1)!.date
            return (
              <div
                class="run-card"
                data-id={bareId(r.id)}
                data-organizers={recordOrganizerIds(r.company, r.organizers).join(' ')}
                data-latest-date={lastDate}
              >
                <button class="run-summary" aria-expanded="false">
                  <div class="run-main">
                    <div class="run-title-row">
                      <span class="run-title">{r.show}</span>
                      {r.genre.map((g) => (
                        <Fragment set:html={genrePipHtml(g)} />
                      ))}
                    </div>
                    <div class="run-meta-row">{summaryMeta(r)}</div>
                  </div>
                  <div class="run-aside">
                    <span class="run-past-pip" aria-hidden="true">
                      Past
                    </span>
                    <span class="run-date-range">{fmtAudDateRange(r.performances)}</span>
                    <span class="run-chevron" aria-hidden="true" />
                  </div>
                </button>

                <div
                  class="run-detail"
                  hidden
                  set:html={recordDetailHtml(r, { withAdd: true, eventId: bareId })}
                />
              </div>
            )
          })
        }
        <div class="run-empty" id="run-empty" hidden>
          <span id="run-empty-text"></span>
          <button type="button" class="empty-past" id="run-empty-past" hidden>
            Show past productions
          </button>
        </div>
      </div>

      <button type="button" class="past-toggle" id="past-toggle" hidden></button>

      <div class="run-not-found" id="run-not-found" hidden>
        That production isn't listed. <a href="/productions">See all productions</a> or the
        <a href="/calendar">calendar</a>.
      </div>
    </main>

    <AddToCalendar />
  </body>
</html>

<script is:inline>
  // Today in Santa Cruz — the same date as todayIso() in src/lib/data-rules.ts
  const TODAY = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Los_Angeles' })
  const cards = Array.from(document.querySelectorAll('.run-card'))
  const page = document.querySelector('.runs-page')
  const MAJORS = page.dataset.majors.split(' ')
  const NAMES = JSON.parse(page.dataset.names)
  const SITES = JSON.parse(page.dataset.sites)
  const countEl = document.getElementById('filter-count')
  const emptyEl = document.getElementById('run-empty')
  const emptyText = document.getElementById('run-empty-text')
  const emptyPast = document.getElementById('run-empty-past')
  const pastToggle = document.getElementById('past-toggle')
  const subtitleEl = document.getElementById('page-subtitle')
  const DEFAULT_SUBTITLE = subtitleEl.innerHTML

  // ?company=<organizer id> (or "other" for the Other group) and ?show=all (past productions
  // too) come from the address; the company cards on /companies link here.
  const params = new URLSearchParams(location.search)
  const co =
    params.get('company') === 'other' || NAMES[params.get('company')] ? params.get('company') : ''
  let showAll = params.get('show') === 'all'
  // A company's page isn't a calendar page: Subscribe for updates is for the calendars
  if (co) document.querySelector('.nav-cta').style.display = 'none'

  const isPast = (card) => card.dataset.latestDate < TODAY
  cards.forEach((card) => {
    if (isPast(card)) card.classList.add('past')
    // Dim individual past performances in the schedule
    card.querySelectorAll('.perf-row').forEach((row) => {
      if (row.dataset.date < TODAY) row.classList.add('perf-row--past')
    })
  })

  function setOpen(card, open) {
    card.classList.toggle('open', open)
    card.querySelector('.run-detail').hidden = !open
    card.querySelector('.run-summary').setAttribute('aria-expanded', String(open))
  }

  // Company: a major or any other organizer id matches any of a card's organizers; "other"
  // matches a card with any organizer who isn't a major.
  function matchesCompany(card, co) {
    const orgs = card.dataset.organizers.split(' ')
    if (!co) return true
    if (co === 'other') return orgs.some((o) => !MAJORS.includes(o))
    return orgs.includes(co)
  }

  function render() {
    const mine = cards.filter((c) => matchesCompany(c, co))
    const shown = showAll ? mine : mine.filter((c) => !isPast(c))
    cards.forEach((card) => {
      setOpen(card, false)
      card.style.display = shown.includes(card) ? '' : 'none'
    })
    const hasPast = mine.some(isPast)
    const message = shown.length
      ? ''
      : mine.length
        ? 'No upcoming productions.'
        : 'No productions recorded.'
    const offerPast = !shown.length && hasPast
    countEl.textContent = shown.length
      ? `${shown.length} ${shown.length === 1 ? 'production' : 'productions'}`
      : ''
    // With one company selected the note sits beside its logo; otherwise it replaces the list
    const inHeader = showCompanyHeader(message, offerPast)
    emptyEl.hidden = !message || inHeader
    emptyText.textContent = message
    emptyPast.hidden = !offerPast
    // Past productions toggle under the list, when there is a list
    pastToggle.hidden = !shown.length || !hasPast
    pastToggle.textContent = showAll ? 'Hide past productions' : 'Show past productions'
  }

  function setShowAll(value) {
    showAll = value
    if (value) params.set('show', 'all')
    else params.delete('show')
    const q = params.toString()
    history.replaceState(null, '', q ? `?${q}` : location.pathname)
    render()
  }

  // With one organizer selected the intro shows its logo, linked to its own website (its
  // name as a link when it has no logo), and the "nothing to list" note beside it. Returns
  // whether the intro is in company mode.
  function showCompanyHeader(message, offerPast) {
    const intro = subtitleEl.parentElement
    const single = !!co && co !== 'other'
    intro.classList.toggle('page-intro--company', single)
    if (!single) {
      subtitleEl.innerHTML = DEFAULT_SUBTITLE
      return false
    }
    const { website, logo, logoBg, logoDark, logoFill } = SITES[co]
    subtitleEl.textContent = ''
    let el
    if (logo) {
      // Same treatment as the /companies card: the logo's own background, or dark for a
      // light logo; a square logo gets less padding so it fills the height
      el = document.createElement('span')
      el.className = 'company-logo-tile'
      if (logoFill) el.classList.add('company-logo-tile--fill')
      el.style.background = logoBg || (logoDark ? '#1a1612' : '#faf7f2')
      const img = document.createElement('img')
      img.src = logo
      img.alt = NAMES[co]
      el.append(img)
    } else {
      el = document.createElement('strong')
      el.textContent = NAMES[co]
    }
    if (website) {
      const a = document.createElement('a')
      a.href = website
      a.target = '_blank'
      a.rel = 'noopener noreferrer'
      a.className = 'company-head-link'
      a.append(el)
      // A small "opens elsewhere" mark on the logo's corner
      const mark = document.createElement('span')
      mark.className = 'company-head-mark'
      mark.innerHTML =
        '<svg viewBox="0 0 12 12" width="15" height="15" aria-hidden="true"><path d="M4 2h6v6M10 2 3 9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>'
      a.append(mark)
      subtitleEl.append(a)
    } else subtitleEl.append(el)
    if (message) {
      // The whole box is the control when there are past productions to show
      const note = document.createElement(offerPast ? 'button' : 'span')
      note.className = 'company-note'
      note.append(message)
      if (offerPast) {
        note.type = 'button'
        note.addEventListener('click', () => setShowAll(true))
        const link = document.createElement('span')
        link.className = 'empty-past'
        link.textContent = 'Show past productions'
        note.append(link)
      }
      subtitleEl.append(note)
    }
    return true
  }

  // Deep-link: ?id=<timestamp> ("run-" prefix stripped, as on /events)
  const deepId = params.get('id')
  if (deepId) {
    document.querySelector('.page-intro').style.display = 'none'
    document.getElementById('page-bar-title').textContent = 'Production'
    const deepCard = cards.find((c) => c.dataset.id === deepId)
    cards.forEach((c) => {
      if (c !== deepCard) c.style.display = 'none'
    })
    if (deepCard) setOpen(deepCard, true)
    else document.getElementById('run-not-found').hidden = false
  } else {
    render()
    emptyEl.addEventListener('click', () => {
      if (!emptyPast.hidden) setShowAll(true)
    })
    pastToggle.addEventListener('click', () => setShowAll(!showAll))
  }

  document.querySelectorAll('.run-summary').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.run-card')
      setOpen(card, !card.classList.contains('open'))
    })
  })
</script>

<style is:inline set:html={PRODUCTION_VIEW_CSS}></style>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --nav-h: 44px;
    --page-bg: #f0ede8;
    --bg: #f7f4ef;
    --surface: #ffffff;
    --ink: #1a1612;
    --ink-muted: #6b6259;
    --ink-subtle: #9c9189;
    --border: #e0d9d0;
    --border-primary: #c8a96e;
    --link: #4f5ce0;
    --radius: 6px;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--page-bg);
    color: var(--ink);
    min-height: 100vh;
    font-size: 14px;
  }

  .runs-page {
    margin: calc(var(--nav-h) + var(--page-bar-h)) auto 0;
    padding: 16px 32px 80px;
    max-width: 960px;
  }

  .run-not-found a {
    color: var(--link);
  }

  /* ── CARDS (matches /events) ── */
  .run-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .run-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .run-card.open {
    border-color: var(--border-primary);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
  }
  .run-summary {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 14px 16px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) {
    .run-summary:hover {
      background: rgba(0, 0, 0, 0.02);
    }
  }
  .run-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .run-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .run-title {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
  }
  .run-meta-row {
    font-size: 12px;
    color: var(--ink-muted);
  }
  .run-aside {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    min-width: 80px;
  }
  .run-past-pip {
    display: none;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 7px;
    border-radius: 8px;
    color: var(--ink-subtle);
    background: rgba(0, 0, 0, 0.06);
  }
  .run-card.past .run-past-pip {
    display: inline-block;
  }
  .run-date-range {
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
  }
  .run-chevron {
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-subtle);
    border-bottom: 2px solid var(--ink-subtle);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    margin-top: 4px;
  }
  .run-card.open .run-chevron {
    transform: rotate(-135deg);
  }

  /* ── DETAIL ── */
  .run-detail {
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 20px 16px 16px;
  }

  .run-empty,
  .run-not-found {
    padding: 48px 24px;
    text-align: center;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    background: var(--page-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* The header is built by the page script, so Astro's scoping can't reach it */
  /* Company header: equal space above (page padding) and below the logo tile */
  .page-intro--company {
    align-items: flex-end;
    margin-bottom: 0;
  }
  .page-intro--company .page-subtitle {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  :global(.company-note) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin-bottom: 16px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    background: var(--page-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    line-height: 1.4;
  }
  :global(.company-note .empty-past) {
    margin: 0;
  }
  :global(button.company-note) {
    font-family: inherit;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) {
    :global(button.company-note:hover) {
      border-color: var(--border-primary);
    }
    :global(button.company-note:hover .empty-past) {
      text-decoration-thickness: 2px;
    }
  }
  .past-toggle {
    display: block;
    margin: 14px auto 0;
    padding: 8px 16px;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    background: var(--page-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: underline;
    text-decoration-color: var(--border-primary);
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .past-toggle[hidden] {
    display: none;
  }
  .past-toggle:hover {
    border-color: var(--border-primary);
    text-decoration-thickness: 2px;
  }
  :global(.company-head-link) {
    position: relative;
    display: block;
    width: fit-content;
    margin-bottom: 16px;
    line-height: 0;
  }
  :global(.company-logo-tile) {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 200px;
    height: 76px;
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid var(--border);
  }
  :global(.company-logo-tile--fill) {
    padding: 2px 12px;
  }
  :global(.company-logo-tile img) {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  :global(.company-head-mark) {
    position: absolute;
    top: 6px;
    right: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    line-height: 0;
  }
  :global(.empty-past) {
    display: block;
    margin: 10px auto 0;
    padding: 0;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    background: none;
    border: none;
    text-decoration: underline;
    text-decoration-color: var(--border-primary);
    text-underline-offset: 3px;
    cursor: pointer;
  }
  :global(.empty-past[hidden]) {
    display: none;
  }
  :global(.empty-past:hover) {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 860px) {
    .runs-page {
      padding: 16px 24px 64px;
    }
  }
  @media (max-width: 600px) {
    .runs-page {
      padding: 12px 16px 56px;
    }
    .run-title {
      font-size: 15px;
    }
    .run-aside {
      min-width: 72px;
    }
  }
</style>
