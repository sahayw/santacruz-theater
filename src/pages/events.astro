    font-weight: 600;
    color: var(--ink);
    line-height: 1.25;
  }

  .genre-badge {
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 10px;
    flex-shrink: 0;
    letter-spacing: 0.02em;
  }

  .genre-musical {
    background: #dce4fb;
    color: #2c3e9a;
  }
  .genre-drama {
