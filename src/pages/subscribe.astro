---
// /subscribe — both email lists, either or both. `?list=<list id>` pre-ticks a list and
// `?from=calendar|events|productions` adds a back link (the nav link on those pages).
// See docs/notifications-spec.md ("Subscribe and manage").
import SubscribeShell from '../components/SubscribeShell.astro'
import SubscribeChoices from '../components/SubscribeChoices.astro'
---

<SubscribeShell
  title="Email updates — Santa Cruz Theater"
  description="Get an email about new productions and dates, or about auditions and events for theater makers, across Santa Cruz County."
  canonicalPath="/subscribe"
>
  <a href="/" class="back-link" id="sub-back" hidden>&#8592;</a>

  <h1 class="sub-title">Email updates</h1>
  <p class="sub-desc">Two lists for two audiences. Pick either or both.</p>

  <div class="sub-card">
    <form id="subscribe-form" class="sub-form" novalidate>
      <div>
        <label for="subscribe-email" class="sub-label">Email address</label>
        <input
          type="email"
          id="subscribe-email"
          class="sub-input"
          placeholder="you@example.com"
          autocomplete="email"
          required
        />
      </div>
      <SubscribeChoices />
      <div class="sub-err" id="subscribe-err" hidden aria-live="polite"></div>
      <button type="submit" id="subscribe-btn" class="sub-btn">Subscribe</button>
      <div class="sub-foot">
        At most one email a day for each list, and only when there's news. Every email has a link to
        change your choices or unsubscribe.
      </div>
    </form>
    <div id="subscribe-status" class="sub-status ok" hidden aria-live="polite"></div>
  </div>

  <p class="sub-after">
    Already subscribed? <a href="/subscribe/manage">Get a link to change your choices</a>
  </p>
</SubscribeShell>

<script>
  import { readFormChoices, setFormChoices } from '../lib/subscribe-choices.ts'

  const BACK: Record<string, [string, string]> = {
    calendar: ['/calendar', 'Calendar'],
    events: ['/events', 'Events'],
    productions: ['/productions', 'Productions']
  }
  const params = new URLSearchParams(location.search)
  const back = BACK[params.get('from') ?? '']
  if (back) {
    const a = document.getElementById('sub-back') as HTMLAnchorElement
    a.href = back[0]
    a.textContent = `← ${back[1]}`
    a.hidden = false
  }
  const list = params.get('list')
  if (list) setFormChoices({ lists: [list] })

  const form = document.getElementById('subscribe-form') as HTMLFormElement
  const emailInput = document.getElementById('subscribe-email') as HTMLInputElement
  const btn = document.getElementById('subscribe-btn') as HTMLButtonElement
  const err = document.getElementById('subscribe-err')!
  const status = document.getElementById('subscribe-status')!

  const showError = (msg: string) => {
    err.textContent = msg
    err.hidden = !msg
  }

  form.addEventListener('change', () => showError(''))

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = emailInput.value.trim()
    const choices = readFormChoices(form)
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showError('Enter your email address.')
    if (!choices.lists.length) return showError('Choose at least one list.')
    showError('')
    btn.disabled = true
    btn.textContent = 'Subscribing…'
    try {
      const resp = await fetch('/.netlify/functions/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, ...choices })
      })
      const data = await resp.json().catch(() => ({}))
      if (!resp.ok)
        return showError(data.message || 'Something went wrong — please try again shortly.')
      status.textContent = data.message
      status.hidden = false
      form.hidden = true
    } catch {
      showError('Network error — please try again shortly.')
    } finally {
      btn.disabled = false
      btn.textContent = 'Subscribe'
    }
  })
</script>
