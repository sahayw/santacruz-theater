</style>

<script define:vars={{ performances, companies: companiesData.companies }} is:inline>
  const PERFORMANCES = performances
  const CARD_DESCRIPTION_LINES = 4
  const TODAY = new Date().toISOString().slice(0, 10)
  const COMPANY_COLORS = {
    scs: 'var(--col-scs)',
    at: 'var(--col-at)',
    mct: 'var(--col-mct)',
    renegade: 'var(--col-renegade)'
  }
  const COMPANY_NAMES = Object.fromEntries(companies.map((c) => [c.id, c.name]))
  const COMPANY_ABV = Object.fromEntries(companies.map((c) => [c.id, c.abvName]))
  const MONTHS = [
    'January',
    'February',
    'March',
    'April',
    'May',
    'June',
    'July',
    'August',
    'September',
    'October',
    'November',
    'December'
  ]
  const DOW = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']

  let filteredPerfs = [...PERFORMANCES]
  const EARLIEST_YEAR = 2026
  const FILTER_AUTO_CLOSE_DELAY = 500
  let displayYear = EARLIEST_YEAR
  let filterCloseTimer = null

  function updateYearNav() {
    document.getElementById('yearDisplay').textContent = displayYear
    const prevBtn = document.getElementById('yearPrev')
    const nextBtn = document.getElementById('yearNext')
    prevBtn.classList.toggle('hidden', displayYear <= EARLIEST_YEAR)
    const hasNextYear = PERFORMANCES.some((p) => p.date.startsWith(String(displayYear + 1)))
    nextBtn.classList.toggle('dimmed', !hasNextYear)
  }

  function updateFilterBadge() {
    const co = document.getElementById('filterCompany').value
    const ge = document.getElementById('filterGenre').value
    const ti = document.getElementById('filterTime').value
    const hasFilter = [co, ge, ti].some(Boolean)
    document.getElementById('filterLabel').textContent = hasFilter ? 'Filters ✓' : 'Filters'
    document.getElementById('filterToggleBtn').classList.toggle('active', hasFilter)
  }

  function companyColor(co) {
    return COMPANY_COLORS[co] || 'var(--col-other)'
  }
  const COMPANY_DOTS = {
    scs: 'var(--dot-scs)',
    at: 'var(--dot-at)',
    mct: 'var(--dot-mct)',
    renegade: 'var(--dot-renegade)'
  }
  function dotColor(co) {
    return COMPANY_DOTS[co] || 'var(--dot-other)'
  }
  const COMPANY_ACCS = {
    scs: 'var(--acc-scs)',
    at: 'var(--acc-at)',
    mct: 'var(--acc-mct)',
    renegade: 'var(--acc-renegade)'
  }
  function accentColor(co) {
    return COMPANY_ACCS[co] || 'var(--acc-other)'
  }
  function dowMon(d) {
    return (d.getDay() + 6) % 7
  }
  function fmtDate(d) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
  }
  function isMat(t) {
    return parseInt(t) < 17
  }
  function getBarPos(flags, idx) {
    if (!flags || !flags[idx]) return 'none'
    const prev = idx > 0 && flags[idx - 1]
    const next = idx < 6 && flags[idx + 1]
    if (!prev && !next) return 'single'
    if (!prev) return 'start'
    if (!next) return 'end'
    return 'mid'
  }
  function fmtTime(t) {
    const [hStr, mStr] = (t || '').replace('.', ':').split(':')
    const h = Number(hStr)
    const m = mStr !== undefined ? Number(mStr) : 0
    const period = h < 12 ? 'am' : 'pm'
    const h12 = h % 12 || 12
    return m === 0 ? `${h12}${period}` : `${h12}:${String(m).padStart(2, '0')}${period}`
  }
  let activePanelDate = null
  let activePanelCell = null
  let panelShownAt = 0
  let lastTouchTime = 0
  document.addEventListener(
    'touchstart',
    () => {
      lastTouchTime = Date.now()
    },
    { passive: true, capture: true }
  )

  function showHoverPanel(ds, perfs, cellEl, month, isTouch = false) {
    const panel = document.getElementById('hoverPanel')
    const [y, mo, d] = ds.split('-').map(Number)
    const dateLabel = new Date(y, mo - 1, d).toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric'
    })
    let html = `<div class="hover-panel-header">${dateLabel}</div>`
    const sorted = [...perfs].sort((a, b) => a.time.localeCompare(b.time))
    sorted.forEach((p) => {
      const venue = p.venue
      html += `<div class="hover-panel-row">
        <div class="hover-panel-show">
          <div class="hover-panel-dot" style="background:${dotColor(p.company)}"></div>
          <span>${COMPANY_ABV[p.company] || p.company} · ${p.showAbv}</span>
        </div>
        <div class="hover-panel-meta">${fmtTime(p.time)} · ${venue}</div>
      </div>`
    })
    if (isTouch) html += `<div class="hover-panel-footer">Tap to view week →</div>`
    panel.innerHTML = html
    const rect = cellEl.getBoundingClientRect()
    const pw = 240
    const ph = 34 + sorted.length * 46 + (isTouch ? 30 : 0)
    let left = rect.left
    let top = rect.bottom + 6
    if (left + pw > window.innerWidth - 8) left = Math.max(8, rect.right - pw)
    if (top + ph > window.innerHeight - 8) top = rect.top - ph - 6
    panel.style.left = Math.max(8, left) + 'px'
    panel.style.top = Math.max(8, top) + 'px'
    activePanelDate = ds
    if (activePanelCell) activePanelCell.classList.remove('pip-active')
    activePanelCell = isTouch ? cellEl : null
    if (isTouch) cellEl.classList.add('pip-active')
    panel.dataset.month = month ?? ''
    panelShownAt = Date.now()
    panel.classList.add('visible')
    if (isTouch) panel.classList.add('touch-mode')
  }
  function hideHoverPanel() {
    const panel = document.getElementById('hoverPanel')
    panel.classList.remove('visible', 'touch-mode')
    activePanelDate = null
    if (activePanelCell) {
      activePanelCell.classList.remove('pip-active')
      activePanelCell = null
    }
  }
  let activeDescRunId = null
  let descPanelShownAt = 0

  function renderMd(text) {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
  }

  function showDescPanel(s, chipEl, isTouch = false) {
    const panel = document.getElementById('showDescPanel')
    const description = (s.description || '').trimEnd()
    let html = `<div class="desc-panel-header">
      <div class="desc-panel-company">${COMPANY_NAMES[s.company] || s.company}</div>
      <div class="desc-panel-title">${s.show}</div>
    </div>
    <div class="desc-panel-body">${renderMd(description)}</div>`
    if (isTouch) html += `<div class="desc-panel-footer">Tap to dismiss</div>`
    panel.innerHTML = html
    const rect = chipEl.getBoundingClientRect()
    const pw = 290
    const ph = 80 + Math.ceil(s.description.length / 50) * 20
    let left = rect.right + 8
    let top = Math.round(rect.top + (rect.height - ph) / 2)
    if (left + pw > window.innerWidth - 8) left = Math.max(8, rect.left - pw - 8)
    if (top + ph > window.innerHeight - 8) top = Math.max(8, window.innerHeight - ph - 8)
    if (top < 8) top = 8
    panel.style.left = left + 'px'
    panel.style.top = top + 'px'
    activeDescRunId = s.runId
    panel.classList.add('visible')
    if (isTouch) {
      panel.classList.add('touch-mode')
      descPanelShownAt = Date.now()
    }
  }

  function hideDescPanel() {
    const panel = document.getElementById('showDescPanel')
    panel.classList.remove('visible', 'touch-mode')
    activeDescRunId = null
  }

  function updateCardDescriptionButtons(root) {
    root.querySelectorAll('.card-description').forEach((descEl) => {
      const wrapper = descEl.parentElement
      const button = wrapper?.querySelector('.card-description-more')
      if (!button) return
      descEl.classList.remove('clamped')
      wrapper?.classList.remove('truncated')
      button.classList.remove('visible')
      const exceedsClamp =
        descEl.scrollHeight >
        Math.ceil(parseFloat(getComputedStyle(descEl).lineHeight) * CARD_DESCRIPTION_LINES) + 1
      if (exceedsClamp) {
        descEl.classList.add('clamped')
        wrapper?.classList.add('truncated')
        button.classList.add('visible')
      }
    })
  }

  function perfsByDate(perfs) {
    const m = {}
    perfs.forEach((p) => {
      ;(m[p.date] = m[p.date] || []).push(p)
    })
    return m
  }

  function orderedShows(perfs) {
    const seen = new Set()
    const result = []
    ;[...perfs]
      .sort((a, b) => a.date.localeCompare(b.date))
      .forEach((p) => {
        if (!seen.has(p.runId)) {
          seen.add(p.runId)
          result.push({
            runId: p.runId,
            showAbv: p.showAbv,
            company: p.company,
            show: p.show,
            description: p.description || ''
          })
        }
      })
    return result
  }

  function applyFilters() {
    const co = document.getElementById('filterCompany').value
    const ge = document.getElementById('filterGenre').value
    const ti = document.getElementById('filterTime').value
    filteredPerfs = PERFORMANCES.filter((p) => {
      if (co && p.company !== co) return false
      if (ge && !p.genre.includes(ge)) return false
      if (ti === 'Mat' && !isMat(p.time)) return false
      if (ti === 'Eve' && isMat(p.time)) return false
      return true
    })
    updateFilterBadge()
    renderAnnual()
    buildScrollView()
    scheduleFilterDropdownClose()
  }

  const LEGEND_ENTRIES = [
    ...Object.keys(COMPANY_COLORS).map((code) => ({
      color: `var(--dot-${code.toLowerCase()})`,
      label: COMPANY_NAMES[code] || code
    })),
    { color: 'var(--dot-other)', label: 'Other' },
    { color: 'var(--dot-multi)', label: 'Multiple companies', view: 'annual' }
  ]

  function buildFixedFooter(view = 'annual') {
    const footer = document.getElementById('fixedLegendFooter')
    footer.innerHTML = ''
    const title = document.createElement('span')
    title.className = 'legend-title'
    title.textContent = 'COMPANIES'
    footer.appendChild(title)
    LEGEND_ENTRIES.forEach((e) => {
      if (e.view && e.view !== view) return
      const item = document.createElement('div')
      item.className = 'legend-item'
      item.style.cssText =
        'display:flex;align-items:center;gap:4px;font-size:11px;white-space:nowrap;'
      item.innerHTML = `<div class="legend-dot" style="background:${e.color};width:11px;height:11px;border-radius:2px;flex-shrink:0"></div><span>${e.label}</span>`
      footer.appendChild(item)
    })
  }

  function renderAnnual() {
    const byDate = perfsByDate(filteredPerfs)
    const grid = document.getElementById('monthsGrid')
    grid.innerHTML = ''
    for (let m = 0; m < 12; m++) {
      const block = document.createElement('div')
      block.className = 'month-block'
      block.onclick = () => goToMonth(m)
      const nameEl = document.createElement('div')
      nameEl.className = 'month-name'
      nameEl.textContent = MONTHS[m]
      block.appendChild(nameEl)
      const cal = document.createElement('div')
      cal.className = 'mini-cal'
      const head = document.createElement('div')
      head.className = 'mini-cal-head'
      DOW.forEach((d) => {
        const s = document.createElement('span')
        s.textContent = d[0]
        head.appendChild(s)
      })
      cal.appendChild(head)
      const body = document.createElement('div')
      body.className = 'mini-cal-body'
      const firstDay = new Date(displayYear, m, 1)
      const daysInMonth = new Date(displayYear, m + 1, 0).getDate()
      const startDow = dowMon(firstDay)
      for (let i = 0; i < startDow; i++) {
        const e = document.createElement('div')
        e.className = 'mini-day empty'
        body.appendChild(e)
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const ds = `${displayYear}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`
        const perfs = byDate[ds] || []
        const el = document.createElement('div')
        el.className = 'mini-day'
        el.textContent = d
        if (perfs.length) {
          el.classList.add('has-perf')
          const cos = [...new Set(perfs.map((p) => p.company))]
          if (cos.length > 1) el.classList.add('multi')
          else el.style.background = companyColor(cos[0])
          el.addEventListener('pointerenter', (e) => {
            if (e.pointerType === 'mouse') showHoverPanel(ds, perfs, el, m, false)
          })
          el.addEventListener('pointerleave', (e) => {
            if (e.pointerType === 'mouse') hideHoverPanel()
          })
          el.addEventListener('click', (e) => {
            e.stopPropagation()
            if (Date.now() - lastTouchTime < 500) {
              if (activePanelDate === ds) {
                hideHoverPanel()
                goToMonth(m)
              } else {
                showHoverPanel(ds, perfs, el, m, true)
              }
            } else {
              goToMonth(m)
            }
          })
        }
        body.appendChild(el)
      }
      cal.appendChild(body)
      block.appendChild(cal)
      grid.appendChild(block)
    }
  }

  const monthAnchorIds = {}

  function buildScrollView() {
    const container = document.getElementById('scroll-weeks')
    container.innerHTML = ''
    const byDate = perfsByDate(filteredPerfs)
    const allShows = orderedShows(filteredPerfs)

    // Span all years present in the full dataset (not just filtered)
    const dataYears = PERFORMANCES.map((p) => parseInt(p.date.slice(0, 4)))
    const firstYear = EARLIEST_YEAR
    const maxDataYear = Math.max(EARLIEST_YEAR, ...dataYears)
    const lastYear = Math.max(maxDataYear + 1, displayYear)

    // Reset anchor map
    Object.keys(monthAnchorIds).forEach((k) => delete monthAnchorIds[k])

    let cursor = new Date(firstYear, 0, 1)
    cursor.setDate(cursor.getDate() - dowMon(cursor))
    const end = new Date(lastYear, 11, 31)
    let currentMonth = -1
    let currentYear = -1

    while (cursor <= end) {
      const weekDays = Array.from({ length: 7 }, (_, i) => {
        const d = new Date(cursor)
        d.setDate(cursor.getDate() + i)
        return d
      })
      const weekMonth = weekDays[3].getMonth()
      const weekYear = weekDays[3].getFullYear()

      if (weekYear !== currentYear || weekMonth !== currentMonth) {
        currentMonth = weekMonth
        currentYear = weekYear
        if (!monthAnchorIds[currentYear]) monthAnchorIds[currentYear] = {}
        const anchorId = `month-anchor-${currentYear}-${currentMonth}`
        monthAnchorIds[currentYear][currentMonth] = anchorId
        const label = document.createElement('div')
        label.className = 'scroll-month-label'
        label.id = anchorId
        label.dataset.year = String(currentYear)
        label.textContent = `${MONTHS[currentMonth]} ${currentYear}`
        container.appendChild(label)
      }

      const weekShowIds = new Set()
      weekDays.forEach((day) => {
        ;(byDate[fmtDate(day)] || []).forEach((p) => weekShowIds.add(p.runId))
      })
      const weekShows = allShows.filter((s) => weekShowIds.has(s.runId))
      const nRows = Math.max(weekShows.length, 1)

      const showDayCoverage = {}
      weekShows.forEach((s) => {
        showDayCoverage[s.runId] = weekDays.map((day) => {
          const ds = fmtDate(day)
          return (byDate[ds] || []).some((p) => p.runId === s.runId)
        })
      })

      const wrap = document.createElement('div')
      wrap.className = 'week-table-wrap'

      const grid = document.createElement('div')
      grid.className = 'week-grid'
      grid.style.gridTemplateRows = `var(--daynum-h) repeat(${nRows}, var(--row-h))`

      const showsCol = document.createElement('div')
      showsCol.className = 'shows-col'
      showsCol.style.gridRow = `1 / span ${nRows + 1}`
      const spacer = document.createElement('div')
      spacer.className = 'shows-col-spacer'
      showsCol.appendChild(spacer)
      if (weekShows.length === 0) {
        const empty = document.createElement('div')
        empty.className = 'show-chip'
        empty.innerHTML = '<span style="color:var(--ink-muted);font-size:11px">—</span>'
        showsCol.appendChild(empty)
      } else {
        weekShows.forEach((s) => {
          const chip = document.createElement('div')
          chip.className = 'show-chip' + (s.description ? ' has-desc' : '')
          chip.innerHTML = `<span class="show-chip-bar" style="background:${accentColor(s.company)}"></span><span class="show-chip-name" title="${s.show}">${s.showAbv}</span>`
          if (s.description) {
            chip.addEventListener('pointerenter', (e) => {
              if (e.pointerType === 'mouse') showDescPanel(s, chip, false)
            })
            chip.addEventListener('pointerleave', (e) => {
              if (e.pointerType === 'mouse') hideDescPanel()
            })
            chip.addEventListener('click', (e) => {
              if (Date.now() - lastTouchTime < 500) {
                e.stopPropagation()
                if (activeDescRunId === s.runId) {
                  hideDescPanel()
                } else {
                  showDescPanel(s, chip, true)
                }
              }
            })
          }
          showsCol.appendChild(chip)
        })
      }
      grid.appendChild(showsCol)

      weekDays.forEach((day, dayIdx) => {
        const ds = fmtDate(day)
        const dayPerfs = byDate[ds] || []
        const inMonth = day.getMonth() === weekMonth

        const col = document.createElement('div')
        col.className =
          'day-col' + (!inMonth ? ' other-month' : '') + (dayPerfs.length ? ' has-perf' : '')
        col.style.gridRow = `1 / span ${nRows + 1}`

        const numRow = document.createElement('div')
        numRow.className = 'day-num-row'
        if (dayPerfs.length) numRow.onclick = () => openSheet(ds)
        const num = document.createElement('div')
        num.className = 'day-num' + (ds === TODAY ? ' today' : '')
        num.textContent = day.getDate()
        numRow.appendChild(num)
        col.appendChild(numRow)

        const dayPipData = {}
        dayPerfs.forEach((p) => {
          if (!dayPipData[p.runId]) dayPipData[p.runId] = { mat: false, eve: false }
          if (isMat(p.time)) dayPipData[p.runId].mat = true
          else dayPipData[p.runId].eve = true
        })

        const rowsToRender = weekShows.length > 0 ? weekShows : [null]
        rowsToRender.forEach((s) => {
          const pipRow = document.createElement('div')
          pipRow.className = 'pip-row'
          if (s) {
            const pips = dayPipData[s.runId]
            const barPos = getBarPos(showDayCoverage[s.runId], dayIdx)
            if (pips && barPos !== 'none') {
              const bar = document.createElement('div')
              bar.className = 'perf-bar bar-' + barPos
              bar.style.background = companyColor(s.company)
              const labelText = pips.mat && pips.eve ? 'Mat / Eve' : pips.mat ? 'Mat' : 'Eve'
              const label = document.createElement('span')
              label.className = 'perf-label'
              label.textContent = labelText
              bar.onclick = (e) => {
                e.stopPropagation()
                openSheet(ds, s.runId)
              }
              bar.appendChild(label)
              pipRow.appendChild(bar)
            }
          }
          col.appendChild(pipRow)
        })

        grid.appendChild(col)
      })

      wrap.appendChild(grid)
      container.appendChild(wrap)
      cursor.setDate(cursor.getDate() + 7)
    }
  }

  function fixedChromeHeight() {
    const cs = getComputedStyle(document.documentElement)
    return (
      (parseInt(cs.getPropertyValue('--nav-h')) || 0) +
      (parseInt(cs.getPropertyValue('--bar-h')) || 44) +
      (parseInt(cs.getPropertyValue('--col-header-h')) || 28)
    )
  }

  function scrollToAnchorEl(el) {
    if (!el) return
    let target = 0
    let node = el
    while (node) {
      target += node.offsetTop
      node = node.offsetParent
    }
    window.scrollTo({ top: Math.max(0, target - fixedChromeHeight()), behavior: 'smooth' })
  }

  function updateYearFromScroll() {
    const labels = document.querySelectorAll('.scroll-month-label')
    const threshold = fixedChromeHeight() + 10
    let detected = EARLIEST_YEAR
    for (const label of labels) {
      if (label.getBoundingClientRect().top <= threshold) {
        detected = parseInt(label.dataset.year) || EARLIEST_YEAR
      } else {
        break
      }
    }
    if (detected !== displayYear) {
      displayYear = detected
      updateYearNav()
    }
  }

  function goToMonth(m) {
    hideHoverPanel()
    const rebuilt = !monthAnchorIds[displayYear]
    if (rebuilt) buildScrollView()
    document.getElementById('annual-view').style.display = 'none'
    document.getElementById('scroll-view').style.display = 'block'
    document.getElementById('scrollColHeader').classList.add('visible')
    document.getElementById('fixedLegendFooter').classList.add('visible')
    document.body.classList.remove('annual-mode')
    document.body.classList.add('scroll-mode')
    buildFixedFooter('drill')
    const doScroll = () =>
      scrollToAnchorEl(document.getElementById(monthAnchorIds[displayYear]?.[m]))
    if (rebuilt) {
      requestAnimationFrame(() => requestAnimationFrame(doScroll))
    } else {
      requestAnimationFrame(doScroll)
    }
  }

  function showAnnual() {
    document.getElementById('scroll-view').style.display = 'none'
    document.getElementById('annual-view').style.display = 'block'
    document.getElementById('scrollColHeader').classList.remove('visible')
    document.body.classList.remove('scroll-mode')
    document.body.classList.add('annual-mode')
    buildFixedFooter('annual')
    window.scrollTo(0, 0)
  }

  function openSheet(dateStr, runId = null) {
    let perfs = perfsByDate(filteredPerfs)[dateStr] || []
    if (runId) perfs = perfs.filter((p) => p.runId === runId)
    if (!perfs.length) return
    document.getElementById('sheetDateHeader').textContent = new Date(
      dateStr + 'T12:00:00'
    ).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })
    const cards = document.getElementById('sheetCards')
    cards.innerHTML = ''
    let previousRunId = null
    perfs.forEach((p) => {
      const card = document.createElement('div')
      card.className = 'perf-card'
      const [hStr, mStr] = (p.time || '').replace('.', ':').split(':')
      const h = Number(hStr),
        min = mStr !== undefined ? Number(mStr) : 0
      const timeStr = `${h > 12 ? h - 12 : h || 12}:${String(min).padStart(2, '0')}${h >= 12 ? 'pm' : 'am'}`
      const description = (p.description || '').trimEnd()
      const showDescription = description && previousRunId !== p.runId
      card.innerHTML = `
      <div class="perf-card-company">
        <div class="company-badge" style="background:${accentColor(p.company)}"></div>
        <span class="company-name">${COMPANY_NAMES[p.company] || p.company}</span>
        ${p.perfType ? `<span class="perf-type-tag" data-type="${p.perfType}">${p.perfType}</span>` : ''}
      </div>
      <div class="card-show-title">${p.show}</div>
      ${showDescription ? `<div class="card-description-wrap"><div class="card-description">${renderMd(description)}</div><button type="button" class="card-description-more"><span class="card-description-more-ellipsis">...</span><span class="card-description-more-label">More</span></button></div>` : ''}
      <div class="card-meta">
        <div class="card-meta-item"><span class="card-meta-label">Time&nbsp;</span>${timeStr}</div>
        <div class="card-meta-item"><span class="card-meta-label">Venue&nbsp;</span>${p.venue}</div>
        <div class="card-meta-item"><span class="card-meta-label">Price&nbsp;</span>${p.price}</div>
        ${p.genre.length ? `<div class="card-meta-item"><span class="card-meta-label">Genre&nbsp;</span>${p.genre.join(' / ')}</div>` : ''}
      </div>
      ${p.discounts ? `<div class="card-discounts">Discounts: ${p.discounts}</div>` : ''}
      <div class="card-buttons">
        ${
          p.infoUrl
            ? `<a class="btn-info" href="${p.infoUrl}" target="_blank" rel="noopener">More info</a>`
            : `<a class="btn-info" aria-disabled="true">More info</a>`
        }
        ${
          p.ticketsUrl
            ? `<a class="btn-tickets" href="${p.ticketsUrl}" target="_blank" rel="noopener">Get tickets</a>`
            : `<a class="btn-tickets" aria-disabled="true">Get tickets</a>`
        }
      </div>`
      cards.appendChild(card)
      const descEl = card.querySelector('.card-description')
      const moreBtn = card.querySelector('.card-description-more')
      if (descEl && moreBtn) {
        moreBtn.addEventListener('click', () => {
          descEl.classList.remove('clamped')
          descEl.parentElement?.classList.remove('truncated')
          moreBtn.remove()
        })
      }
      previousRunId = p.runId
    })
    document.getElementById('overlay').classList.add('open')
    document.getElementById('bottomSheet').classList.add('open')
    document.documentElement.style.overflow = 'hidden'
    requestAnimationFrame(() => updateCardDescriptionButtons(cards))
  }

  function closeSheet() {
    document.getElementById('overlay').classList.remove('open')
    document.getElementById('bottomSheet').classList.remove('open')
    document.documentElement.style.overflow = ''
  }

  document.getElementById('backBtn').addEventListener('click', showAnnual)
  document.getElementById('listViewBtn').addEventListener('click', () => goToMonth(0))
  document.getElementById('sheetCloseBtn').addEventListener('click', closeSheet)
  document.getElementById('filterCompany').addEventListener('change', applyFilters)
  document.getElementById('filterGenre').addEventListener('change', applyFilters)
  document.getElementById('filterTime').addEventListener('change', applyFilters)
  document.getElementById('overlay').addEventListener('click', closeSheet)

  const filterToggleBtn = document.getElementById('filterToggleBtn')
  const filterDropdown = document.getElementById('filterDropdown')
  function clearFilterDropdownCloseTimer() {
    if (filterCloseTimer !== null) {
      window.clearTimeout(filterCloseTimer)
      filterCloseTimer = null
    }
  }

  function closeFilterDropdown() {
    clearFilterDropdownCloseTimer()
    filterDropdown.classList.remove('open')
  }

  function openFilterDropdown() {
    clearFilterDropdownCloseTimer()
    filterDropdown.classList.add('open')
  }

  function scheduleFilterDropdownClose() {
    if (!filterDropdown.classList.contains('open')) return
    clearFilterDropdownCloseTimer()
    filterCloseTimer = window.setTimeout(() => {
      closeFilterDropdown()
    }, FILTER_AUTO_CLOSE_DELAY)
  }

  filterToggleBtn.addEventListener('click', (e) => {
    e.stopPropagation()
    if (filterDropdown.classList.contains('open')) {
      closeFilterDropdown()
      return
    }
    openFilterDropdown()
  })

  document.getElementById('yearPrev').addEventListener('click', () => {
    if (displayYear <= EARLIEST_YEAR) return
    displayYear--
    updateYearNav()
    if (document.body.classList.contains('scroll-mode')) {
      requestAnimationFrame(() =>
        scrollToAnchorEl(document.getElementById(monthAnchorIds[displayYear]?.[0]))
      )
    } else {
      renderAnnual()
    }
  })

  document.getElementById('yearNext').addEventListener('click', () => {
    displayYear++
    updateYearNav()
    if (document.body.classList.contains('scroll-mode')) {
      if (!monthAnchorIds[displayYear]) buildScrollView()
      requestAnimationFrame(() =>
        scrollToAnchorEl(document.getElementById(monthAnchorIds[displayYear]?.[0]))
      )
    } else {
      renderAnnual()
      if (!monthAnchorIds[displayYear]) buildScrollView()
    }
  })

  renderAnnual()
  buildScrollView()
  buildFixedFooter()
  updateYearNav()
  document.getElementById('fixedLegendFooter').classList.add('visible')
  document.body.classList.add('annual-mode')

  const footerEl = document.getElementById('fixedLegendFooter')
  new ResizeObserver(() => {
    document.body.style.paddingBottom = footerEl.offsetHeight + 8 + 'px'
  }).observe(footerEl)

  document.addEventListener(
    'scroll',
    () => {
      hideHoverPanel()
      hideDescPanel()
      if (document.body.classList.contains('scroll-mode')) updateYearFromScroll()
    },
    { passive: true }
  )

  document.getElementById('scroll-view').addEventListener(
    'scroll',
    function () {
      const x = this.scrollLeft
      document.querySelectorAll('.scroll-month-label').forEach((el) => {
        el.style.transform = `translateX(${x}px)`
      })
    },
    { passive: true }
  )

  document.getElementById('hoverPanel').addEventListener('touchend', (e) => {
    if (Date.now() - panelShownAt < 300) return // ghost touchend from the tap that showed the panel
    const m = parseInt(e.currentTarget.dataset.month, 10)
    if (!isNaN(m)) {
      e.preventDefault()
      hideHoverPanel()
      goToMonth(m)
    }
  })

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.filter-area')) {
      closeFilterDropdown()
    }
    if (activePanelDate && !e.target.closest('#hoverPanel') && !e.target.closest('.mini-day')) {
      hideHoverPanel()
    }
    if (
      activeDescRunId &&
      !e.target.closest('#showDescPanel') &&
      !e.target.closest('.show-chip.has-desc')
    ) {
      hideDescPanel()
    }
  })

  document.getElementById('showDescPanel').addEventListener('touchend', (e) => {
    if (Date.now() - descPanelShownAt < 300) return
    e.preventDefault()
    hideDescPanel()
  })

  document.getElementById('scroll-view').addEventListener('scroll', function () {
    document.getElementById('scrollColHeader').scrollLeft = this.scrollLeft
  })
</script>
