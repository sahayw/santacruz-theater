---
interface Props {
  currentPage?: 'calendar' | 'companies' | 'events' | 'services'
  showAbout?: boolean
  homeMode?: boolean
}
const { currentPage, showAbout, homeMode } = Astro.props
---

<nav class:list={['site-nav', { 'site-nav--home': homeMode }]}>
  <a href="/" class="nav-brand">Santa Cruz Theater</a>
  <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
  </button>
  <ul class="nav-links">
    <li>
      <a href="/calendar" class={`nav-link${currentPage === 'calendar' ? ' nav-link--active' : ''}`}
        >Calendar</a
      >
    </li>
    <li>
      <a
        href="/companies"
        class={`nav-link${currentPage === 'companies' ? ' nav-link--active' : ''}`}>Companies</a
      >
    </li>
    <li>
      <a href="/events" class={`nav-link${currentPage === 'events' ? ' nav-link--active' : ''}`}
        >Events</a
      >
    </li>
    <li>
      <a href="/services" class={`nav-link${currentPage === 'services' ? ' nav-link--active' : ''}`}
        >Services</a
      >
    </li>
    {
      showAbout && (
        <li class="nav-about-item">
          <a href="/about" class="nav-link">
            About
          </a>
        </li>
      )
    }
  </ul>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle')
  const links = document.querySelector<HTMLElement>('.nav-links')

  toggle?.addEventListener('click', () => {
    const isOpen = links?.classList.toggle('nav-links--open')
    toggle.setAttribute('aria-expanded', String(isOpen))
  })

  links?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      links.classList.remove('nav-links--open')
      toggle?.setAttribute('aria-expanded', 'false')
    })
  })

  document.addEventListener('click', (e) => {
    if (!toggle?.contains(e.target as Node) && !links?.contains(e.target as Node)) {
      links?.classList.remove('nav-links--open')
      toggle?.setAttribute('aria-expanded', 'false')
    }
  })
</script>

<style>
  :root {
    --bar-bg: #2e2a26;
  }

  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 130;
    height: 44px;
    background: var(--bar-bg);
    display: flex;
    align-items: center;
    padding: 0 20px;
  }

  .nav-brand {
    font-family: 'Playfair Display', serif;
    font-size: 15px;
    font-weight: 600;
    color: #e2d5b8;
    text-decoration: none;
    letter-spacing: 0.03em;
    flex: 0 0 auto;
    white-space: nowrap;
    transition: color 0.14s;
  }
  .nav-brand:hover {
    color: #d4b87c;
  }

  .nav-toggle {
    display: none;
    margin-left: auto;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 4px;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-toggle-bar {
    display: block;
    width: 18px;
    height: 1.5px;
    background: rgba(255, 255, 255, 0.65);
    border-radius: 1px;
    transition: background 0.14s;
  }

  .nav-toggle:hover .nav-toggle-bar {
    background: rgba(255, 255, 255, 0.9);
  }

  .nav-links {
    list-style: none;
    display: flex;
    margin-left: auto;
    gap: 2px;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
  }

  .nav-link {
    display: block;
    color: rgba(255, 255, 255, 0.804);
    text-decoration: none;
    padding: 5px 11px;
    border-radius: 4px;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.01em;
    transition: color 0.14s;
    -webkit-tap-highlight-color: transparent;
  }

  .nav-link:hover {
    color: #d4b87c;
  }

  .nav-link--active {
    color: #d4b87c;
    font-weight: 500;
    pointer-events: none;
  }

  .nav-about-item {
    margin-left: 8px;
    padding-left: 10px;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* ── HOME MODE: only About link, right-aligned to content column ── */
  .site-nav--home {
    background: #1f0c09;
  }

  .site-nav--home .nav-brand,
  .site-nav--home li:not(.nav-about-item),
  .site-nav--home .nav-toggle {
    display: none;
  }

  .site-nav--home .nav-links {
    display: flex !important;
  }

  .site-nav--home .nav-about-item {
    margin-left: 0;
    padding-left: 0;
    border-left: none;
  }

  /* Align About link right edge with the page content column.
     At >960px the column is centred (max-width 960px), so we need
     (vw-960)/2 of auto margin plus 40px (32px content pad + 8px card pad).
     Below 960px the column fills full width so just 40px suffices. */
  .site-nav--home {
    padding-right: max(40px, calc((100vw - 960px) / 2 + 40px));
  }

  @media (max-width: 860px) {
    /* page-content padding shrinks to 24px here, so 24+8=32px */
    .site-nav--home {
      padding-right: 32px;
    }
  }

  @media (max-width: 600px) {
    /* page-content padding shrinks to 16px here, so 16+8=24px */
    .site-nav--home {
      padding-right: 24px;
    }
  }

  /* Reset the mobile dropdown positioning so About stays in the bar */
  @media (max-width: 560px) {
    .site-nav--home .nav-links {
      position: static;
      flex-direction: row;
      background: none;
      box-shadow: none;
      border-radius: 0;
      padding: 0;
    }
  }

  @media (max-width: 560px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: 44px;
      right: 0;
      flex-direction: column;
      gap: 2px;
      padding: 4px;
      background: var(--bar-bg);
      box-shadow:
        0 6px 16px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.07);
      border-radius: 0 0 6px 6px;
    }

    .nav-links--open {
      display: flex;
    }

    .nav-link {
      white-space: nowrap;
      padding: 8px 14px;
    }
  }
</style>
