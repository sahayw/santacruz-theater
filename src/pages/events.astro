    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }

  .aud-chevron {
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-subtle);
    border-bottom: 2px solid var(--ink-subtle);
