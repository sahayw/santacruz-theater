---
import BaseHead from '../components/BaseHead.astro'
import SiteNav from '../components/SiteNav.astro'
import { getServices, getServiceCategories } from '../lib/data.ts'

const listings = getServices()
const categories = getServiceCategories()

const activeSubIds = new Set(listings.flatMap((l) => l.categories))
const activeCatIds = new Set(
  categories
    .filter((cat) => cat.subcategories.some((s) => activeSubIds.has(s.id)))
    .map((cat) => cat.id)
)

// pill text: description if set, else label
const subPillMap: Record<string, string> = {}
for (const cat of categories) {
  for (const sub of cat.subcategories) {
    subPillMap[sub.id] = sub.description ?? sub.label
  }
}

const catsJson = JSON.stringify(
  categories.map((cat) => ({
    id: cat.id,
    label: cat.label,
    subcategories: cat.subcategories.map((s) => ({ id: s.id, label: s.label })),
  }))
)

function renderDesc(raw: string): string {
  return raw
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*\n]+?)\*/g, '<em>$1</em>')
    .replace(
      /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
      '<a href="$2" target="_blank" rel="noopener">$1</a>'
    )
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Services — Santa Cruz Theater"
      description="Connect with the people and services you need to support your production."
      canonicalPath="/services"
    />
  </head>
  <body>
    <SiteNav currentPage="services" />

    <main class="svc-page">
      <header class="page-header">
        <h1 class="page-title" id="page-title">Services</h1>
      </header>

      {/* ── CATEGORY INDEX (index mode — no URL params) ── */}
      <div class="cat-index" id="cat-index">
        <p class="page-subtitle">
          Production resources for Santa Cruz County theater — people, equipment, spaces
        </p>
        <div class="cat-index-grid">
        {
          categories.map((cat) => {
            const catActive = activeCatIds.has(cat.id)
            return (
              <div class="cat-index-group">
                {catActive ? (
                  <a class="cat-parent-link" href={`/services?category=${cat.id}`}>
                    {cat.label}
                  </a>
                ) : (
                  <span class="cat-parent-link cat-inactive">{cat.label}</span>
                )}
                <div class="cat-subs-list">
                  {cat.subcategories.map((sub) => {
                    const subActive = activeSubIds.has(sub.id)
                    return subActive ? (
                      <a class="cat-sub-link" href={`/services?category=${sub.id}`}>
                        {sub.label}
                      </a>
                    ) : (
                      <span class="cat-sub-link cat-inactive">{sub.label}</span>
                    )
                  })}
                </div>
              </div>
            )
          })
        }
        </div>
      </div>

      {/* ── FILTER BAR (filtered mode — ?category param) ── */}
      <div class="filter-bar" id="filter-bar" hidden>
        <div class="filter-controls">
          <div class="filter-group">
            <label>Category</label>
            <div class="filter-dropdown" id="filter-dropdown">
              <button
                class="filter-dropdown-btn"
                id="filter-dropdown-btn"
                aria-expanded="false"
                onclick="svc.toggleDropdown()"
              >
                <span id="filter-dropdown-label">Select category</span>
                <svg
                  class="filter-dropdown-arrow"
                  width="10"
                  height="6"
                  viewBox="0 0 10 6"
                  aria-hidden="true"
                  ><path d="M0 0l5 6 5-6z" fill="currentColor"></path></svg
                >
              </button>
              <div class="filter-dropdown-panel" id="filter-dropdown-panel" hidden>
                {
                  categories.map((cat) => (
                    <div class="fdp-group">
                      <label class="fdp-parent-label">
                        <input
                          type="checkbox"
                          class="fdp-parent-cb"
                          data-parent={cat.id}
                          onchange={`svc.onParentCb('${cat.id}',this)`}
                        />
                        {cat.label}
                      </label>
                      <div class="fdp-subs" id={`fdp-subs-${cat.id}`} hidden>
                        {cat.subcategories.map((sub) => (
                          <label class="fdp-sub-label">
                            <input
                              type="checkbox"
                              class="fdp-sub-cb"
                              data-sub={sub.id}
                              data-parent={cat.id}
                              onchange="svc.onSubCb()"
                            />
                            {sub.label}
                          </label>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
        <div class="filter-count" id="filter-count" aria-live="polite"></div>
      </div>

      {/* ── LISTING CARDS (filtered and deep-link modes) ── */}
      <div class="svc-list" id="svc-list" hidden>
        {
          listings.map((listing) => (
            <div class="svc-card" data-id={listing.id} data-categories={listing.categories.join(',')}>
              <button class="svc-summary" aria-expanded="false">
                <div class="svc-main">
                  <div class="svc-name-row">
                    <span class="svc-name">{listing.name}</span>
                    {listing.categories.map((catId) => (
                      <span class="svc-cat-pill">{subPillMap[catId] ?? catId}</span>
                    ))}
                  </div>
                  <div class="svc-contact-row">
                    {listing.photo && (
                      <img
                        class="svc-photo"
                        src={listing.photo}
                        alt=""
                        width="80"
                        height="80"
                        loading="lazy"
                      />
                    )}
                    <div class="svc-contact-info">
                      {listing.contact.name && (
                        <span class="svc-contact-name">{listing.contact.name}</span>
                      )}
                      {listing.contact.tel && (
                        <a class="svc-contact-link" href={`tel:${listing.contact.tel}`}>
                          {listing.contact.tel}
                        </a>
                      )}
                      {listing.contact.email && (
                        <a class="svc-contact-link" href={`mailto:${listing.contact.email}`}>
                          {listing.contact.email}
                        </a>
                      )}
                      {listing.contact.address && (
                        <span class="svc-contact-address">{listing.contact.address}</span>
                      )}
                    </div>
                  </div>
                </div>
                <div class="svc-aside">
                  <span class="svc-chevron" aria-hidden="true"></span>
                </div>
              </button>

              <div class="svc-detail" hidden>
                {listing.description && (
                  <div class="svc-desc" set:html={renderDesc(listing.description)} />
                )}
                {listing.url && (
                  <div class="svc-url-row">
                    <a class="svc-action-link" href={listing.url} target="_blank" rel="noopener">
                      More info →
                    </a>
                  </div>
                )}
              </div>
            </div>
          ))
        }
        <div class="svc-empty" id="svc-empty" hidden>No listings match the current filter.</div>
      </div>

      <div class="svc-not-found" id="svc-not-found" hidden></div>
    </main>

    <script is:inline set:html={`window.SVC_CATS=${catsJson};`}></script>
  </body>
</html>

<style>
  [hidden] {
    display: none !important;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --nav-h: 44px;
    --page-bg: #f0ede8;
    --bg: #f7f4ef;
    --surface: #ffffff;
    --ink: #1a1612;
    --ink-muted: #6b6259;
    --ink-subtle: #9c9189;
    --border: #e0d9d0;
    --border-primary: #c8a96e;
    --radius: 6px;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--page-bg);
    color: var(--ink);
    min-height: 100vh;
    font-size: 14px;
  }

  /* ── PAGE LAYOUT ── */
  .svc-page {
    margin-top: var(--nav-h);
    padding: 32px 32px 80px;
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
  }

  .page-header {
    margin-bottom: 28px;
  }

  .page-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.15;
    margin-bottom: 6px;
  }

  .page-subtitle {
    font-size: 14px;
    font-weight: 300;
    color: var(--ink-muted);
    letter-spacing: 0.01em;
    margin-bottom: 20px;
  }

  /* ── CATEGORY INDEX ── */
  .cat-index-grid {
    columns: 2;
    column-gap: 48px;
  }

  .cat-index-group {
    break-inside: avoid;
    margin-bottom: 24px;
  }

  .cat-parent-link {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 10px;
    line-height: 1.3;
    transition: color 0.14s;
  }

  a.cat-parent-link:hover {
    color: var(--border-primary);
  }

  .cat-parent-link.cat-inactive {
    color: var(--ink-subtle);
    cursor: default;
  }

  .cat-subs-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cat-sub-link {
    display: block;
    font-size: 13px;
    color: var(--ink-muted);
    text-decoration: none;
    padding-left: 10px;
    border-left: 2px solid var(--border);
    line-height: 1.4;
    transition:
      color 0.14s,
      border-color 0.14s;
  }

  a.cat-sub-link:hover {
    color: var(--ink);
    border-left-color: var(--border-primary);
  }

  .cat-sub-link.cat-inactive {
    color: var(--ink-subtle);
    cursor: default;
  }

  /* ── FILTER BAR (matches events page style) ── */
  .filter-bar {
    position: sticky;
    top: var(--nav-h);
    z-index: 50;
    background: var(--page-bg);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    margin: 0 -32px 20px;
    padding-left: 32px;
    padding-right: 32px;
    flex-wrap: wrap;
  }

  .filter-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .filter-group label {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .filter-count {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── CATEGORY DROPDOWN ── */
  .filter-dropdown {
    position: relative;
  }

  .filter-dropdown-btn {
    font-family: inherit;
    font-size: 12px;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 4px 8px 4px 10px;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 190px;
    justify-content: space-between;
    -webkit-appearance: none;
  }

  .filter-dropdown-btn:hover {
    border-color: var(--ink-subtle);
  }

  .filter-dropdown-btn:focus-visible {
    outline: 2px solid var(--border-primary);
    outline-offset: 2px;
  }

  .filter-dropdown-arrow {
    color: var(--ink-muted);
    flex-shrink: 0;
    transition: transform 0.15s;
  }

  .filter-dropdown-btn[aria-expanded='true'] .filter-dropdown-arrow {
    transform: rotate(180deg);
  }

  .filter-dropdown-panel {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 260px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    z-index: 100;
    padding: 6px 0;
    max-height: 380px;
    overflow-y: auto;
  }

  .fdp-parent-label {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    user-select: none;
    width: 100%;
  }

  .fdp-parent-label:hover {
    background: var(--bg);
  }

  .fdp-subs {
    padding: 0 12px 4px 32px;
  }

  .fdp-sub-label {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    font-size: 12px;
    color: var(--ink-muted);
    cursor: pointer;
    user-select: none;
  }

  .fdp-sub-label:hover {
    color: var(--ink);
  }

  .fdp-parent-label input[type='checkbox'],
  .fdp-sub-label input[type='checkbox'] {
    width: 13px;
    height: 13px;
    cursor: pointer;
    accent-color: var(--ink);
    flex-shrink: 0;
  }

  /* ── EMPTY / NOT-FOUND ── */
  .svc-empty,
  .svc-not-found {
    padding: 48px 24px;
    text-align: center;
    font-size: 14px;
    color: var(--ink-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* ── CARD LIST ── */
  .svc-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* ── CARD ── */
  .svc-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }

  .svc-card.open {
    border-color: var(--border-primary);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
  }

  /* ── SUMMARY ROW ── */
  .svc-summary {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
    padding: 14px 16px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) {
    .svc-summary:hover {
      background: rgba(0, 0, 0, 0.02);
    }
  }

  .svc-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .svc-name-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .svc-name {
    font-family: 'Playfair Display', serif;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.25;
  }

  .svc-cat-pill {
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 10px;
    background: #f0ece6;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .svc-contact-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 2px;
  }

  .svc-photo {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .svc-contact-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
    min-width: 0;
  }

  .svc-contact-name {
    font-weight: 500;
    color: var(--ink);
  }

  .svc-contact-link {
    color: #4f5ce0;
    text-decoration: none;
    font-size: 12px;
  }

  .svc-contact-link:hover {
    text-decoration: underline;
  }

  .svc-contact-address {
    font-size: 12px;
    color: var(--ink-muted);
  }

  .svc-aside {
    flex-shrink: 0;
    padding-top: 2px;
  }

  .svc-chevron {
    display: block;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-subtle);
    border-bottom: 2px solid var(--ink-subtle);
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .svc-card.open .svc-chevron {
    transform: rotate(-135deg);
  }

  /* ── DETAIL PANEL ── */
  .svc-detail {
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .svc-desc {
    font-size: 13px;
    color: var(--ink);
    line-height: 1.6;
    white-space: pre-wrap;
  }

  .svc-desc a {
    color: #4f5ce0;
    text-decoration: none;
  }

  .svc-desc a:hover {
    text-decoration: underline;
  }

  .svc-url-row {
    display: flex;
  }

  .svc-action-link {
    font-size: 13px;
    font-weight: 500;
    color: #4f5ce0;
    text-decoration: none;
    transition: color 0.14s;
  }

  .svc-action-link:hover {
    color: #2c3e9a;
    text-decoration: underline;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 860px) {
    .svc-page {
      padding: 28px 24px 64px;
    }
    .filter-bar {
      margin-left: -24px;
      margin-right: -24px;
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  @media (max-width: 600px) {
    .svc-page {
      padding: 20px 16px 56px;
    }
    .cat-index-grid {
      columns: 1;
    }
    .filter-bar {
      margin-left: -16px;
      margin-right: -16px;
      padding-left: 16px;
      padding-right: 16px;
    }
    .filter-dropdown-btn {
      min-width: 160px;
    }
  }
</style>

<script is:inline>
  const CATS = window.SVC_CATS

  const parentSubs = {}
  const subParent = {}
  CATS.forEach((cat) => {
    parentSubs[cat.id] = cat.subcategories.map((s) => s.id)
    cat.subcategories.forEach((s) => {
      subParent[s.id] = cat.id
    })
  })

  const cards = Array.from(document.querySelectorAll('.svc-card'))
  const catIndex = document.getElementById('cat-index')
  const filterBar = document.getElementById('filter-bar')
  const svcList = document.getElementById('svc-list')
  const countEl = document.getElementById('filter-count')
  const emptyEl = document.getElementById('svc-empty')
  const notFoundEl = document.getElementById('svc-not-found')
  const dropdownPanel = document.getElementById('filter-dropdown-panel')
  const dropdownBtn = document.getElementById('filter-dropdown-btn')
  const dropdownLabel = document.getElementById('filter-dropdown-label')

  function updateDropdownLabel() {
    if (!dropdownLabel) return
    const n = document.querySelectorAll('.fdp-sub-cb:checked').length
    dropdownLabel.textContent = n === 0 ? 'Select category' : n === 1 ? '1 chosen' : n + ' chosen'
  }

  function updateParentCb(parentId) {
    const parentCb = document.querySelector(`.fdp-parent-cb[data-parent="${parentId}"]`)
    const subsEl = document.getElementById(`fdp-subs-${parentId}`)
    if (!parentCb || !subsEl) return
    const subCbs = Array.from(subsEl.querySelectorAll('.fdp-sub-cb'))
    const checkedCount = subCbs.filter((cb) => cb.checked).length
    if (subsEl.hidden || checkedCount === 0) {
      parentCb.checked = false
      parentCb.indeterminate = false
    } else if (checkedCount === subCbs.length) {
      parentCb.checked = true
      parentCb.indeterminate = false
    } else {
      parentCb.checked = false
      parentCb.indeterminate = true
    }
  }

  function applyFilter() {
    const selected = new Set(
      Array.from(document.querySelectorAll('.fdp-sub-cb:checked')).map((cb) => cb.dataset.sub)
    )
    let visible = 0
    cards.forEach((card) => {
      const cardCats = (card.dataset.categories || '').split(',').filter(Boolean)
      const show = selected.size > 0 && cardCats.some((c) => selected.has(c))
      card.style.display = show ? '' : 'none'
      if (show) visible++
    })
    if (countEl) countEl.textContent = `${visible} ${visible === 1 ? 'listing' : 'listings'}`
    if (emptyEl) emptyEl.hidden = visible > 0
    updateDropdownLabel()
  }

  function onParentCb(parentId, checkbox) {
    const subsEl = document.getElementById(`fdp-subs-${parentId}`)
    if (!subsEl) return
    if (checkbox.checked) {
      subsEl.hidden = false
      subsEl.querySelectorAll('.fdp-sub-cb').forEach((cb) => {
        cb.checked = true
      })
    } else {
      subsEl.hidden = true
      subsEl.querySelectorAll('.fdp-sub-cb').forEach((cb) => {
        cb.checked = false
      })
      checkbox.indeterminate = false
    }
    applyFilter()
  }

  function onSubCb() {
    CATS.forEach((cat) => updateParentCb(cat.id))
    applyFilter()
  }

  function toggleDropdown() {
    if (!dropdownPanel || !dropdownBtn) return
    const isOpen = dropdownPanel.hidden
    dropdownPanel.hidden = !isOpen
    dropdownBtn.setAttribute('aria-expanded', String(isOpen))
  }

  function activateCategory(catId) {
    const isParent = !!parentSubs[catId]
    const parentId = isParent ? catId : subParent[catId]
    if (!parentId) return
    const parentCb = document.querySelector(`.fdp-parent-cb[data-parent="${parentId}"]`)
    const subsEl = document.getElementById(`fdp-subs-${parentId}`)
    if (!parentCb || !subsEl) return
    parentCb.checked = true
    subsEl.hidden = false
    if (isParent) {
      subsEl.querySelectorAll('.fdp-sub-cb').forEach((cb) => {
        cb.checked = true
      })
    } else {
      subsEl.querySelectorAll('.fdp-sub-cb').forEach((cb) => {
        cb.checked = cb.dataset.sub === catId
      })
      updateParentCb(parentId)
    }
  }

  function openCard(card) {
    const btn = card.querySelector('.svc-summary')
    const detail = card.querySelector('.svc-detail')
    if (!btn || !detail) return
    card.classList.add('open')
    detail.hidden = false
    btn.setAttribute('aria-expanded', 'true')
  }

  // ── ROUTING ──
  const params = new URLSearchParams(location.search)
  const deepId = params.get('id')
  const catParam = params.get('category')

  // In any non-index mode, make the Services nav link clickable (to return to index)
  if (deepId || catParam) {
    const svcNavLink = document.querySelector('a[href="/services"].nav-link--active')
    if (svcNavLink) svcNavLink.style.pointerEvents = 'auto'
  }

  if (deepId) {
    const targetCard = cards.find((c) => c.dataset.id === 'service-' + deepId) ?? null
    catIndex.hidden = true
    if (targetCard && svcList) {
      svcList.hidden = false
      cards.forEach((c) => {
        if (c !== targetCard) c.style.display = 'none'
      })
      openCard(targetCard)
      const titleEl = document.getElementById('page-title')
      if (titleEl) titleEl.textContent = targetCard.querySelector('.svc-name')?.textContent ?? 'Service'
    } else {
      if (svcList) svcList.hidden = true
      if (notFoundEl) {
        notFoundEl.textContent = `service-${deepId} not found`
        notFoundEl.hidden = false
      }
    }
  } else if (catParam) {
    catIndex.hidden = true
    if (filterBar) filterBar.hidden = false
    if (svcList) svcList.hidden = false
    activateCategory(catParam)
    applyFilter()
  }
  // else: index mode — cat-index visible, filter-bar and svc-list remain hidden

  // Close dropdown when clicking outside it
  document.addEventListener('click', (e) => {
    const dd = document.getElementById('filter-dropdown')
    if (dd && !dd.contains(e.target) && dropdownPanel && !dropdownPanel.hidden) {
      dropdownPanel.hidden = true
      if (dropdownBtn) dropdownBtn.setAttribute('aria-expanded', 'false')
    }
  })

  window.svc = { toggleDropdown, onParentCb, onSubCb }

  // Card expand / collapse
  document.querySelectorAll('.svc-summary').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.svc-card')
      const detail = card?.querySelector('.svc-detail')
      if (!card || !detail) return
      const isOpen = card.classList.toggle('open')
      detail.hidden = !isOpen
      btn.setAttribute('aria-expanded', String(isOpen))
    })
  })
</script>
