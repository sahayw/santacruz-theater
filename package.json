{
  "name": "santacruz-theater",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "netlify dev",
    "check": "tsx scripts/check-json.ts && tsx scripts/check-shows.ts && tsx scripts/check-activities.ts",
