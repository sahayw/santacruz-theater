---
// Page frame and form styles shared by /subscribe and /subscribe/manage.
import BaseHead from './BaseHead.astro'
import SiteNav from './SiteNav.astro'

interface Props {
  title: string
  description: string
  canonicalPath: string
  noindex?: boolean
}
const { title, description, canonicalPath, noindex } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} canonicalPath={canonicalPath} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <SiteNav />
    <main class="sub-page">
      <div class="sub-container">
        <slot />
      </div>
    </main>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --nav-h: 44px;
    --page-bg: #f0ede8;
    --surface: #ffffff;
    --field-bg: #f7f4ef;
    --ink: #1a1612;
    --ink-muted: #6b6259;
    --ink-subtle: #9c9189;
    --border: #e0d9d0;
    --gold: #c8a96e;
    --radius: 6px;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--page-bg);
    color: var(--ink);
    min-height: 100vh;
    font-size: 14px;
  }

  .sub-page {
    margin-top: var(--nav-h);
    min-height: calc(100vh - var(--nav-h));
    display: flex;
    justify-content: center;
    padding: 40px 24px 80px;
  }

  .sub-container {
    width: 100%;
    max-width: 500px;
  }

  .back-link {
    display: inline-block;
    font-size: 13px;
    color: var(--ink-muted);
    text-decoration: none;
    margin-bottom: 24px;
  }

  .back-link:hover {
    color: var(--ink);
  }

  .back-link[hidden] {
    display: none;
  }

  .sub-title {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: 8px;
  }

  .sub-desc {
    font-size: 14px;
    font-weight: 300;
    color: var(--ink-muted);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .sub-who {
    display: inline-block;
    font-size: 13px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2px 10px;
    margin-bottom: 16px;
    overflow-wrap: anywhere;
  }

  .sub-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }

  .sub-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sub-label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-muted);
    margin-bottom: 4px;
  }

  .sub-input {
    width: 100%;
    font: inherit;
    font-size: 14px;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--field-bg);
    color: var(--ink);
  }

  .sub-input:focus {
    outline: 2px solid var(--gold);
    outline-offset: 0;
  }

  .sub-btn {
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    padding: 9px 14px;
    border-radius: 4px;
    cursor: pointer;
    background: var(--ink);
    border: 1px solid var(--ink);
    color: #fff;
    width: 100%;
  }

  .sub-btn:hover:not(:disabled) {
    background: #333;
  }

  .sub-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .sub-btn--warn {
    background: #8f2f22;
    border-color: #8f2f22;
  }

  .sub-btn--warn:hover:not(:disabled) {
    background: #7a271c;
  }

  .sub-btn--ghost {
    background: var(--surface);
    color: var(--ink);
    border-color: var(--border);
  }

  .sub-btn--ghost:hover:not(:disabled) {
    background: var(--field-bg);
  }

  .sub-btn-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .sub-btn-row .sub-btn {
    width: auto;
  }

  .sub-foot {
    font-size: 11px;
    color: var(--ink-subtle);
    line-height: 1.5;
  }

  .sub-err {
    font-size: 12px;
    color: #a33a2c;
  }

  .sub-status {
    border-radius: var(--radius);
    padding: 12px 14px;
    font-size: 13px;
    line-height: 1.5;
  }

  .sub-status.ok {
    background: #eaf4e6;
    color: #2f5d22;
  }

  .sub-status.info {
    background: #eef0fb;
    color: #33408a;
  }

  .sub-status.err {
    background: #fdf0ed;
    color: #8c3a2e;
  }

  .sub-after {
    margin-top: 14px;
    font-size: 12px;
    color: var(--ink-muted);
  }

  .sub-after a,
  .sub-status a {
    color: #4f5ce0;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .sub-page {
      padding: 28px 16px 64px;
    }
  }
</style>
